---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import GlowLineSeparator from "../components/ui/separator/GlowLineSeparator.astro";

const pageTitle = "Privacy Policy";
const pageDescription = "Privacy practices, cookies, and data protections at piush.com";
---

<!doctype html>
<html lang="en" data-theme="dark" class="dark">
  <head>
    <BaseHead title={`${pageTitle} – Piush KS`} description={pageDescription} />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 py-10">
      <div class="card-surface p-6 sm:p-10 space-y-8">
        <header class="space-y-2 border-b border-[var(--color-border)] pb-6">
          <h1 class="text-3xl sm:text-4xl font-extrabold text-foreground tracking-tight m-0">
            {pageTitle}
          </h1>
          <p class="text-sm text-[var(--color-text-muted)] m-0">
            Last Updated: January 2025 • Effective immediately
          </p>
        </header>

        <div class="prose prose-invert max-w-none text-[var(--color-text-secondary)] space-y-6">
          <p>
            At <strong>piush.com</strong>, privacy and data minimization are fundamental principles. This Privacy Policy explains how information is handled when you visit and interact with this website.
          </p>

          <h2 class="text-xl font-bold text-foreground">1. Information We Collect</h2>
          <h3 class="text-lg font-semibold text-foreground">a. Information You Voluntarily Provide</h3>
          <ul class="list-disc pl-5 space-y-1">
            <li>Contact inquiries sent directly via email (e.g. name, email address, message body).</li>
          </ul>

          <h3 class="text-lg font-semibold text-foreground">b. Privacy-First Analytics</h3>
          <p>
            This site uses privacy-focused, cookieless analytics (Umami) to understand aggregate traffic trends without tracking individual identities, collecting personal data, or storing persistent advertising cookies across sessions.
          </p>

          <h2 class="text-xl font-bold text-foreground">2. How We Use Information</h2>
          <ul class="list-disc pl-5 space-y-1">
            <li>To respond to your inquiries and collaboration requests.</li>
            <li>To ensure website performance, security, and uptime.</li>
          </ul>

          <h2 class="text-xl font-bold text-foreground">3. Sharing of Information</h2>
          <p>
            We do <strong>not</strong> sell, trade, or rent your personal information to third parties. Information is only shared if required by law or with trusted infrastructure providers required to operate this site.
          </p>

          <h2 class="text-xl font-bold text-foreground">4. Contact</h2>
          <p>
            If you have questions about privacy on this site, reach out at <a href="mailto:hi@piush.com" class="text-[var(--accent)] font-medium">hi@piush.com</a>.
          </p>
        </div>

        <GlowLineSeparator />
      </div>
    </main>
    <Footer />
  </body>
</html>
