---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import GlowLineSeparator from "../components/ui/separator/GlowLineSeparator.astro";

const pageTitle = "Privacy Policy";
const pageDescription = "Read the piush.com privacy policy: our commitment to zero personal data harvesting, cookieless analytics, and 100% in-browser developer utilities.";
const site = Astro.site;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead title="Privacy Policy – Data Protection & Analytics | Piush" description={pageDescription} />
    <!-- Structured Data: WebPage & Breadcrumbs -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          name: 'Privacy Policy',
          description: pageDescription,
          url: new URL('/privacy-policy/', Astro.site || 'https://piush.com').toString(),
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site || 'https://piush.com').toString() },
            { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: new URL('/privacy-policy/', Astro.site || 'https://piush.com').toString() },
          ],
        },
      ],
    })} />
  </head>
  <body class="retro-desktop-viewport">
    <div class="retro-window">
      <Header />
      <main class="flex-1 w-full px-3 sm:px-6 lg:px-8 py-4 sm:py-6">
        <div class="bg-white border-2 border-black p-5 sm:p-8 space-y-6 max-w-5xl mx-auto w-full shadow-[4px_4px_0px_#000000]">
          <header class="space-y-2 border-b-2 border-black pb-4">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-black tracking-tight m-0 font-mono">
              {pageTitle}
            </h1>
            <p class="text-xs sm:text-sm text-gray-700 m-0 font-mono">
              Last Updated: January 2025 • Effective immediately
            </p>
          </header>

          <div class="prose max-w-none text-gray-800 space-y-4 font-sans text-sm sm:text-base">
            <p>
              At <strong>piush.com</strong>, privacy and data minimization are fundamental principles. This Privacy Policy explains how information is handled when you visit and interact with this website.
            </p>

            <h2 class="text-lg font-bold text-black font-mono">1. Information We Collect</h2>
            <h3 class="text-base font-semibold text-black font-mono">a. Information You Voluntarily Provide</h3>
            <ul class="list-disc pl-5 space-y-1">
              <li>Contact inquiries sent directly via email (e.g. name, email address, message body).</li>
            </ul>

            <h3 class="text-base font-semibold text-black font-mono">b. Privacy-First Analytics</h3>
            <p>
              This site uses privacy-focused, cookieless analytics (Umami) to understand aggregate traffic trends without tracking individual identities, collecting personal data, or storing persistent advertising cookies across sessions.
            </p>

            <h2 class="text-lg font-bold text-black font-mono">2. How We Use Information</h2>
            <ul class="list-disc pl-5 space-y-1">
              <li>To respond to your inquiries and collaboration requests.</li>
              <li>To ensure website performance, security, and uptime.</li>
            </ul>

            <h2 class="text-lg font-bold text-black font-mono">3. Sharing of Information</h2>
            <p>
              We do <strong>not</strong> sell, trade, or rent your personal information to third parties. Information is only shared if required by law or with trusted infrastructure providers required to operate this site.
            </p>

            <h2 class="text-lg font-bold text-black font-mono">4. Contact</h2>
            <p>
              If you have questions about privacy on this site, reach out at <a href="mailto:hi@piush.com" class="text-[#0057CC] font-bold">hi@piush.com</a>.
            </p>
          </div>

          <GlowLineSeparator />
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>
