---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import Button from '../components/ui/button/Button.astro';
import LottieAnimation from '../components/ui/lottie/LottieAnimation.astro';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead title="404 – Page Not Found | Piush" description="The page you are looking for doesn’t exist or has been moved." noindex={true} />
  </head>
  <body class="retro-desktop-viewport">
    <div class="retro-window">
      <Header />
      <main class="flex-1 w-full px-3 sm:px-6 lg:px-8 py-10 sm:py-16 flex items-center justify-center">
        <section class="bg-white border-2 border-black p-6 sm:p-10 text-center space-y-6 max-w-lg mx-auto shadow-[6px_6px_0px_#000000] relative">
          <!-- Retro Dialog Header -->
          <div class="flex items-center justify-between border-b-2 border-black pb-3">
            <div class="flex items-center gap-2">
              <span class="retro-info-bubble">!</span>
              <span class="text-sm font-mono font-bold text-black uppercase">SYSTEM ERROR: 404</span>
            </div>
            <span class="text-xs font-mono font-bold px-2 py-0.5 border border-black bg-[#FFCCCC] text-red-700">
              FILE NOT FOUND
            </span>
          </div>

          <!-- Animated 404 Lottie Graphic in Retro Inset -->
          <div class="bg-[#F4F4F4] border-2 border-black p-4 shadow-[2px_2px_0px_#000000] flex items-center justify-center">
            <LottieAnimation
              src="/assets/lottie/404.json"
              class="w-full max-w-[240px] sm:max-w-[280px] aspect-[4/3] mx-auto filter drop-shadow-sm"
              alt="Page Not Found Animation"
            />
          </div>

          <div class="space-y-2">
            <h1 class="text-xl sm:text-2xl font-bold text-black m-0 font-mono">Page Not Found</h1>
            <p class="text-xs sm:text-sm text-gray-800 m-0 font-mono">
              The requested address does not exist or has been moved to a new system directory.
            </p>
          </div>

          <div class="pt-2 flex flex-wrap items-center justify-center gap-2.5">
            <Button href="/" variant="primary" size="sm">
              Home
            </Button>
            <Button href="/portfolio/" variant="secondary" size="sm">
              Work
            </Button>
            <Button href="/tools/" variant="secondary" size="sm">
              Tools
            </Button>
            <Button href="/blog/" variant="secondary" size="sm">
              Blog
            </Button>
          </div>
        </section>
      </main>
      <Footer />
    </div>
  </body>
</html>
