---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/sections/Footer.astro';
import Header from '../components/sections/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await getCollection('blog');

const allTags = new Set<string>();
posts.forEach(post => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => allTags.add(tag));
  }
});

const sortedTags = Array.from(allTags).sort();

const tagCounts = new Map<string, number>();
sortedTags.forEach(tag => {
  const count = posts.filter(post => post.data.tags?.includes(tag)).length;
  tagCounts.set(tag, count);
});

const pageTitle = 'Tags & Topics';
const pageDescription = 'Browse all topic collections and tags across mobile engineering, software architecture, frontend runtimes, and distributed cloud systems on piush.com.';
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<BaseHead title="Topic Collections & Tags | Piush" description={pageDescription} />
		<!-- Structured Data: CollectionPage & Breadcrumbs -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'CollectionPage',
					name: 'Topic Collections & Tags',
					description: pageDescription,
					url: new URL('/tags/', Astro.site || 'https://piush.com').toString(),
				},
				{
					'@type': 'BreadcrumbList',
					itemListElement: [
						{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site || 'https://piush.com').toString() },
						{ '@type': 'ListItem', position: 2, name: 'Tags', item: new URL('/tags/', Astro.site || 'https://piush.com').toString() },
					],
				},
			],
		})} />
	</head>
	<body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
		<Header />
		<main class="use-utility-layout flex-1 w-full px-4 sm:px-8 lg:px-12 py-10">
			<header class="text-center max-w-2xl mx-auto mb-10 space-y-3">
        <div class="inline-flex">
          <span class="status-pill">
            Explore Categories
          </span>
        </div>
				<h1 class="text-4xl sm:text-5xl font-extrabold text-foreground tracking-tight m-0">
					<span class="bg-gradient-to-r from-[#1B5448] via-[#23382B] to-[#4e5850] dark:from-[#ade1cd] dark:via-[#c6eedc] dark:to-[#E1F8DC] bg-clip-text text-transparent">
						{pageTitle}
					</span>
				</h1>
				<p class="text-base sm:text-lg text-[var(--color-text-secondary)]">
					Browse all topic collections, tutorials, and engineering deep dives.
				</p>
			</header>

			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
				{sortedTags.map(tag => (
					<a 
						href={`/blog/tag/${tag.toLowerCase()}/`}
						class="card-surface p-5 block group no-underline"
					>
						<div class="flex items-center justify-between mb-2">
							<h2 class="text-lg font-bold text-foreground group-hover:text-[var(--accent)] transition-colors m-0">
								#{tag}
							</h2>
							<span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-[rgba(var(--accent-rgb),0.1)] text-[var(--accent)] border border-[rgba(var(--accent-rgb),0.2)]">
								{tagCounts.get(tag)} {tagCounts.get(tag) === 1 ? 'post' : 'posts'}
							</span>
						</div>
						<p class="text-xs sm:text-sm text-[var(--color-text-muted)] m-0">
							Explore all guides tagged with <span class="text-[var(--color-text-secondary)]">"{tag}"</span>
						</p>
					</a>
				))}
			</div>

			{sortedTags.length === 0 && (
				<div class="card-surface p-12 text-center">
					<p class="text-[var(--color-text-secondary)] text-base m-0">
						No tags found. Check back later for new content!
					</p>
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>