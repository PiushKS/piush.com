---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/sections/Footer.astro';
import Header from '../components/sections/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await getCollection('blog');

const allTags = new Set<string>();
posts.forEach(post => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => allTags.add(tag));
  }
});

const sortedTags = Array.from(allTags).sort();

const tagCounts = new Map<string, number>();
sortedTags.forEach(tag => {
  const count = posts.filter(post => post.data.tags?.includes(tag)).length;
  tagCounts.set(tag, count);
});

const pageTitle = 'Tags & Topics';
const pageDescription = 'Browse all topic collections and tags across mobile engineering, software architecture, frontend runtimes, and distributed cloud systems on piush.com.';
const site = Astro.site;
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<BaseHead title="Topic Collections & Tags | Piush" description={pageDescription} />
		<!-- Structured Data: CollectionPage & Breadcrumbs -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'CollectionPage',
					name: 'Topic Collections & Tags',
					description: pageDescription,
					url: new URL('/tags/', Astro.site || 'https://piush.com').toString(),
				},
				{
					'@type': 'BreadcrumbList',
					itemListElement: [
						{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site || 'https://piush.com').toString() },
						{ '@type': 'ListItem', position: 2, name: 'Tags', item: new URL('/tags/', Astro.site || 'https://piush.com').toString() },
					],
				},
			],
		})} />
	</head>
	<body class="retro-desktop-viewport">
    <div class="retro-window">
      <Header />
      <main class="use-utility-layout flex-1 w-full px-3 sm:px-6 lg:px-8 py-4 sm:py-6">
        <header class="text-center max-w-2xl mx-auto mb-6 sm:mb-8 space-y-2">
          <div class="inline-flex">
            <span class="status-pill text-xs">
              Explore Categories
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-black tracking-tight m-0 font-mono">
            {pageTitle}
          </h1>
          <p class="text-sm sm:text-base text-gray-800 font-mono">
            Browse all topic collections, tutorials, and engineering deep dives.
          </p>
        </header>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {sortedTags.map(tag => (
            <a 
              href={`/blog/tag/${tag.toLowerCase()}/`}
              class="bg-white border-2 border-black p-4 block group no-underline shadow-[3px_3px_0px_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-transform"
            >
              <div class="flex items-center justify-between mb-2">
                <h2 class="text-base font-bold text-black group-hover:text-[#0057CC] transition-colors m-0 font-mono">
                  #{tag}
                </h2>
                <span class="text-xs font-mono font-bold px-2 py-0.5 border border-black bg-[#E8EEF5] text-[#0057CC]">
                  {tagCounts.get(tag)} {tagCounts.get(tag) === 1 ? 'post' : 'posts'}
                </span>
              </div>
              <p class="text-xs text-gray-700 m-0 font-sans">
                Explore all guides tagged with <span class="font-bold text-black">"{tag}"</span>
              </p>
            </a>
          ))}
        </div>

        {sortedTags.length === 0 && (
          <div class="bg-white border-2 border-black p-8 text-center shadow-[4px_4px_0px_#000000]">
            <p class="text-gray-800 text-sm m-0 font-mono">
              No tags found. Check back later for new content!
            </p>
          </div>
        )}
      </main>
      <Footer />
    </div>
	</body>
</html>