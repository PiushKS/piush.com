---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/sections/Footer.astro';
import Header from '../components/sections/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import HeroSection from '../components/sections/HeroSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import { skills } from '../data/skills';
import WorkExperience from '../components/sections/WorkExperience.astro';
import { work } from '../data/work';
import Studies from '../components/sections/Studies.astro';
import { studies } from '../data/studies';
import DeveloperToolsSection from '../components/sections/DeveloperToolsSection.astro';
import CodeChallengeSection from '../components/quiz/CodeChallengeSection.astro';
import ArrowSeparator from '../components/ui/separator/ArrowSeparator.astro';
import GlowLineSeparator from '../components/ui/separator/GlowLineSeparator.astro';
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <!-- JSON-LD: Person & WebSite Entities -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': new URL('/#person', Astro.site || 'https://piush.com').toString(),
          name: 'Piush KS',
          jobTitle: 'Mobile & Full-Stack Developer',
          description: SITE_DESCRIPTION,
          url: new URL('/', Astro.site || 'https://piush.com').toString(),
          image: new URL('/favicon.png', Astro.site || 'https://piush.com').toString(),
          sameAs: [
            'https://github.com/piushks',
            'https://www.linkedin.com/in/piushks/',
            'https://x.com/piushks',
            'https://instagram.com/piushks'
          ],
          knowsAbout: [
            'Android Development',
            'Kotlin',
            'Jetpack Compose',
            'iOS Development',
            'Swift',
            'SwiftUI',
            'Flutter',
            'Dart',
            'TypeScript',
            'React',
            'Node.js',
            'System Architecture'
          ]
        },
        {
          '@type': 'WebSite',
          '@id': new URL('/#website', Astro.site || 'https://piush.com').toString(),
          name: 'Piush KS',
          url: new URL('/', Astro.site || 'https://piush.com').toString(),
          description: SITE_DESCRIPTION,
          publisher: {
            '@id': new URL('/#person', Astro.site || 'https://piush.com').toString()
          }
        }
      ]
    })} />
	</head>
	<body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
		<Header />
		<main class="flex-1 w-full px-4 sm:px-8 lg:px-12 py-2 sm:py-4">
      <HeroSection
        badge="Available for Projects & Engineering"
        title="Piush KS"
        subtitle="Senior Engineer & Solopreneur crafting high-performance mobile applications, resilient cloud architectures, and digital products."
        showCTA
        primaryCTA={{ text: 'View Portfolio', href: '/portfolio' }}
        secondaryCTA={{ text: 'Read Blog Articles', href: '/blog' }}
        showHighlights={true}
      />

      <section class="py-2 sm:py-4 space-y-2 sm:space-y-3">
        <ArrowSeparator />
        <CodeChallengeSection />
        <ArrowSeparator />
        <DeveloperToolsSection />
        <ArrowSeparator />
        <SkillsSection title="Skills & Tools" skills={skills} />   
        <ArrowSeparator />
        <WorkExperience title="Work Experience" items={work} />
        <ArrowSeparator />
        <Studies title="Education & Studies" items={studies} />
        <GlowLineSeparator />
      </section>
		</main>
		<Footer />
	</body>
</html>
