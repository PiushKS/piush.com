---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import Projects from "../components/sections/Projects.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import GlowLineSeparator from "../components/ui/separator/GlowLineSeparator.astro";
---

<!doctype html>
<html lang="en" data-theme="dark" class="dark">
  <head>
    <BaseHead
      title="Portfolio – Piush KS"
      description="Explore selected projects, mobile applications, orchestrations, and full-stack systems built by Piush KS."
    />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-6">
      <HeroSection
        badge="Portfolio & Selected Works"
        title="Apps, Systems & Playbooks"
        subtitle="A curated showcase of engineering architecture, cross-platform mobile apps, workflow orchestrations, and developer tools."
      />
      <Projects />
      <GlowLineSeparator />
    </main>
    <Footer />
  </body>
</html>
