---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import Projects from "../components/sections/Projects.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import GlowLineSeparator from "../components/ui/separator/GlowLineSeparator.astro";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead
      title="Selected Projects & Work | Piush"
      description="Explore selected mobile apps, educational platforms, backend orchestrations, and full-stack systems built by Piush KS."
    />
    <!-- Structured Data: CollectionPage & BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "CollectionPage",
          "name": "Selected Projects & Work | Piush",
          "description": "Explore selected mobile apps, educational platforms, backend orchestrations, and full-stack systems built by Piush KS.",
          "url": new URL('/portfolio', Astro.site || 'https://piush.com').toString()
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.site || 'https://piush.com').toString() },
            { "@type": "ListItem", "position": 2, "name": "Portfolio", "item": new URL('/portfolio', Astro.site || 'https://piush.com').toString() }
          ]
        }
      ]
    })} />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full px-4 sm:px-8 lg:px-12 py-2 sm:py-4">
      <HeroSection
        badge="Portfolio & Selected Works"
        title="Apps, Systems & Playbooks"
        subtitle="A curated showcase of engineering architecture, cross-platform mobile apps, workflow orchestrations, and developer tools."
      />
      <Projects />
      <GlowLineSeparator />
    </main>
    <Footer />
  </body>
</html>
