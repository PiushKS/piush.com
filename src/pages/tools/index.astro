---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import Button from '../../components/ui/button/Button.astro';
import GlowLineSeparator from '../../components/ui/separator/GlowLineSeparator.astro';

const pageTitle = "Free Developer & Design Tools | Piush";
const pageDescription = "Fast, privacy-friendly utilities for developers and designers: JSON formatter, text case converter, SVG editor, UI design lab, OKLCH color studio, and Android/iOS app icon generator. 100% client-side.";

const toolCategories = [
  {
    id: 'developer',
    name: 'DEVELOPER',
    subtitle: 'Payload formatting, parsing, string hygiene & encoding',
    tools: [
      {
        title: 'JSON Toolkit',
        description: 'Format, validate and inspect JSON.',
        href: '/tools/json',
        chips: ['Formatter', 'Syntax Validator', 'Minifier', 'Tree Inspector', 'Sort Keys'],
        iconType: 'json',
        badge: 'Client-side AST'
      },
      {
        title: 'Developer Text Toolkit',
        description: 'Transform, encode and clean developer text.',
        href: '/tools/text',
        chips: ['10 Case Formats', 'Base64 UTF-8', 'URL & HTML', 'Deduplication', 'Metrics'],
        iconType: 'text',
        badge: 'Instant execution'
      },
      {
        title: 'Code Playground',
        description: 'Write and run code online in popular programming languages.',
        secondaryText: 'JavaScript • Python • Java • C/C++ • Kotlin • Swift • Dart + more',
        href: '/tools/playground',
        chips: ['20+ Languages', 'Real Compilers', 'Monaco IDE', 'stdin / stdout', 'Share Links'],
        iconType: 'playground',
        badge: 'Isolated Sandbox',
        ctaText: 'Start Coding →'
      }
    ]
  },
  {
    id: 'design',
    name: 'DESIGN',
    subtitle: 'Vector graphics, OKLCH color palettes & visual CSS generators',
    tools: [
      {
        title: 'SVG Studio',
        description: 'Edit, optimize and export SVG graphics.',
        href: '/tools/svg',
        chips: ['Vector Canvas', 'SVG Optimizer', 'Color Swatches', 'PNG 1x-4x', 'Transforms'],
        iconType: 'svg',
        badge: 'Live Canvas'
      },
      {
        title: 'UI Design Lab',
        description: 'Visually generate CSS, colors and reusable UI styles.',
        href: '/tools/ui',
        chips: ['Border Radius', 'Box Shadows', 'Gradients', 'Palette 50-950', 'Buttons & Cards'],
        iconType: 'ui',
        badge: '3-Panel Studio'
      },
      {
        title: 'Color Studio',
        description: 'Pick, generate, test and export modern UI color systems.',
        href: '/tools/colors',
        chips: ['OKLCH Engine', '50-950 Shades', 'WCAG Contrast', 'Harmonies', 'Cross-Platform Tokens'],
        iconType: 'color',
        badge: 'Perceptual Studio'
      }
    ]
  },
  {
    id: 'mobile',
    name: 'MOBILE',
    subtitle: 'Platform-compliant mobile launcher and app icon asset pipelines',
    tools: [
      {
        title: 'App Icon Creator',
        description: 'Create and export production-ready Android & iOS app icons.',
        href: '/tools/app-icon',
        chips: ['Android Adaptive', 'iOS Squircle', 'Safe Zone 66%', '84 Icon Library', 'Xcode ZIP'],
        iconType: 'app-icon',
        badge: 'Android + iOS'
      }
    ]
  }
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <!-- Structured Data: WebSite & SoftwareApplication Collection -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: new URL('/tools', Astro.site || 'https://piush.com').toString(),
      hasPart: toolCategories.flatMap(c => c.tools.map(t => ({
        '@type': 'WebApplication',
        name: t.title,
        applicationCategory: c.id === 'developer' ? 'DeveloperApplication' : 'DesignApplication',
        operatingSystem: 'All',
        url: new URL(t.href, Astro.site || 'https://piush.com').toString()
      })))
    })} />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col font-sans">
    <Header />
    <main class="flex-1 w-full px-4 sm:px-8 lg:px-12 py-6 sm:py-8 space-y-8 sm:space-y-10 max-w-6xl mx-auto">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="text-xs text-[var(--color-text-muted)] flex items-center gap-2">
        <a href="/" class="hover:text-[var(--accent)] transition-colors no-underline">Home</a>
        <span>/</span>
        <span class="text-[var(--accent)] font-medium">Tools</span>
      </nav>

      <!-- Hero Header -->
      <header class="text-center space-y-4 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[rgba(var(--accent-rgb),0.1)] text-[var(--accent)] border border-[rgba(var(--accent-rgb),0.2)] shadow-xs">
          <span class="size-1.5 rounded-full bg-[var(--accent)] animate-pulse"></span>
          <span>100% Client-Side • Zero Data Transmission</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-foreground">
          Developer & Design <span class="bg-gradient-to-r from-[#1B5448] via-[#23382B] to-[#4e5850] dark:from-[#ade1cd] dark:via-[#c6eedc] dark:to-[#E1F8DC] bg-clip-text text-transparent">Tools</span>
        </h1>
        <p class="text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-2xl mx-auto">
          Fast, privacy-friendly utilities handcrafted for developers, designers, and mobile engineers. No signup, no tracking—everything runs inside your browser.
        </p>
      </header>

      <!-- Privacy Guarantee Callout -->
      <div class="card-surface p-4 sm:p-5 border border-[rgba(var(--accent-rgb),0.2)] bg-[rgba(var(--accent-rgb),0.04)] flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
        <div class="flex items-center gap-3">
          <div class="size-9 rounded-lg bg-[rgba(var(--accent-rgb),0.12)] text-[var(--accent)] flex items-center justify-center shrink-0">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <div>
            <div class="text-sm font-bold text-foreground">Your files, tokens and code stay on your device.</div>
            <div class="text-xs text-[var(--color-text-secondary)]">Zero telemetry on your payloads, zero server uploads, zero cookies. Pure offline-ready JavaScript & WebAssembly.</div>
          </div>
        </div>
        <span class="text-xs font-mono text-[var(--accent)] font-semibold whitespace-nowrap bg-[rgba(var(--accent-rgb),0.1)] px-2.5 py-1 rounded-md border border-[rgba(var(--accent-rgb),0.2)]">
          Local WASM / JS
        </span>
      </div>

      <!-- DATA-DRIVEN CATEGORIES SECTION -->
      {toolCategories.map((category) => (
        <section class="space-y-4" aria-labelledby={`heading-${category.id}`}>
          <div class="flex items-center gap-2 border-b border-[var(--color-border)] pb-2">
            <span class="text-xs font-mono font-bold text-[var(--accent)] tracking-wider uppercase">{category.name}</span>
            <span class="text-xs text-[var(--color-text-muted)]">— {category.subtitle}</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
            {category.tools.map((t) => (
              <article class="card-surface p-6 sm:p-7 flex flex-col justify-between group border border-[var(--color-border)] hover:border-[var(--accent)] transition-all duration-300">
                <div class="space-y-3">
                  <div class="flex items-start justify-between gap-4">
                    <div class="size-12 rounded-xl flex items-center justify-center text-[var(--accent)] bg-[rgba(var(--accent-rgb),0.1)] border border-[rgba(var(--accent-rgb),0.2)] group-hover:scale-105 group-hover:bg-[rgba(var(--accent-rgb),0.18)] group-hover:border-[var(--accent)] transition-all duration-300 shadow-sm">
                      {t.iconType === 'json' && (
                        <span class="font-mono font-bold text-lg leading-none">&#123; &#125;</span>
                      )}
                      {t.iconType === 'text' && (
                        <span class="font-serif font-bold text-lg leading-none">Aa</span>
                      )}
                      {t.iconType === 'svg' && (
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 19l7-7 3 3-7 7-3-3z"/>
                          <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
                          <path d="M2 2l7.586 7.586"/>
                          <circle cx="11" cy="11" r="2"/>
                        </svg>
                      )}
                      {t.iconType === 'ui' && (
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect width="18" height="18" x="3" y="3" rx="2"/>
                          <path d="M3 9h18"/>
                          <path d="M9 21V9"/>
                        </svg>
                      )}
                      {t.iconType === 'color' && (
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="9" cy="9" r="6"/>
                          <circle cx="15" cy="9" r="6"/>
                          <circle cx="12" cy="15" r="6"/>
                        </svg>
                      )}
                      {t.iconType === 'app-icon' && (
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect width="18" height="18" x="3" y="3" rx="5"/>
                          <path d="M3 9h18"/>
                          <path d="M9 21V9"/>
                        </svg>
                      )}
                      {t.iconType === 'playground' && (
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="16 18 22 12 16 6"/>
                          <polyline points="8 6 2 12 8 18"/>
                          <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                        </svg>
                      )}
                    </div>
                    <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded-md bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] border border-[var(--color-border)]">
                      {t.href}
                    </span>
                  </div>

                  <div>
                    <h2 class="text-xl font-bold text-foreground group-hover:text-[var(--accent)] transition-colors tracking-tight m-0" id={`heading-${category.id}`}>
                      {t.title}
                    </h2>
                    <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mt-1 m-0">
                      {t.description}
                    </p>
                    {t.secondaryText && (
                      <p class="text-xs font-mono text-[var(--accent)] font-medium mt-1.5 mb-0">
                        {t.secondaryText}
                      </p>
                    )}
                  </div>

                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {t.chips.map((c) => (
                      <span class="tech-chip text-[0.7rem]">{c}</span>
                    ))}
                  </div>
                </div>

                <div class="mt-6 pt-4 border-t border-[var(--color-border)] flex items-center justify-between">
                  <span class="text-xs font-mono text-[var(--color-text-muted)]">{t.badge}</span>
                  <Button href={t.href} variant="secondary" size="sm">
                    <span>{t.ctaText || 'Open Tool'}</span>
                    <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                  </Button>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}

      <!-- Architecture Guarantee -->
      <section class="card-surface p-6 sm:p-8 space-y-4">
        <h3 class="text-lg font-bold text-foreground m-0 flex items-center gap-2">
          <span class="text-[var(--accent)]">⚡</span>
          Client-Side Sandbox Architecture
        </h3>
        <p class="text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed m-0">
          All utilities run 100% locally in your browser sandbox using modern web standards. Whether you are formatting confidential production JSON payloads, optimizing proprietary branding SVGs, generating OKLCH color palettes, or exporting Xcode & Android launcher icon sets, no data is ever transmitted, logged, or stored remotely.
        </p>
      </section>

      <GlowLineSeparator />
    </main>
    <Footer />
  </body>
</html>
