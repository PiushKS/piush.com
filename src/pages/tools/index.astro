---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import Button from '../../components/ui/button/Button.astro';
import GlowLineSeparator from '../../components/ui/separator/GlowLineSeparator.astro';

const pageTitle = "Free Developer Tools & Online Utilities | Piush";
const pageDescription = "Free browser-based developer tools for formatting JSON, testing code, working with colors, SVGs, UI styles and more.";

const toolCategories = [
  {
    id: 'developer',
    name: 'DEVELOPER',
    subtitle: 'Payload formatting, parsing, string hygiene & encoding',
    tools: [
      {
        title: 'JSON Toolkit',
        description: 'Format, validate and inspect JSON.',
        href: '/tools/json/',
        chips: ['Formatter', 'Syntax Validator', 'Minifier', 'Tree Inspector', 'Sort Keys'],
        iconType: 'json',
        badge: 'Client-side AST'
      },
      {
        title: 'Developer Text Toolkit',
        description: 'Transform, encode and clean developer text.',
        href: '/tools/text/',
        chips: ['10 Case Formats', 'Base64 UTF-8', 'URL & HTML', 'Deduplication', 'Metrics'],
        iconType: 'text',
        badge: 'Instant execution'
      },
      {
        title: 'Code Playground',
        description: 'Write, compile and run code online across 12+ programming languages.',
        href: '/tools/playground/',
        chips: ['Python', 'C/C++', 'JavaScript', 'Java', 'Go', 'Rust'],
        iconType: 'code',
        badge: 'Isolated Execution'
      }
    ]
  },
  {
    id: 'design',
    name: 'DESIGN',
    subtitle: 'Vector graphics, OKLCH color palettes & visual CSS generators',
    tools: [
      {
        title: 'SVG Studio',
        description: 'Edit, optimize and export SVG graphics.',
        href: '/tools/svg/',
        chips: ['Vector Canvas', 'SVG Optimizer', 'Color Swatches', 'PNG 1x-4x', 'Transforms'],
        iconType: 'svg',
        badge: 'Live Canvas'
      },
      {
        title: 'UI Design Lab',
        description: 'Visually generate CSS, colors and reusable UI styles.',
        href: '/tools/ui/',
        chips: ['Border Radius', 'Box Shadows', 'Gradients', 'Palette 50-950', 'Buttons & Cards'],
        iconType: 'ui',
        badge: '3-Panel Studio'
      },
      {
        title: 'Color Studio',
        description: 'Pick, generate, test and export modern UI color systems.',
        href: '/tools/colors/',
        chips: ['OKLCH Engine', '50-950 Shades', 'WCAG Contrast', 'Harmonies', 'Cross-Platform Tokens'],
        iconType: 'color',
        badge: 'Perceptual Studio'
      }
    ]
  }
];
const site = Astro.site;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <!-- Structured Data: CollectionPage & BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'CollectionPage',
          name: pageTitle,
          description: pageDescription,
          url: new URL('/tools/', Astro.site || 'https://piush.com').toString(),
          hasPart: toolCategories.flatMap(c => c.tools.map(t => ({
            '@type': 'WebApplication',
            name: t.title,
            applicationCategory: c.id === 'developer' ? 'DeveloperApplication' : 'DesignApplication',
            operatingSystem: 'All',
            url: new URL(t.href, Astro.site || 'https://piush.com').toString()
          })))
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site || 'https://piush.com').toString() },
            { '@type': 'ListItem', position: 2, name: 'Tools', item: new URL('/tools/', Astro.site || 'https://piush.com').toString() }
          ]
        }
      ]
    })} />
  </head>
  <body class="retro-desktop-viewport">
    <div class="retro-window">
      <Header />
      <main class="flex-1 w-full px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-6 sm:space-y-8 max-w-6xl mx-auto">
      
        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="text-xs font-mono text-gray-700 flex items-center gap-2">
          <a href="/" class="hover:underline font-bold text-black no-underline">Home</a>
          <span>/</span>
          <span class="text-[#0057CC] font-bold">Tools</span>
        </nav>

        <!-- Hero Header -->
        <header class="text-center space-y-3 max-w-3xl mx-auto">
          <div class="inline-flex">
            <span class="status-pill">
              <span class="status-dot"></span>
              100% Client-Side • Zero Data Transmission
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-black font-mono">
            Developer & Design <span class="text-[#0057CC]">Tools</span>
          </h1>
          <p class="text-sm sm:text-base text-gray-800 leading-relaxed max-w-2xl mx-auto font-mono">
            Fast, privacy-friendly utilities handcrafted for developers, designers, and mobile engineers. No signup, no tracking; everything runs inside your browser.
          </p>
        </header>

        <!-- Privacy Guarantee Callout -->
        <div class="p-3 bg-white border-2 border-black shadow-[3px_3px_0px_#000000] flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
          <div class="flex items-center gap-3">
            <span class="retro-info-bubble">i</span>
            <div>
              <div class="text-sm font-bold text-black font-mono">Your files, tokens and code stay on your device.</div>
              <div class="text-xs text-gray-700 font-sans">Zero telemetry on your payloads, zero server uploads, zero cookies. Pure offline-ready JavaScript & WebAssembly.</div>
            </div>
          </div>
          <span class="text-xs font-mono text-black font-bold whitespace-nowrap bg-[#E8EEF5] px-2.5 py-1 border border-black shadow-[1px_1px_0px_#000000]">
            Local WASM / JS
          </span>
        </div>

        <!-- DATA-DRIVEN CATEGORIES SECTION -->
        {toolCategories.map((category) => (
          <section class="space-y-4" aria-labelledby={`heading-${category.id}`}>
            <div class="flex items-center gap-2 border-b-2 border-black pb-2" id={`heading-${category.id}`}>
              <span class="text-sm font-mono font-bold text-[#0057CC] tracking-wider uppercase">{category.name}</span>
              <span class="text-xs text-gray-600 font-mono">· {category.subtitle}</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
              {category.tools.map((t) => (
                <article class="bg-white border-2 border-black p-5 sm:p-6 flex flex-col justify-between group shadow-[4px_4px_0px_#000000] transition-transform duration-100 hover:-translate-x-0.5 hover:-translate-y-0.5">
                  <div class="space-y-3">
                    <div class="flex items-start justify-between gap-4">
                      <div class="size-11 border-2 border-black flex items-center justify-center text-[#0057CC] bg-[#E8EEF5] shadow-[2px_2px_0px_#000000]">
                        {t.iconType === 'json' && (
                          <span class="font-mono font-bold text-lg leading-none">&#123; &#125;</span>
                        )}
                        {t.iconType === 'text' && (
                          <span class="font-serif font-bold text-lg leading-none">Aa</span>
                        )}
                        {t.iconType === 'code' && (
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="16 18 22 12 16 6"/>
                            <polyline points="8 6 2 12 8 18"/>
                          </svg>
                        )}
                        {t.iconType === 'svg' && (
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 19l7-7 3 3-7 7-3-3z"/>
                            <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
                            <path d="M2 2l7.586 7.586"/>
                            <circle cx="11" cy="11" r="2"/>
                          </svg>
                        )}
                        {t.iconType === 'ui' && (
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="3" rx="2"/>
                            <path d="M3 9h18"/>
                            <path d="M9 21V9"/>
                          </svg>
                        )}
                        {t.iconType === 'color' && (
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="9" r="6"/>
                            <circle cx="15" cy="9" r="6"/>
                            <circle cx="12" cy="15" r="6"/>
                          </svg>
                        )}
                      </div>
                      <span class="text-xs font-mono font-semibold px-2 py-0.5 border border-black bg-[#F4F4F4] text-black">
                        {t.href}
                      </span>
                    </div>

                    <div>
                      <h2 class="text-lg font-bold text-black tracking-tight m-0 font-mono">
                        {t.title}
                      </h2>
                      <p class="text-xs sm:text-sm text-gray-800 leading-relaxed mt-1 m-0 font-sans">
                        {t.description}
                      </p>
                      {t.secondaryText && (
                        <p class="text-xs font-mono text-[#0057CC] font-bold mt-1.5 mb-0">
                          {t.secondaryText}
                        </p>
                      )}
                    </div>

                    <div class="flex flex-wrap gap-1.5 pt-1">
                      {t.chips.map((c) => (
                        <span class="tech-chip text-[0.7rem] px-2 py-0.5 border border-black bg-[#F4F4F4] font-mono text-black">{c}</span>
                      ))}
                    </div>
                  </div>

                  <div class="mt-6 pt-4 border-t-2 border-black flex items-center justify-between">
                    <span class="text-xs font-mono text-gray-700 font-bold uppercase">{t.badge}</span>
                    <Button href={t.href} variant="secondary" size="sm">
                      <span>{t.ctaText || 'Open Tool'}</span>
                      <span class="font-mono ml-1 font-bold">»</span>
                    </Button>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}

        <!-- Architecture Guarantee -->
        <section class="bg-white border-2 border-black p-6 sm:p-8 space-y-3 shadow-[4px_4px_0px_#000000]">
          <h3 class="text-base sm:text-lg font-bold text-[#0057CC] m-0 flex items-center gap-2 font-mono uppercase">
            <span class="retro-info-bubble">i</span>
            Client-Side Sandbox Architecture
          </h3>
          <p class="text-xs sm:text-sm text-gray-800 leading-relaxed m-0 font-sans">
            All utilities run 100% locally in your browser sandbox using modern web standards. Whether you are formatting confidential production JSON payloads, optimizing proprietary branding SVGs, generating OKLCH color palettes, or exporting Xcode & Android launcher icon sets, no data is ever transmitted, logged, or stored remotely.
          </p>
        </section>

        <GlowLineSeparator />
      </main>
      <Footer />
    </div>
  </body>
</html>
