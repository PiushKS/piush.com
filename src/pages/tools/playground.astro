    <!-- Embed Languages JSON for Client-Side Script -->
    <script id="languages-data" type="application/json" set:html={JSON.stringify(PLAYGROUND_LANGUAGES)}></script>

    <!-- Client-side Playground Engine Script -->
    <script>
      // Load Monaco Editor dynamically and initialize playground
      (function() {
        const languagesDataEl = document.getElementById('languages-data');
        if (!languagesDataEl) return;

        const languages = JSON.parse(languagesDataEl.textContent || '[]');
        
        // State
        let currentLang = languages.find((l: any) => l.id === 'python') || languages[0];
        let currentVersion = currentLang.versions[0];
        let isRunning = false;
        let activeAbortController: AbortController | null = null;
        let monacoInstance: any = null;
        let editorInstance: any = null;
        let multiFileMode = false;
        let files = [{ name: 'main' + currentLang.ext, content: currentLang.starterCode }];
        let activeFileIndex = 0;

        // UI Element References
        const runBtn = document.getElementById('run-code-btn') as HTMLButtonElement;
        const stopBtn = document.getElementById('stop-code-btn') as HTMLButtonElement;
        const langSelectBtn = document.getElementById('lang-select-btn') as HTMLButtonElement;
        const langMenu = document.getElementById('lang-menu') as HTMLElement;
        const selectedLangIcon = document.getElementById('selected-lang-icon') as HTMLElement;
        const selectedLangName = document.getElementById('selected-lang-name') as HTMLElement;
        const versionSelect = document.getElementById('version-select') as HTMLSelectElement;
        const examplesBtn = document.getElementById('examples-btn') as HTMLButtonElement;
        const examplesMenu = document.getElementById('examples-menu') as HTMLElement;
        const resetBtn = document.getElementById('reset-code-btn') as HTMLButtonElement;
        const formatBtn = document.getElementById('format-code-btn') as HTMLButtonElement;
        const copyCodeBtn = document.getElementById('copy-code-btn') as HTMLButtonElement;
        const downloadCodeBtn = document.getElementById('download-code-btn') as HTMLButtonElement;
        const shareCodeBtn = document.getElementById('share-code-btn') as HTMLButtonElement;
        const overflowBtn = document.getElementById('overflow-menu-btn') as HTMLButtonElement;
        const overflowMenu = document.getElementById('overflow-menu') as HTMLElement;
        const focusModeBtn = document.getElementById('focus-mode-btn') as HTMLButtonElement;
        const stdinTextarea = document.getElementById('stdin-textarea') as HTMLTextAreaElement;
        const fallbackEditor = document.getElementById('fallback-code-editor') as HTMLTextAreaElement;
        const editorMount = document.getElementById('monaco-editor-mount') as HTMLElement;
        const editorSpinner = document.getElementById('editor-loading-spinner') as HTMLElement;
        const statusIndicatorDot = document.getElementById('status-indicator-dot') as HTMLElement;
        const statusText = document.getElementById('status-text') as HTMLElement;
        const metricsContainer = document.getElementById('execution-metrics') as HTMLElement;
        const metricTime = document.getElementById('metric-time') as HTMLElement;
        const metricMemory = document.getElementById('metric-memory') as HTMLElement;
        const stdoutContent = document.getElementById('stdout-content') as HTMLElement;
        const stderrContent = document.getElementById('stderr-content') as HTMLElement;
        const errorBadgeCount = document.getElementById('error-badge-count') as HTMLElement;
        const errorClickableLines = document.getElementById('error-clickable-lines') as HTMLElement;
        const statusLangVersion = document.getElementById('status-lang-version') as HTMLElement;
        const statusCursorPos = document.getElementById('status-cursor-pos') as HTMLElement;
        const activeFilenameLabel = document.getElementById('active-filename-label') as HTMLElement;
        const toast = document.getElementById('playground-toast') as HTMLElement;
        const toastMsg = document.getElementById('toast-message') as HTMLElement;

        // Toast Helper
        function showToast(message: string, isError = false) {
          if (!toast || !toastMsg) return;
          toastMsg.textContent = message;
          toast.className = `fixed bottom-5 right-5 z-50 px-4 py-2 rounded-xl text-xs font-mono shadow-2xl flex items-center gap-2 border transition-all ${
            isError ? 'bg-rose-900 border-rose-700 text-white' : 'bg-slate-900 border-slate-700 text-white'
          }`;
          toast.classList.remove('hidden');
          setTimeout(() => {
            toast.classList.add('hidden');
          }, 2800);
        }

        // Get Code Content
        function getCode(): string {
          if (editorInstance) {
            return editorInstance.getValue();
          }
          return fallbackEditor ? fallbackEditor.value : '';
        }

        // Set Code Content
        function setCode(code: string) {
          if (editorInstance) {
            editorInstance.setValue(code);
          }
          if (fallbackEditor) {
            fallbackEditor.value = code;
          }
          saveAutosave();
        }

        // Autosave handling
        function saveAutosave() {
          try {
            const state = {
              langId: currentLang.id,
              versionId: currentVersion.id,
              code: getCode(),
              stdin: stdinTextarea ? stdinTextarea.value : '',
              timestamp: Date.now()
            };
            localStorage.setItem('code_playground_state', JSON.stringify(state));
          } catch (e) {}
        }

        function restoreAutosave() {
          // 1. Check URL parameters first (e.g. from Quiz or Share Link)
          const params = new URLSearchParams(window.location.search);
          const urlLang = params.get('lang');
          const urlCode = params.get('code') || params.get('c');
          const urlStdin = params.get('stdin') || params.get('in');

          if (urlLang) {
            const found = languages.find((l: any) => l.id.toLowerCase() === urlLang.toLowerCase() || (urlLang === 'cpp' && l.id === 'cpp') || (urlLang === 'js' && l.id === 'javascript'));
            if (found) {
              currentLang = found;
              currentVersion = found.versions[0];
            }
          }

          if (urlCode) {
            try {
              let decoded = urlCode;
              if (urlCode.startsWith('b64:')) {
                decoded = decodeURIComponent(escape(atob(urlCode.slice(4))));
              }
              setCode(decoded);
              if (urlStdin && stdinTextarea) {
                stdinTextarea.value = urlStdin;
              }
              showToast('Snippet loaded from link. Press Run Code to execute.');
              return;
            } catch (e) {
              console.error('Failed to decode URL code param', e);
            }
          }

          // 2. Otherwise restore from localStorage
          try {
            const savedRaw = localStorage.getItem('code_playground_state');
            if (savedRaw) {
              const saved = JSON.parse(savedRaw);
              const foundLang = languages.find((l: any) => l.id === saved.langId);
              if (foundLang) {
                currentLang = foundLang;
                const foundVersion = foundLang.versions.find((v: any) => v.id === saved.versionId) || foundLang.versions[0];
                currentVersion = foundVersion;
              }
              if (saved.code) {
                setCode(saved.code);
              } else {
                setCode(currentLang.starterCode);
              }
              if (saved.stdin && stdinTextarea) {
                stdinTextarea.value = saved.stdin;
              }
              return;
            }
          } catch (e) {}

          // 3. Fallback to default
          setCode(currentLang.starterCode);
        }

        // Populate Versions Dropdown
        function updateVersionsDropdown() {
          if (!versionSelect) return;
          versionSelect.innerHTML = '';
          currentLang.versions.forEach((v: any) => {
            const opt = document.createElement('option');
            opt.value = String(v.id);
            opt.textContent = v.version;
            if (v.id === currentVersion.id) opt.selected = true;
            versionSelect.appendChild(opt);
          });
          if (statusLangVersion) {
            statusLangVersion.textContent = `${currentLang.name} (${currentVersion.version})`;
          }
        }

        // Update Language UI
        function setLanguage(langId: string) {
          const found = languages.find((l: any) => l.id === langId);
          if (!found) return;

          currentLang = found;
          currentVersion = found.versions[0];

          if (selectedLangName) selectedLangName.textContent = found.name;
          if (activeFilenameLabel) activeFilenameLabel.textContent = `main${found.ext}`;

          updateVersionsDropdown();
          populateExamplesMenu();

          // Set editor language model
          if (editorInstance && monacoInstance) {
            const model = editorInstance.getModel();
            if (model) {
              monacoInstance.editor.setModelLanguage(model, found.monacoLang);
            }
          }

          setCode(found.starterCode);
          if (stdinTextarea && found.starterStdin !== undefined) {
            stdinTextarea.value = found.starterStdin;
          }

          // Format button visibility
          if (formatBtn) {
            formatBtn.style.display = found.supportsFormat ? 'inline-flex' : 'none';
          }

          saveAutosave();
        }

        // Populate Examples Menu
        function populateExamplesMenu() {
          if (!examplesMenu) return;
          examplesMenu.innerHTML = '';
          if (!currentLang.examples || currentLang.examples.length === 0) {
            examplesMenu.innerHTML = '<div class="p-2 text-xs text-[var(--color-text-muted)]">No starter templates.</div>';
            return;
          }

          currentLang.examples.forEach((ex: any) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'w-full flex flex-col px-3 py-2 rounded-lg text-left hover:bg-[rgba(var(--accent-rgb),0.1)] text-foreground cursor-pointer transition-colors';
            btn.innerHTML = `
              <span class="font-medium text-xs">${ex.title}</span>
              <span class="text-[10px] text-[var(--color-text-muted)] font-mono">${ex.category}</span>
            `;
            btn.addEventListener('click', () => {
              setCode(ex.code);
              if (ex.stdin !== undefined && stdinTextarea) {
                stdinTextarea.value = ex.stdin;
              }
              examplesMenu.classList.add('hidden');
              showToast(`Loaded template: ${ex.title}`);
            });
            examplesMenu.appendChild(btn);
          });
        }

        // Clickable Line References for Compiler Errors
        function renderErrorLines(text: string) {
          if (!errorClickableLines) return;
          errorClickableLines.innerHTML = '';

          // Match patterns like: main.cpp:5:12: error or Line 5 or File "script.py", line 4
          const lineMatches = new Set<number>();
          const regex1 = /(?:main\.\w+|Main\.\w+|script\.\w+|\w+\.\w+):(\d+)(?::(\d+))?:/g;
          const regex2 = /line\s+(\d+)/gi;

          let match;
          while ((match = regex1.exec(text)) !== null) {
            const line = parseInt(match[1], 10);
            if (!isNaN(line)) lineMatches.add(line);
          }
          while ((match = regex2.exec(text)) !== null) {
            const line = parseInt(match[1], 10);
            if (!isNaN(line)) lineMatches.add(line);
          }

          if (lineMatches.size > 0) {
            errorClickableLines.classList.remove('hidden');
            const label = document.createElement('span');
            label.className = 'text-[10px] text-[var(--color-text-muted)] font-mono self-center mr-1';
            label.textContent = 'Jump to:';
            errorClickableLines.appendChild(label);

            lineMatches.forEach(lineNumber => {
              const pill = document.createElement('button');
              pill.type = 'button';
              pill.className = 'px-2 py-0.5 rounded bg-rose-500/10 hover:bg-rose-500/20 text-rose-700 dark:text-rose-300 border border-rose-500/30 text-[11px] font-mono cursor-pointer transition-colors';
              pill.textContent = `Line ${lineNumber}`;
              pill.addEventListener('click', () => {
                if (editorInstance) {
                  editorInstance.revealLineInCenter(lineNumber);
                  editorInstance.setPosition({ lineNumber, column: 1 });
                  editorInstance.focus();
                }
              });
              errorClickableLines.appendChild(pill);
            });
          } else {
            errorClickableLines.classList.add('hidden');
          }
        }

        // Switch Console Tabs
        const consoleTabBtns = document.querySelectorAll('.console-tab-btn');
        consoleTabBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const targetTab = btn.getAttribute('data-console-tab');
            switchConsoleTab(targetTab || 'output');
          });
        });

        function switchConsoleTab(tabName: string) {
          consoleTabBtns.forEach(b => {
            if (b.getAttribute('data-console-tab') === tabName) {
              b.className = 'console-tab-btn px-2.5 py-1 rounded-md font-bold bg-[var(--card)] text-[var(--accent)] border border-[var(--color-border)] cursor-pointer';
            } else {
              b.className = 'console-tab-btn px-2.5 py-1 rounded-md text-[var(--color-text-muted)] hover:text-foreground cursor-pointer';
            }
          });

          const tabOutput = document.getElementById('tab-content-output');
          const tabInput = document.getElementById('tab-content-input');
          const tabErrors = document.getElementById('tab-content-errors');

          if (tabOutput) tabOutput.classList.toggle('hidden', tabName !== 'output');
          if (tabInput) tabInput.classList.toggle('hidden', tabName !== 'input');
          if (tabErrors) tabErrors.classList.toggle('hidden', tabName !== 'errors');
        }

        // Mobile Tabs
        const mobileTabBtns = document.querySelectorAll('.mobile-tab-btn');
        mobileTabBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const tab = btn.getAttribute('data-tab');
            mobileTabBtns.forEach(b => {
              if (b === btn) {
                b.className = 'mobile-tab-btn flex-1 py-2 text-center font-bold text-[var(--accent)] border-b-2 border-[var(--accent)] cursor-pointer';
              } else {
                b.className = 'mobile-tab-btn flex-1 py-2 text-center text-[var(--color-text-muted)] cursor-pointer';
              }
            });

            const editorPanel = document.getElementById('editor-panel');
            const consolePanel = document.getElementById('console-panel');

            if (tab === 'code') {
              if (editorPanel) editorPanel.classList.remove('hidden');
              if (consolePanel) consolePanel.classList.add('hidden');
            } else if (tab === 'input') {
              if (editorPanel) editorPanel.classList.add('hidden');
              if (consolePanel) consolePanel.classList.remove('hidden');
              switchConsoleTab('input');
            } else if (tab === 'output') {
              if (editorPanel) editorPanel.classList.add('hidden');
              if (consolePanel) consolePanel.classList.remove('hidden');
              switchConsoleTab('output');
            }
          });
        });

        // EXECUTION ENGINE (Direct Sandboxed Judge0 Client with Abort Controller & Rate Limit)
        let lastRunTimestamp = 0;

        async function executeCode() {
          if (isRunning) return;

          const now = Date.now();
          if (now - lastRunTimestamp < 1000) {
            showToast('Please wait a second before running again.');
            return;
          }
          lastRunTimestamp = now;

          const sourceCode = getCode();
          if (!sourceCode.trim()) {
            showToast('Editor is empty. Write or load some code first.', true);
            return;
          }

          // Enforce 100KB source code limit
          if (sourceCode.length > 102400) {
            showToast('Source code exceeds 100KB limit.', true);
            return;
          }

          const stdinInput = stdinTextarea ? stdinTextarea.value : '';

          // Update UI to running state
          isRunning = true;
          activeAbortController = new AbortController();

          if (runBtn) runBtn.classList.add('hidden');
          if (stopBtn) stopBtn.classList.remove('hidden');
          if (statusIndicatorDot) statusIndicatorDot.className = 'size-2 rounded-full bg-amber-500 animate-ping';
          if (statusText) {
            statusText.textContent = 'Running...';
            statusText.className = 'font-semibold text-amber-600';
          }
          if (stdoutContent) {
            stdoutContent.textContent = 'Executing in isolated container...\n';
          }
          if (metricsContainer) metricsContainer.classList.add('hidden');

          switchConsoleTab('output');

          try {
            const response = await fetch('https://ce.judge0.com/submissions?base64_encoded=false&wait=true', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                language_id: currentVersion.id,
                source_code: sourceCode,
                stdin: stdinInput
              }),
              signal: activeAbortController.signal
            });

            if (!response.ok) {
              throw new Error(`Execution service returned status ${response.status}`);
            }

            const data = await response.json();
            handleExecutionResult(data);
          } catch (err: any) {
            if (err.name === 'AbortError') {
              if (statusIndicatorDot) statusIndicatorDot.className = 'size-2 rounded-full bg-slate-400';
              if (statusText) {
                statusText.textContent = 'Execution cancelled by user';
                statusText.className = 'font-semibold text-[var(--color-text-muted)]';
              }
              if (stdoutContent) stdoutContent.textContent = '[Execution aborted by user]';
            } else {
              console.error('Execution failure', err);
              if (statusIndicatorDot) statusIndicatorDot.className = 'size-2 rounded-full bg-rose-500';
              if (statusText) {
                statusText.textContent = 'Compiler temporarily unavailable';
                statusText.className = 'font-semibold text-rose-600';
              }
              if (stdoutContent) {
                stdoutContent.textContent = 'Compiler temporarily unavailable.\nYour code is safely stored locally. You can still Copy or Download your work, and please try running again shortly.';
              }
              showToast('Compiler temporarily unavailable', true);
            }
          } finally {
            isRunning = false;
            activeAbortController = null;
            if (runBtn) runBtn.classList.remove('hidden');
            if (stopBtn) stopBtn.classList.add('hidden');
          }
        }

        // Process Judge0 Execution Response
        function handleExecutionResult(res: any) {
          const status = res.status || {};
          const statusId = status.id;
          const statusDesc = status.description || 'Unknown';

          // Format Execution Time & Memory
          let timeText = '-';
          if (res.time !== null && res.time !== undefined) {
            const sec = parseFloat(res.time);
            timeText = sec < 1 ? `${Math.round(sec * 1000)} ms` : `${sec.toFixed(2)} s`;
          }

          let memText = '-';
          if (res.memory !== null && res.memory !== undefined) {
            memText = `${(res.memory / 1024).toFixed(1)} MB`;
          }

          if (metricsContainer && metricTime && metricMemory) {
            metricsContainer.classList.remove('hidden');
            metricTime.textContent = `Time: ${timeText}`;
            metricMemory.textContent = `Memory: ${memText}`;
          }

          // Handle Stdout (Truncate if > 1MB)
          let stdoutStr = res.stdout || '';
          if (stdoutStr.length > 1048576) {
            stdoutStr = stdoutStr.slice(0, 1048576) + '\n\n[Output truncated at 1MB limit]';
          }

          // Handle Errors / Stderr / Compile Output
          const stderrStr = res.stderr || '';
          const compileOutputStr = res.compile_output || '';
          const fullErrors = (compileOutputStr + (compileOutputStr && stderrStr ? '\n\n' : '') + stderrStr).trim();

          if (statusId === 3) { // Accepted / Finished
            if (statusIndicatorDot) statusIndicatorDot.className = 'size-2 rounded-full bg-emerald-500';
            if (statusText) {
              statusText.textContent = '✓ Finished';
              statusText.className = 'font-semibold text-emerald-600';
            }
            if (stdoutContent) {
              stdoutContent.textContent = stdoutStr || '[Program finished with no output]';
            }
          } else if (statusId === 5) { // Time Limit Exceeded
            if (statusIndicatorDot) statusIndicatorDot.className = 'size-2 rounded-full bg-amber-500';
            if (statusText) {
              statusText.textContent = '⏱ Time Limit Exceeded (5.0s)';
              statusText.className = 'font-semibold text-amber-600';
            }
            if (stdoutContent) {
              stdoutContent.textContent = (stdoutStr ? stdoutStr + '\n\n' : '') + '⏱ Execution stopped: Time limit exceeded (5.0 seconds).';
            }
          } else if (statusId === 6) { // Compilation Error
            if (statusIndicatorDot) statusIndicatorDot.className = 'size-2 rounded-full bg-rose-500';
            if (statusText) {
              statusText.textContent = '✕ Compilation Error';
              statusText.className = 'font-semibold text-rose-600';
            }
            if (stdoutContent) {
              stdoutContent.textContent = compileOutputStr || stderrStr || 'Compilation failed.';
            }
            switchConsoleTab('errors');
          } else { // Runtime Error or other
            if (statusIndicatorDot) statusIndicatorDot.className = 'size-2 rounded-full bg-rose-500';
            if (statusText) {
              statusText.textContent = `✕ ${statusDesc}`;
              statusText.className = 'font-semibold text-rose-600';
            }
            if (stdoutContent) {
              stdoutContent.textContent = (stdoutStr ? stdoutStr + '\n\n' : '') + (stderrStr || statusDesc);
            }
            if (stderrStr || compileOutputStr) {
              switchConsoleTab('errors');
            }
          }

          // Populate Errors tab
          if (stderrContent) {
            stderrContent.textContent = fullErrors || 'No compiler errors or runtime warnings reported.';
          }
          if (errorBadgeCount) {
            if (fullErrors) {
              errorBadgeCount.textContent = '1';
              errorBadgeCount.classList.remove('hidden');
            } else {
              errorBadgeCount.classList.add('hidden');
            }
          }

          if (fullErrors) {
            renderErrorLines(fullErrors);
          }
        }

        // Stop Execution
        if (stopBtn) {
          stopBtn.addEventListener('click', () => {
            if (activeAbortController) {
              activeAbortController.abort();
            }
          });
        }

        // Run Code Trigger
        if (runBtn) {
          runBtn.addEventListener('click', executeCode);
        }

        // Reset Code Modal Flow
        const resetConfirmModal = document.getElementById('reset-confirm-modal');
        const confirmResetBtn = document.getElementById('confirm-reset-btn');
        const cancelResetBtn = document.getElementById('cancel-reset-btn');

        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            const current = getCode();
            if (current !== currentLang.starterCode) {
              if (resetConfirmModal) resetConfirmModal.classList.remove('hidden');
            } else {
              setCode(currentLang.starterCode);
              showToast('Code reset to default');
            }
          });
        }

        if (confirmResetBtn) {
          confirmResetBtn.addEventListener('click', () => {
            setCode(currentLang.starterCode);
            if (resetConfirmModal) resetConfirmModal.classList.add('hidden');
            showToast('Code reset to default template');
          });
        }

        if (cancelResetBtn) {
          cancelResetBtn.addEventListener('click', () => {
            if (resetConfirmModal) resetConfirmModal.classList.add('hidden');
          });
        }

        // Format Code Button
        if (formatBtn) {
          formatBtn.addEventListener('click', () => {
            if (editorInstance) {
              const formatAction = editorInstance.getAction('editor.action.formatDocument');
              if (formatAction) {
                formatAction.run();
                showToast('Formatted document');
                return;
              }
            }
            showToast('Formatting not supported for this language');
          });
        }

        // Copy Code
        if (copyCodeBtn) {
          copyCodeBtn.addEventListener('click', () => {
            const code = getCode();
            navigator.clipboard.writeText(code).then(() => {
              showToast('Code copied to clipboard');
            }).catch(() => {
              showToast('Failed to copy', true);
            });
          });
        }

        // Copy Output
        const copyOutputBtn = document.getElementById('copy-output-btn');
        if (copyOutputBtn) {
          copyOutputBtn.addEventListener('click', () => {
            const outText = stdoutContent ? stdoutContent.textContent || '' : '';
            navigator.clipboard.writeText(outText).then(() => {
              showToast('Output copied to clipboard');
            });
          });
        }

        // Clear Output
        function clearOutput() {
          if (stdoutContent) stdoutContent.textContent = 'Output cleared.';
          if (stderrContent) stderrContent.textContent = 'No errors.';
          if (statusText) statusText.textContent = 'Ready';
          if (statusIndicatorDot) statusIndicatorDot.className = 'size-2 rounded-full bg-slate-400';
          if (metricsContainer) metricsContainer.classList.add('hidden');
          if (errorBadgeCount) errorBadgeCount.classList.add('hidden');
          showToast('Output cleared');
        }

        const clearOutputIconBtn = document.getElementById('clear-output-icon-btn');
        if (clearOutputIconBtn) clearOutputIconBtn.addEventListener('click', clearOutput);

        const clearOutputBtn = document.getElementById('clear-output-btn');
        if (clearOutputBtn) {
          clearOutputBtn.addEventListener('click', () => {
            clearOutput();
            if (overflowMenu) overflowMenu.classList.add('hidden');
          });
        }

        // Clear Code
        const clearCodeBtn = document.getElementById('clear-code-btn');
        if (clearCodeBtn) {
          clearCodeBtn.addEventListener('click', () => {
            setCode('');
            if (overflowMenu) overflowMenu.classList.add('hidden');
            showToast('Code cleared');
          });
        }

        // Download Code
        if (downloadCodeBtn) {
          downloadCodeBtn.addEventListener('click', () => {
            const code = getCode();
            const blob = new Blob([code], { type: 'text/plain;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `main${currentLang.ext}`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast(`Downloaded main${currentLang.ext}`);
          });
        }

        // Share Code
        if (shareCodeBtn) {
          shareCodeBtn.addEventListener('click', () => {
            const code = getCode();
            if (code.length > 4096) {
              showToast('Snippet exceeds 4KB URL limit. Use My Snippets to save locally.', true);
              return;
            }

            const url = new URL(window.location.origin + '/tools/playground');
            url.searchParams.set('lang', currentLang.id);
            const encoded = 'b64:' + btoa(unescape(encodeURIComponent(code)));
            url.searchParams.set('c', encoded);

            if (stdinTextarea && stdinTextarea.value.trim()) {
              url.searchParams.set('in', stdinTextarea.value);
            }

            navigator.clipboard.writeText(url.toString()).then(() => {
              showToast('Shareable link copied to clipboard!');
            }).catch(() => {
              showToast('Failed to copy link', true);
            });
          });
        }

        // Focus Mode (Full Screen)
        let isFocusMode = false;
        if (focusModeBtn) {
          focusModeBtn.addEventListener('click', () => {
            isFocusMode = !isFocusMode;
            const main = document.getElementById('playground-main');
            const header = document.getElementById('site-header-container');
            const footer = document.getElementById('site-footer-container');
            const topBar = document.getElementById('playground-top-bar');

            if (isFocusMode) {
              if (header) header.style.display = 'none';
              if (footer) footer.style.display = 'none';
              if (topBar) topBar.style.display = 'none';
              if (main) {
                main.className = 'fixed inset-0 z-50 p-2 bg-[var(--background)] flex flex-col h-screen w-screen max-w-none';
              }
              showToast('Entered Focus Mode. Click button again to exit.');
            } else {
              if (header) header.style.display = '';
              if (footer) footer.style.display = '';
              if (topBar) topBar.style.display = '';
              if (main) {
                main.className = 'flex-1 w-full px-3 sm:px-6 lg:px-8 py-3 sm:py-5 space-y-3 max-w-[1700px] mx-auto flex flex-col';
              }
            }
            if (editorInstance) {
              editorInstance.layout();
            }
          });
        }

        // Language Search Filter
        const langSearchInput = document.getElementById('lang-search-input') as HTMLInputElement;
        if (langSearchInput) {
          langSearchInput.addEventListener('input', (e: any) => {
            const query = e.target.value.toLowerCase().trim();
            const options = document.querySelectorAll('.lang-option');
            options.forEach((opt: any) => {
              const langId = opt.getAttribute('data-lang');
              const langObj = languages.find((l: any) => l.id === langId);
              if (langObj && (langObj.name.toLowerCase().includes(query) || langObj.id.toLowerCase().includes(query))) {
                opt.style.display = 'flex';
              } else {
                opt.style.display = 'none';
              }
            });
          });
        }

        // Language Options Click
        document.querySelectorAll('.lang-option').forEach(opt => {
          opt.addEventListener('click', () => {
            const langId = opt.getAttribute('data-lang');
            if (langId) {
              setLanguage(langId);
              if (langMenu) langMenu.classList.add('hidden');
            }
          });
        });

        // Dropdown Click Handlers
        if (langSelectBtn && langMenu) {
          langSelectBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            langMenu.classList.toggle('hidden');
            if (!langMenu.classList.contains('hidden') && langSearchInput) {
              langSearchInput.focus();
            }
          });
        }

        if (versionSelect) {
          versionSelect.addEventListener('change', () => {
            const selectedId = parseInt(versionSelect.value, 10);
            const foundV = currentLang.versions.find((v: any) => v.id === selectedId);
            if (foundV) {
              currentVersion = foundV;
              if (statusLangVersion) {
                statusLangVersion.textContent = `${currentLang.name} (${currentVersion.version})`;
              }
              saveAutosave();
            }
          });
        }

        if (examplesBtn && examplesMenu) {
          examplesBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            examplesMenu.classList.toggle('hidden');
          });
        }

        if (overflowBtn && overflowMenu) {
          overflowBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            overflowMenu.classList.toggle('hidden');
          });
        }

        // Close dropdowns on outside click
        document.addEventListener('click', () => {
          if (langMenu) langMenu.classList.add('hidden');
          if (examplesMenu) examplesMenu.classList.add('hidden');
          if (overflowMenu) overflowMenu.classList.add('hidden');
        });

        // Modals management
        const snippetsModal = document.getElementById('snippets-modal');
        const settingsModal = document.getElementById('settings-modal');
        const shortcutsModal = document.getElementById('shortcuts-modal');

        document.getElementById('open-snippets-btn')?.addEventListener('click', () => {
          if (snippetsModal) snippetsModal.classList.remove('hidden');
          if (overflowMenu) overflowMenu.classList.add('hidden');
          renderSnippetsList();
        });

        document.getElementById('open-settings-btn')?.addEventListener('click', () => {
          if (settingsModal) settingsModal.classList.remove('hidden');
          if (overflowMenu) overflowMenu.classList.add('hidden');
        });

        document.getElementById('open-shortcuts-btn')?.addEventListener('click', () => {
          if (shortcutsModal) shortcutsModal.classList.remove('hidden');
          if (overflowMenu) overflowMenu.classList.add('hidden');
        });

        document.querySelectorAll('.close-modal-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            if (snippetsModal) snippetsModal.classList.add('hidden');
            if (settingsModal) settingsModal.classList.add('hidden');
            if (shortcutsModal) shortcutsModal.classList.add('hidden');
          });
        });

        // Snippets Local Storage Engine
        function getSavedSnippets(): any[] {
          try {
            return JSON.parse(localStorage.getItem('code_playground_snippets') || '[]');
          } catch (e) {
            return [];
          }
        }

        function saveSnippetsList(list: any[]) {
          try {
            localStorage.setItem('code_playground_snippets', JSON.stringify(list));
          } catch (e) {}
        }

        function renderSnippetsList() {
          const container = document.getElementById('snippets-list-container');
          if (!container) return;

          const list = getSavedSnippets();
          if (list.length === 0) {
            container.innerHTML = '<div class="text-center py-8 text-xs text-[var(--color-text-muted)]">No snippets saved yet. Click "Save Current" to store your code locally.</div>';
            return;
          }

          container.innerHTML = '';
          list.forEach((snip, index) => {
            const card = document.createElement('div');
            card.className = 'p-3 rounded-xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] flex items-center justify-between gap-3 text-xs';
            card.innerHTML = `
              <div class="flex-1 overflow-hidden">
                <div class="font-bold text-foreground truncate">${snip.title}</div>
                <div class="text-[11px] font-mono text-[var(--color-text-muted)] flex items-center gap-2">
                  <span>${snip.langName}</span>
                  <span>•</span>
                  <span>${new Date(snip.updatedAt).toLocaleDateString()}</span>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <button type="button" class="load-snip-btn px-2.5 py-1 rounded-md bg-[var(--accent)] text-white font-mono text-[11px] cursor-pointer">Open</button>
                <button type="button" class="del-snip-btn px-2 py-1 rounded-md hover:bg-rose-500/10 text-rose-600 font-mono text-[11px] cursor-pointer">Delete</button>
              </div>
            `;

            card.querySelector('.load-snip-btn')?.addEventListener('click', () => {
              setLanguage(snip.langId);
              setCode(snip.code);
              if (snip.stdin && stdinTextarea) {
                stdinTextarea.value = snip.stdin;
              }
              if (snippetsModal) snippetsModal.classList.add('hidden');
              showToast(`Loaded snippet: ${snip.title}`);
            });

            card.querySelector('.del-snip-btn')?.addEventListener('click', () => {
              const updated = list.filter((_, idx) => idx !== index);
              saveSnippetsList(updated);
              renderSnippetsList();
              showToast('Snippet deleted');
            });

            container.appendChild(card);
          });
        }

        document.getElementById('save-current-snippet-btn')?.addEventListener('click', () => {
          const titleInput = document.getElementById('new-snippet-title-input') as HTMLInputElement;
          const title = titleInput && titleInput.value.trim() ? titleInput.value.trim() : `${currentLang.name} Snippet (${new Date().toLocaleTimeString()})`;
          const list = getSavedSnippets();
          list.unshift({
            title,
            langId: currentLang.id,
            langName: currentLang.name,
            code: getCode(),
            stdin: stdinTextarea ? stdinTextarea.value : '',
            updatedAt: Date.now()
          });
          saveSnippetsList(list);
          if (titleInput) titleInput.value = '';
          renderSnippetsList();
          showToast(`Saved snippet "${title}"`);
        });

        // Settings change handlers
        document.getElementById('setting-font-size')?.addEventListener('change', (e: any) => {
          if (editorInstance) {
            editorInstance.updateOptions({ fontSize: parseInt(e.target.value, 10) });
          }
        });
        document.getElementById('setting-tab-size')?.addEventListener('change', (e: any) => {
          if (editorInstance) {
            editorInstance.updateOptions({ tabSize: parseInt(e.target.value, 10) });
          }
        });
        document.getElementById('setting-word-wrap')?.addEventListener('change', (e: any) => {
          if (editorInstance) {
            editorInstance.updateOptions({ wordWrap: e.target.checked ? 'on' : 'off' });
          }
        });
        document.getElementById('setting-minimap')?.addEventListener('change', (e: any) => {
          if (editorInstance) {
            editorInstance.updateOptions({ minimap: { enabled: e.target.checked } });
          }
        });
        document.getElementById('setting-line-numbers')?.addEventListener('change', (e: any) => {
          if (editorInstance) {
            editorInstance.updateOptions({ lineNumbers: e.target.checked ? 'on' : 'off' });
          }
        });
        document.getElementById('setting-editor-theme')?.addEventListener('change', (e: any) => {
          if (monacoInstance) {
            monacoInstance.editor.setTheme(e.target.value);
          }
        });

        // Keyboard Shortcuts Handler (Cmd/Ctrl + Enter = Run, Cmd/Ctrl + S = Save)
        window.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
            e.preventDefault();
            executeCode();
          } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
            e.preventDefault();
            saveAutosave();
            showToast('Playground state saved locally');
          }
        });

        // Layout Toggle (Side-by-Side vs Stacked)
        const layoutSplitVBtn = document.getElementById('layout-split-v-btn');
        const layoutSplitHBtn = document.getElementById('layout-split-h-btn');
        const workspaceContainer = document.getElementById('workspace-container');
        const consolePanel = document.getElementById('console-panel');

        if (layoutSplitVBtn && layoutSplitHBtn && workspaceContainer && consolePanel) {
          layoutSplitVBtn.addEventListener('click', () => {
            workspaceContainer.className = 'flex-1 flex flex-col md:flex-row relative min-h-[500px]';
            consolePanel.className = 'w-full md:w-[480px] flex flex-col bg-[var(--color-bg-secondary)]/40 border-t md:border-t-0 md:border-l border-[var(--color-border)] min-h-[280px]';
            layoutSplitVBtn.className = 'px-1.5 py-0.5 rounded bg-[var(--card)] border border-[var(--color-border)] text-foreground cursor-pointer font-bold';
            layoutSplitHBtn.className = 'px-1.5 py-0.5 rounded hover:bg-[var(--card)] text-[var(--color-text-muted)] hover:text-foreground cursor-pointer';
            if (editorInstance) editorInstance.layout();
          });

          layoutSplitHBtn.addEventListener('click', () => {
            workspaceContainer.className = 'flex-1 flex flex-col relative min-h-[500px]';
            consolePanel.className = 'w-full h-[280px] flex flex-col bg-[var(--color-bg-secondary)]/40 border-t border-[var(--color-border)]';
            layoutSplitHBtn.className = 'px-1.5 py-0.5 rounded bg-[var(--card)] border border-[var(--color-border)] text-foreground cursor-pointer font-bold';
            layoutSplitVBtn.className = 'px-1.5 py-0.5 rounded hover:bg-[var(--card)] text-[var(--color-text-muted)] hover:text-foreground cursor-pointer';
            if (editorInstance) editorInstance.layout();
          });
        }

        // LOAD MONACO EDITOR VIA CDN (Lazy Loaded specifically on this page)
        function initMonaco() {
          const loaderScript = document.createElement('script');
          loaderScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js';
          loaderScript.async = true;

          loaderScript.onload = () => {
            // @ts-ignore
            if (window.require) {
              // @ts-ignore
              window.require.config({
                paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs' }
              });

              // @ts-ignore
              window.require(['vs/editor/editor.main'], function() {
                // @ts-ignore
                monacoInstance = window.monaco;
                if (!monacoInstance || !editorMount) return;

                editorInstance = monacoInstance.editor.create(editorMount, {
                  value: currentLang.starterCode,
                  language: currentLang.monacoLang,
                  theme: 'vs',
                  fontSize: 14,
                  tabSize: 4,
                  wordWrap: 'on',
                  minimap: { enabled: false },
                  lineNumbers: 'on',
                  scrollBeyondLastLine: false,
                  automaticLayout: true,
                  fontFamily: "'JetBrains Mono', 'Fira Code', 'Consolas', monospace",
                  fontLigatures: true,
                  renderLineHighlight: 'all',
                  bracketPairColorization: { enabled: true },
                  autoClosingBrackets: 'always'
                });

                // Cursor Position Tracking for IDE Status Bar
                editorInstance.onDidChangeCursorPosition((e: any) => {
                  if (statusCursorPos) {
                    statusCursorPos.textContent = `Ln ${e.position.lineNumber}, Col ${e.position.column}`;
                  }
                });

                // Content Change Autosave
                editorInstance.onDidChangeModelContent(() => {
                  saveAutosave();
                });

                // Add Custom Actions to Monaco Command Palette (F1)
                editorInstance.addAction({
                  id: 'playground-run-code',
                  label: 'Playground: Run Code',
                  keybindings: [
                    monacoInstance.KeyMod.CtrlCmd | monacoInstance.KeyCode.Enter
                  ],
                  run: () => {
                    executeCode();
                  }
                });

                if (editorSpinner) editorSpinner.style.display = 'none';
                restoreAutosave();
                updateVersionsDropdown();
                populateExamplesMenu();
              });
            }
          };

          loaderScript.onerror = () => {
            console.warn('Monaco CDN failed to load; activating fallback editor.');
            if (editorSpinner) editorSpinner.style.display = 'none';
            if (fallbackEditor) {
              fallbackEditor.classList.remove('hidden');
              fallbackEditor.value = currentLang.starterCode;
              fallbackEditor.addEventListener('input', saveAutosave);
            }
            restoreAutosave();
            updateVersionsDropdown();
            populateExamplesMenu();
          };

          document.head.appendChild(loaderScript);
        }

        // Initialize!
        initMonaco();
      })();
    </script>
  </body>
</html>
