    <!-- TOAST NOTIFICATION CONTAINER -->
    <div id="playground-toast" class="fixed bottom-5 right-5 z-50 hidden px-4 py-2 rounded-xl bg-slate-900 text-white text-xs font-mono shadow-2xl flex items-center gap-2 border border-slate-700 transition-all transform translate-y-2">
