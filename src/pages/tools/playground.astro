---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import GlowLineSeparator from '../../components/ui/separator/GlowLineSeparator.astro';
import { PLAYGROUND_LANGUAGES } from '../../data/playground/languages';

const pageTitle = "Online Code Compiler & Programming Playground | Piush";
const pageDescription = "Write and run JavaScript, Python, Java, C, C++, Kotlin, Swift, Dart and other programming languages online with a fast developer code playground.";

const popularLangs = PLAYGROUND_LANGUAGES.filter(l => l.category === 'popular');
const moreLangs = PLAYGROUND_LANGUAGES.filter(l => l.category === 'more');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <!-- Structured Data: WebApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Code Playground',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'All',
      browserRequirements: 'Requires JavaScript',
      url: new URL('/tools/playground', Astro.site || 'https://piush.com').toString(),
      description: pageDescription,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
    })} />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col font-sans selection:bg-[var(--accent)]/20">
    <div id="site-header-container">
      <Header />
    </div>

    <main class="flex-1 w-full px-3 sm:px-6 lg:px-8 py-3 sm:py-5 space-y-3 max-w-[1700px] mx-auto flex flex-col" id="playground-main">
      
      <!-- Top Navigation & Breadcrumbs -->
      <div id="playground-top-bar" class="flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--color-text-muted)] border-b border-[var(--color-border)] pb-2.5">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2">
          <a href="/" class="hover:text-[var(--accent)] transition-colors no-underline">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--accent)] transition-colors no-underline">Tools</a>
          <span>/</span>
          <span class="text-[var(--accent)] font-medium">Code Playground</span>
        </nav>
        
        <div class="flex items-center gap-3">
          <!-- Quiz Cross-Link -->
          <a
            href="/quiz"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-mono font-medium bg-[rgba(var(--accent-rgb),0.08)] hover:bg-[rgba(var(--accent-rgb),0.15)] text-[var(--accent)] border border-[rgba(var(--accent-rgb),0.2)] transition-all no-underline"
            title="Practice your output prediction skills with 550+ verified coding questions"
          >
            <span>💡</span>
            <span>Think you know the output? Try Code Challenges &rarr;</span>
          </a>

          <div class="hidden md:flex items-center gap-2 font-mono text-[11px] text-[var(--color-text-secondary)]">
            <span class="inline-flex size-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Isolated Sandbox • 20+ Runtimes</span>
          </div>
        </div>
      </div>

      <!-- Playground App Shell Container -->
      <div id="playground-app" class="flex-1 flex flex-col rounded-2xl border border-[var(--color-border)] bg-[var(--card)] shadow-sm overflow-hidden min-h-[700px]">
        
        <!-- IDE Toolbar -->
        <header class="flex flex-wrap items-center justify-between gap-2 px-3 sm:px-4 py-2 bg-[var(--color-bg-secondary)] border-b border-[var(--color-border)] select-none">
          
          <!-- Left: Language & Version Selectors -->
          <div class="flex flex-wrap items-center gap-2">
            
            <!-- Language Selector Dropdown -->
            <div class="relative" id="lang-dropdown-wrapper">
              <button
                type="button"
                id="lang-select-btn"
                class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[var(--card)] hover:bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--accent)] text-foreground text-xs font-mono font-semibold transition-all shadow-xs cursor-pointer"
                aria-haspopup="listbox"
                aria-expanded="false"
              >
                <span id="selected-lang-icon" class="text-sm">⚡</span>
                <span id="selected-lang-name">Python</span>
                <svg class="size-3 text-[var(--color-text-muted)]" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                </svg>
              </button>

              <!-- Language Menu Modal/Dropdown -->
              <div
                id="lang-menu"
                class="hidden absolute top-full left-0 mt-1 w-72 max-h-96 rounded-xl bg-[var(--card)] border border-[var(--color-border)] shadow-xl z-50 overflow-hidden flex-col text-xs"
                role="listbox"
              >
                <div class="p-2 border-b border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
                  <input
                    type="text"
                    id="lang-search-input"
                    placeholder="Search languages..."
                    class="w-full px-2.5 py-1.5 rounded-md bg-[var(--card)] border border-[var(--color-border)] text-foreground text-xs font-sans focus:outline-none focus:border-[var(--accent)]"
                    autocomplete="off"
                  />
                </div>

                <div class="overflow-y-auto max-h-72 p-1.5 space-y-2" id="lang-menu-list">
                  <div>
                    <div class="px-2 py-1 text-[10px] font-mono font-bold text-[var(--color-text-muted)] tracking-wider">POPULAR</div>
                    <div class="space-y-0.5" id="popular-lang-items">
                      {popularLangs.map(l => (
                        <button
                          type="button"
                          class="lang-option w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-left text-foreground hover:bg-[rgba(var(--accent-rgb),0.1)] hover:text-[var(--accent)] transition-colors cursor-pointer"
                          data-lang={l.id}
                        >
                          <span class="font-medium font-mono">{l.name}</span>
                          <span class="text-[10px] text-[var(--color-text-muted)] font-mono">{l.ext}</span>
                        </button>
                      ))}
                    </div>
                  </div>

                  <div>
                    <div class="px-2 py-1 text-[10px] font-mono font-bold text-[var(--color-text-muted)] tracking-wider">MORE LANGUAGES</div>
                    <div class="space-y-0.5" id="more-lang-items">
                      {moreLangs.map(l => (
                        <button
                          type="button"
                          class="lang-option w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-left text-foreground hover:bg-[rgba(var(--accent-rgb),0.1)] hover:text-[var(--accent)] transition-colors cursor-pointer"
                          data-lang={l.id}
                        >
                          <span class="font-medium font-mono">{l.name}</span>
                          <span class="text-[10px] text-[var(--color-text-muted)] font-mono">{l.ext}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Version Selector -->
            <div class="relative" id="version-dropdown-wrapper">
              <select
                id="version-select"
                class="px-2.5 py-1.5 rounded-lg bg-[var(--card)] border border-[var(--color-border)] hover:border-[var(--accent)] text-foreground text-xs font-mono font-medium focus:outline-none focus:border-[var(--accent)] cursor-pointer"
                title="Select Compiler / Runtime Version"
              >
                <!-- Populated dynamically -->
              </select>
            </div>

            <!-- Templates / Examples Dropdown -->
            <div class="relative" id="examples-dropdown-wrapper">
              <button
                type="button"
                id="examples-btn"
                class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-[var(--card)] hover:bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-xs font-mono text-[var(--color-text-secondary)] hover:text-foreground cursor-pointer transition-colors"
                title="Load code templates & examples"
              >
                <span>📚</span>
                <span>Examples</span>
              </button>

              <div
                id="examples-menu"
                class="hidden absolute top-full left-0 mt-1 w-64 max-h-80 rounded-xl bg-[var(--card)] border border-[var(--color-border)] shadow-xl z-50 overflow-y-auto p-1 text-xs"
              >
                <!-- Populated dynamically per language -->
              </div>
            </div>

          </div>

          <!-- Center/Right: Primary Run & Action Buttons -->
          <div class="flex items-center gap-1.5 sm:gap-2">
            
            <!-- RUN BUTTON (Primary Action) -->
            <button
              type="button"
              id="run-code-btn"
              class="flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-[var(--accent)] hover:opacity-90 active:scale-[0.98] text-white text-xs font-mono font-bold tracking-wide shadow-xs transition-all cursor-pointer"
              title="Run code (Ctrl/Cmd + Enter)"
            >
              <svg class="size-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <span>Run Code</span>
              <kbd class="hidden lg:inline-block text-[10px] px-1 py-0.2 rounded bg-black/20 text-white/90">⌘↵</kbd>
            </button>

            <!-- STOP BUTTON (Enabled during execution) -->
            <button
              type="button"
              id="stop-code-btn"
              class="hidden items-center gap-1.5 px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-mono font-bold transition-all cursor-pointer"
              title="Stop execution"
            >
              <span class="size-2 rounded-xs bg-white"></span>
              <span>Stop</span>
            </button>

            <div class="h-5 w-[1px] bg-[var(--color-border)] mx-0.5 hidden sm:block"></div>

            <!-- Reset Code Button -->
            <button
              type="button"
              id="reset-code-btn"
              class="p-1.5 sm:px-2.5 sm:py-1.5 rounded-lg bg-[var(--card)] hover:bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-xs font-mono text-[var(--color-text-secondary)] hover:text-foreground cursor-pointer transition-colors"
              title="Reset code to default template"
            >
              <span class="sm:hidden">↺</span>
              <span class="hidden sm:inline">Reset</span>
            </button>

            <!-- Format Code Button -->
            <button
              type="button"
              id="format-code-btn"
              class="p-1.5 sm:px-2.5 sm:py-1.5 rounded-lg bg-[var(--card)] hover:bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-xs font-mono text-[var(--color-text-secondary)] hover:text-foreground cursor-pointer transition-colors"
              title="Format source code"
            >
              <span class="sm:hidden">✨</span>
              <span class="hidden sm:inline">Format</span>
            </button>

            <!-- Copy Code -->
            <button
              type="button"
              id="copy-code-btn"
              class="p-1.5 sm:px-2.5 sm:py-1.5 rounded-lg bg-[var(--card)] hover:bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-xs font-mono text-[var(--color-text-secondary)] hover:text-foreground cursor-pointer transition-colors"
              title="Copy code to clipboard"
            >
              <span class="sm:hidden">📋</span>
              <span class="hidden sm:inline">Copy</span>
            </button>

            <!-- Download Code -->
            <button
              type="button"
              id="download-code-btn"
              class="p-1.5 sm:px-2.5 sm:py-1.5 rounded-lg bg-[var(--card)] hover:bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-xs font-mono text-[var(--color-text-secondary)] hover:text-foreground cursor-pointer transition-colors"
              title="Download source code"
            >
              <span class="sm:hidden">⬇</span>
              <span class="hidden sm:inline">Download</span>
            </button>

            <!-- Share Button -->
            <button
              type="button"
              id="share-code-btn"
              class="p-1.5 sm:px-2.5 sm:py-1.5 rounded-lg bg-[var(--card)] hover:bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-xs font-mono text-[var(--color-text-secondary)] hover:text-foreground cursor-pointer transition-colors"
              title="Generate shareable URL"
            >
              <span class="sm:hidden">🔗</span>
              <span class="hidden sm:inline">Share</span>
            </button>

            <!-- Overflow Actions Menu -->
            <div class="relative" id="overflow-dropdown-wrapper">
              <button
                type="button"
                id="overflow-menu-btn"
                class="p-1.5 rounded-lg bg-[var(--card)] hover:bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-foreground cursor-pointer transition-colors"
                title="More options & settings"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="1"></circle>
                  <circle cx="12" cy="5" r="1"></circle>
                  <circle cx="12" cy="19" r="1"></circle>
                </svg>
              </button>

              <div
                id="overflow-menu"
                class="hidden absolute top-full right-0 mt-1 w-52 rounded-xl bg-[var(--card)] border border-[var(--color-border)] shadow-xl z-50 p-1 text-xs"
              >
                <button type="button" id="open-snippets-btn" class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-foreground hover:bg-[rgba(var(--accent-rgb),0.08)] cursor-pointer">
                  <span>💾</span>
                  <span>My Snippets</span>
                </button>
                <button type="button" id="open-settings-btn" class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-foreground hover:bg-[rgba(var(--accent-rgb),0.08)] cursor-pointer">
                  <span>⚙️</span>
                  <span>Editor Settings</span>
                </button>
                <button type="button" id="open-shortcuts-btn" class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-foreground hover:bg-[rgba(var(--accent-rgb),0.08)] cursor-pointer">
                  <span>⌨️</span>
                  <span>Keyboard Shortcuts</span>
                </button>
                <button type="button" id="toggle-multi-file-btn" class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-foreground hover:bg-[rgba(var(--accent-rgb),0.08)] cursor-pointer">
                  <span>📁</span>
                  <span id="multi-file-toggle-label">Enable Multi-File Mode</span>
                </button>
                <div class="my-1 border-t border-[var(--color-border)]"></div>
                <button type="button" id="clear-code-btn" class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-rose-600 hover:bg-rose-500/10 cursor-pointer">
                  <span>🗑️</span>
                  <span>Clear Code</span>
                </button>
                <button type="button" id="clear-output-btn" class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-rose-600 hover:bg-rose-500/10 cursor-pointer">
                  <span>🧹</span>
                  <span>Clear Output</span>
                </button>
              </div>
            </div>

            <!-- Focus Mode (Full Screen) -->
            <button
              type="button"
              id="focus-mode-btn"
              class="p-1.5 rounded-lg bg-[var(--card)] hover:bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-foreground cursor-pointer transition-colors"
              title="Toggle Focus Mode (Fullscreen)"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
              </svg>
            </button>

          </div>
        </header>

        <!-- Optional Multi-File Tab Bar (Initially Hidden) -->
        <div id="multi-file-bar" class="hidden px-3 py-1.5 bg-[var(--color-bg-secondary)]/50 border-b border-[var(--color-border)] flex items-center gap-1.5 overflow-x-auto text-xs font-mono">
          <div id="file-tabs-container" class="flex items-center gap-1">
            <!-- Tabs rendered dynamically -->
          </div>
          <button type="button" id="add-file-btn" class="px-2 py-1 rounded-md bg-[var(--card)] hover:bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-foreground text-[11px] cursor-pointer">
            + Add File
          </button>
        </div>

        <!-- Mobile View Navigation Tabs (< 768px) -->
        <div class="md:hidden flex items-center border-b border-[var(--color-border)] bg-[var(--color-bg-secondary)] text-xs font-mono">
          <button type="button" class="mobile-tab-btn flex-1 py-2 text-center font-bold text-[var(--accent)] border-b-2 border-[var(--accent)] cursor-pointer" data-tab="code">
            CODE
          </button>
          <button type="button" class="mobile-tab-btn flex-1 py-2 text-center text-[var(--color-text-muted)] cursor-pointer" data-tab="input">
            INPUT (stdin)
          </button>
          <button type="button" class="mobile-tab-btn flex-1 py-2 text-center text-[var(--color-text-muted)] cursor-pointer" data-tab="output">
            OUTPUT
          </button>
        </div>

        <!-- Layout Toggle Bar (Side-by-Side vs Stacked) for Desktop -->
        <div class="hidden md:flex items-center justify-between px-3 py-1 bg-[var(--color-bg-secondary)]/30 border-b border-[var(--color-border)]/50 text-[11px] font-mono text-[var(--color-text-muted)]">
          <div class="flex items-center gap-2">
            <span id="active-filename-label">main.py</span>
            <span>•</span>
            <span id="autosave-indicator" class="text-[10px] text-emerald-600 font-semibold">Autosaved</span>
          </div>

          <div class="flex items-center gap-2">
            <span>Layout:</span>
            <button type="button" id="layout-split-v-btn" class="px-1.5 py-0.5 rounded bg-[var(--card)] border border-[var(--color-border)] text-foreground cursor-pointer font-bold" title="Side by Side">
              Vertical Split [ | ]
            </button>
            <button type="button" id="layout-split-h-btn" class="px-1.5 py-0.5 rounded hover:bg-[var(--card)] text-[var(--color-text-muted)] hover:text-foreground cursor-pointer" title="Stacked">
              Horizontal Split [ = ]
            </button>
          </div>
        </div>

        <!-- Main Workspace Area: Editor & Terminal Console -->
        <div id="workspace-container" class="flex-1 flex flex-col md:flex-row relative min-h-[500px]">
          
          <!-- Code Editor Panel -->
          <div id="editor-panel" class="flex-1 flex flex-col relative w-full h-[400px] md:h-auto min-h-[300px]">
            <!-- Monaco Editor Mount Container -->
            <div id="monaco-editor-mount" class="w-full h-full"></div>

            <!-- Fallback Textarea Editor (if Monaco CDN is offline/blocked) -->
            <textarea
              id="fallback-code-editor"
              class="hidden w-full h-full p-4 font-mono text-sm bg-[var(--card)] text-foreground border-none resize-none focus:outline-none"
              spellcheck="false"
              aria-label="Code Editor"
            ></textarea>

            <!-- Loading Spinner for Editor Mount -->
            <div id="editor-loading-spinner" class="absolute inset-0 flex flex-col items-center justify-center bg-[var(--card)]/90 backdrop-blur-xs gap-3 z-10">
              <div class="size-8 rounded-full border-2 border-[var(--accent)] border-t-transparent animate-spin"></div>
              <span class="font-mono text-xs text-[var(--color-text-muted)]">Initializing Monaco Editor...</span>
            </div>
          </div>

          <!-- Resizer Split Handle -->
          <div
            id="panel-resizer"
            class="hidden md:flex w-2 hover:w-2 bg-[var(--color-bg-secondary)] hover:bg-[var(--accent)]/50 cursor-col-resize items-center justify-center transition-colors select-none z-20"
            title="Drag to resize panels"
          >
            <div class="w-0.5 h-6 bg-[var(--color-border)] rounded-full"></div>
          </div>

          <!-- Console & Output Panel -->
          <div id="console-panel" class="w-full md:w-[480px] flex flex-col bg-[var(--color-bg-secondary)]/40 border-t md:border-t-0 md:border-l border-[var(--color-border)] min-h-[280px]">
            
            <!-- Terminal Header & Tabs -->
            <div class="flex items-center justify-between px-3 py-1.5 bg-[var(--color-bg-secondary)] border-b border-[var(--color-border)] text-xs font-mono select-none">
              <div class="flex items-center gap-1">
                <button
                  type="button"
                  class="console-tab-btn px-2.5 py-1 rounded-md font-bold bg-[var(--card)] text-[var(--accent)] border border-[var(--color-border)] cursor-pointer"
                  data-console-tab="output"
                >
                  Output
                </button>
                <button
                  type="button"
                  class="console-tab-btn px-2.5 py-1 rounded-md text-[var(--color-text-muted)] hover:text-foreground cursor-pointer"
                  data-console-tab="input"
                >
                  Input (stdin)
                </button>
                <button
                  type="button"
                  class="console-tab-btn px-2.5 py-1 rounded-md text-[var(--color-text-muted)] hover:text-foreground cursor-pointer"
                  data-console-tab="errors"
                >
                  Errors <span id="error-badge-count" class="hidden px-1 py-0.2 rounded-full bg-rose-500 text-white text-[10px]">0</span>
                </button>
              </div>

              <!-- Console Actions -->
              <div class="flex items-center gap-1">
                <button type="button" id="copy-output-btn" class="px-2 py-0.5 rounded text-[11px] text-[var(--color-text-secondary)] hover:text-foreground hover:bg-[var(--card)] cursor-pointer" title="Copy output">
                  Copy
                </button>
                <button type="button" id="clear-output-icon-btn" class="px-2 py-0.5 rounded text-[11px] text-[var(--color-text-secondary)] hover:text-foreground hover:bg-[var(--card)] cursor-pointer" title="Clear output">
                  Clear
                </button>
              </div>
            </div>

            <!-- Terminal Execution Status Banner -->
            <div id="execution-status-bar" class="px-3 py-1.5 bg-[var(--card)] border-b border-[var(--color-border)] flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
              <div class="flex items-center gap-2" id="status-badge-container">
                <span class="size-2 rounded-full bg-slate-400" id="status-indicator-dot"></span>
                <span id="status-text" class="font-semibold text-[var(--color-text-muted)]">Ready</span>
              </div>

              <!-- Execution Time & Memory Stats -->
              <div id="execution-metrics" class="hidden flex items-center gap-3 text-[11px] text-[var(--color-text-secondary)]">
                <span id="metric-time">Time: -</span>
                <span>•</span>
                <span id="metric-memory">Memory: -</span>
              </div>
            </div>

            <!-- Output Body Viewports -->
            <div class="flex-1 relative overflow-hidden flex flex-col">
              
              <!-- TAB 1: STDOUT (Main Output) -->
              <div id="tab-content-output" class="flex-1 p-3 overflow-y-auto font-mono text-xs whitespace-pre-wrap select-text text-foreground leading-relaxed">
                <div id="stdout-content" class="text-[var(--color-text-secondary)]">Click <strong class="text-[var(--accent)] font-bold">Run Code (Ctrl+Enter)</strong> to execute the script in an isolated sandbox.</div>
              </div>

              <!-- TAB 2: STDIN (Program Input) -->
              <div id="tab-content-input" class="hidden flex-1 p-3 flex-col gap-2">
                <label for="stdin-textarea" class="text-xs font-mono text-[var(--color-text-muted)] flex items-center justify-between">
                  <span>Standard Input (stdin):</span>
                  <span class="text-[11px] text-[var(--color-text-muted)]">Passed to cin, Scanner, input(), or readSync()</span>
                </label>
                <textarea
                  id="stdin-textarea"
                  class="flex-1 w-full p-2.5 rounded-lg bg-[var(--card)] border border-[var(--color-border)] text-foreground font-mono text-xs focus:outline-none focus:border-[var(--accent)] resize-none"
                  placeholder="Enter inputs here (e.g. numbers, strings, or lines of text)..."
                ></textarea>
              </div>

              <!-- TAB 3: ERRORS & COMPILER DIAGNOSTICS -->
