      // ================= APPLICATION STATE =================
      const state = {
        sourceMode: 'creator', // 'upload' | 'creator'
        uploadedImage: null as HTMLImageElement | null,
        uploadedSvgText: null as string | null,
        uploadedFilename: '',
        uploadedDims: { w: 0, h: 0 },

        creatorSubmode: 'icon', // 'icon' | 'letter' | 'shape'
        selectedIcon: ICON_LIBRARY.find(i => i.id === 'game-sparkles') || ICON_LIBRARY[0],
        iconCategory: 'all',

        letterText: 'P',
        letterFont: 'system-ui, -apple-system, sans-serif',
        letterWeight: '700',
        letterColor: '#FFFFFF',
        letterAlign: 'center',

        shapeType: 'circle',
        shapeFill: '#ADE1CD',
        shapeStroke: '#1B5448',
        shapeStrokeWidth: 0,

        bgType: 'solid', // 'solid' | 'linear' | 'radial' | 'transparent'
        bgSolid: '#1B5448',
        bgGrad1: '#1B5448',
        bgGrad2: '#ADE1CD',
        bgGradAngle: 135,
        bgVisible: true,

        fgScale: 65,
        fgRotate: 0,
        fgX: 0,
        fgY: 0,
        fgOpacity: 100,
        fgTintEnabled: false,
        fgTintColor: '#FFFFFF',

        showSafeZone: true,
        showGrid: false,
        showCenterGuides: false,
        canvasMask: 'none' // 'none' | 'squircle' | 'circle'
      };

      // Dragging state on master canvas
      let isDragging = false;
      let dragStartX = 0;
      let dragStartY = 0;
      let initialFgX = 0;
      let initialFgY = 0;

      // ================= DOM ELEMENT REFERENCES =================
      const masterCanvas = document.getElementById('master-canvas') as HTMLCanvasElement;
      const ctx = masterCanvas?.getContext('2d');
      const canvasWrapper = document.getElementById('canvas-wrapper');

      // Previews
      const prevAndroidCircle = document.getElementById('prev-android-circle') as HTMLCanvasElement;
      const prevAndroidSquircle = document.getElementById('prev-android-squircle') as HTMLCanvasElement;
      const prevAndroidRounded = document.getElementById('prev-android-rounded') as HTMLCanvasElement;
      const prevAndroidSquare = document.getElementById('prev-android-square') as HTMLCanvasElement;
      const mockAndroidHome = document.getElementById('mock-android-home') as HTMLCanvasElement;
      const mockAndroidSettings = document.getElementById('mock-android-settings') as HTMLCanvasElement;

      const mockIosHome = document.getElementById('mock-ios-home') as HTMLCanvasElement;
      const mockIosSpotlight = document.getElementById('mock-ios-spotlight') as HTMLCanvasElement;
      const mockIosSettings = document.getElementById('mock-ios-settings') as HTMLCanvasElement;
      const mockStoreArt = document.getElementById('mock-store-art') as HTMLCanvasElement;

      // Overlays
      const overlaySafeZone = document.getElementById('overlay-safezone');
      const overlayGrid = document.getElementById('overlay-grid');
      const overlayCenter = document.getElementById('overlay-center');

      // Sliders & Values
      const fgScale = document.getElementById('fg-scale') as HTMLInputElement;
      const fgRotate = document.getElementById('fg-rotate') as HTMLInputElement;
      const fgX = document.getElementById('fg-x') as HTMLInputElement;
      const fgY = document.getElementById('fg-y') as HTMLInputElement;
      const fgOpacity = document.getElementById('fg-opacity') as HTMLInputElement;

      const fgScaleVal = document.getElementById('fg-scale-val');
      const fgRotateVal = document.getElementById('fg-rotate-val');
      const fgXVal = document.getElementById('fg-x-val');
      const fgYVal = document.getElementById('fg-y-val');
      const fgOpacityVal = document.getElementById('fg-opacity-val');

      // Verification
      const validationList = document.getElementById('validation-list');
      const badgeAllClear = document.getElementById('badge-all-clear');

