      // ================= MASTER RENDER PIPELINE (1024 x 1024) =================
      function renderOffscreen(size: number, options: { mask?: 'none' | 'circle' | 'squircle' | 'round-rect', skipBg?: boolean, onlyFg?: boolean } = {}): HTMLCanvasElement {
        const offCanvas = document.createElement('canvas');
        offCanvas.width = size;
        offCanvas.height = size;
        const offCtx = offCanvas.getContext('2d');
        if (!offCtx) return offCanvas;

        const ratio = size / 1024;

        // Apply clip mask if requested
        if (options.mask === 'circle') {
          offCtx.beginPath();
          offCtx.arc(size / 2, size / 2, size / 2, 0, Math.PI * 2);
          offCtx.closePath();
          offCtx.clip();
        } else if (options.mask === 'squircle') {
          // Apple continuous rounded rectangle (approx rx = 22.37%)
          const r = size * 0.2237;
          offCtx.beginPath();
          offCtx.roundRect(0, 0, size, size, r);
          offCtx.closePath();
          offCtx.clip();
        } else if (options.mask === 'round-rect') {
          const r = size * 0.16;
          offCtx.beginPath();
          offCtx.roundRect(0, 0, size, size, r);
          offCtx.closePath();
          offCtx.clip();
        }

        // 1. Render Background
        if (!options.onlyFg && !options.skipBg && state.bgVisible && state.bgType !== 'transparent') {
          if (state.bgType === 'solid') {
            offCtx.fillStyle = state.bgSolid;
            offCtx.fillRect(0, 0, size, size);
          } else if (state.bgType === 'linear') {
            const rad = (state.bgGradAngle * Math.PI) / 180;
            const x1 = size / 2 - (Math.cos(rad) * size) / 2;
            const y1 = size / 2 - (Math.sin(rad) * size) / 2;
            const x2 = size / 2 + (Math.cos(rad) * size) / 2;
            const y2 = size / 2 + (Math.sin(rad) * size) / 2;
            const grad = offCtx.createLinearGradient(x1, y1, x2, y2);
            grad.addColorStop(0, state.bgGrad1);
            grad.addColorStop(1, state.bgGrad2);
            offCtx.fillStyle = grad;
            offCtx.fillRect(0, 0, size, size);
          } else if (state.bgType === 'radial') {
            const grad = offCtx.createRadialGradient(size / 2, size / 2, size * 0.05, size / 2, size / 2, size * 0.7);
            grad.addColorStop(0, state.bgGrad2);
            grad.addColorStop(1, state.bgGrad1);
            offCtx.fillStyle = grad;
            offCtx.fillRect(0, 0, size, size);
          }
        }

        // 2. Render Shape Layer if in shape mode
        if (state.sourceMode === 'creator' && state.creatorSubmode === 'shape') {
          offCtx.save();
          offCtx.translate(size / 2 + state.fgX * ratio, size / 2 + state.fgY * ratio);
          offCtx.rotate((state.fgRotate * Math.PI) / 180);
          offCtx.globalAlpha = (state.fgOpacity / 100);

          const shapeR = (size * 0.35) * (state.fgScale / 65);
          offCtx.fillStyle = state.shapeFill;
          offCtx.strokeStyle = state.shapeStroke;
          offCtx.lineWidth = state.shapeStrokeWidth * ratio;

          offCtx.beginPath();
          if (state.shapeType === 'circle') {
            offCtx.arc(0, 0, shapeR, 0, Math.PI * 2);
          } else if (state.shapeType === 'square') {
            offCtx.rect(-shapeR, -shapeR, shapeR * 2, shapeR * 2);
          } else if (state.shapeType === 'rounded-square') {
            offCtx.roundRect(-shapeR, -shapeR, shapeR * 2, shapeR * 2, shapeR * 0.4);
          } else if (state.shapeType === 'triangle') {
            offCtx.moveTo(0, -shapeR);
            offCtx.lineTo(shapeR, shapeR);
            offCtx.lineTo(-shapeR, shapeR);
            offCtx.closePath();
          } else if (state.shapeType === 'diamond') {
            offCtx.moveTo(0, -shapeR);
            offCtx.lineTo(shapeR, 0);
            offCtx.lineTo(0, shapeR);
            offCtx.lineTo(-shapeR, 0);
            offCtx.closePath();
          } else if (state.shapeType === 'hexagon') {
            for (let i = 0; i < 6; i++) {
              const a = (i * Math.PI) / 3;
              const x = shapeR * Math.cos(a);
              const y = shapeR * Math.sin(a);
              if (i === 0) offCtx.moveTo(x, y);
              else offCtx.lineTo(x, y);
            }
            offCtx.closePath();
          } else if (state.shapeType === 'star') {
            const spikes = 5;
            const outer = shapeR;
            const inner = shapeR * 0.45;
            for (let i = 0; i < spikes * 2; i++) {
              const r = i % 2 === 0 ? outer : inner;
              const a = (i * Math.PI) / spikes - Math.PI / 2;
              const x = r * Math.cos(a);
              const y = r * Math.sin(a);
              if (i === 0) offCtx.moveTo(x, y);
              else offCtx.lineTo(x, y);
            }
            offCtx.closePath();
          } else if (state.shapeType === 'heart') {
            const h = shapeR * 0.9;
            offCtx.moveTo(0, h * 0.3);
            offCtx.bezierCurveTo(-h * 0.8, -h * 0.5, -h * 1.2, h * 0.3, 0, h * 1.1);
            offCtx.bezierCurveTo(h * 1.2, h * 0.3, h * 0.8, -h * 0.5, 0, h * 0.3);
            offCtx.closePath();
          } else {
            // Blob
            offCtx.moveTo(0, -shapeR);
            offCtx.bezierCurveTo(shapeR * 1.2, -shapeR * 0.7, shapeR * 0.9, shapeR * 0.9, 0, shapeR);
            offCtx.bezierCurveTo(-shapeR * 0.9, shapeR * 0.9, -shapeR * 1.2, -shapeR * 0.7, 0, -shapeR);
            offCtx.closePath();
          }

          offCtx.fill();
          if (state.shapeStrokeWidth > 0) offCtx.stroke();
          offCtx.restore();
        }

        // 3. Render Uploaded Artwork
        if (state.sourceMode === 'upload' && state.uploadedImage) {
          offCtx.save();
          offCtx.translate(size / 2 + state.fgX * ratio, size / 2 + state.fgY * ratio);
          offCtx.rotate((state.fgRotate * Math.PI) / 180);
          offCtx.globalAlpha = state.fgOpacity / 100;

          const baseDim = size * (state.fgScale / 100);
          const aspect = state.uploadedImage.width / (state.uploadedImage.height || 1);
          let drawW = baseDim;
          let drawH = baseDim;
          if (aspect > 1) {
            drawH = baseDim / aspect;
          } else {
            drawW = baseDim * aspect;
          }

          if (state.fgTintEnabled) {
            // Tint via temporary canvas
            const tintCanv = document.createElement('canvas');
            tintCanv.width = drawW;
            tintCanv.height = drawH;
            const tCtx = tintCanv.getContext('2d');
            if (tCtx) {
              tCtx.drawImage(state.uploadedImage, 0, 0, drawW, drawH);
              tCtx.globalCompositeOperation = 'source-in';
              tCtx.fillStyle = state.fgTintColor;
              tCtx.fillRect(0, 0, drawW, drawH);
              offCtx.drawImage(tintCanv, -drawW / 2, -drawH / 2, drawW, drawH);
            }
          } else {
            offCtx.drawImage(state.uploadedImage, -drawW / 2, -drawH / 2, drawW, drawH);
          }
          offCtx.restore();
        }

        // 4. Render Selected Built-in Icon
        if (state.sourceMode === 'creator' && state.creatorSubmode === 'icon' && state.selectedIcon) {
          offCtx.save();
          offCtx.translate(size / 2 + state.fgX * ratio, size / 2 + state.fgY * ratio);
          offCtx.rotate((state.fgRotate * Math.PI) / 180);
          offCtx.globalAlpha = state.fgOpacity / 100;

          const iconSize = size * (state.fgScale / 100);
          const pathScale = iconSize / 24; // 24x24 viewBox

          offCtx.translate(-iconSize / 2, -iconSize / 2);
          offCtx.scale(pathScale, pathScale);

          const p2d = new Path2D(state.selectedIcon.path);
          offCtx.strokeStyle = state.fgTintEnabled ? state.fgTintColor : '#FFFFFF';
          offCtx.lineWidth = 1.8;
          offCtx.lineCap = 'round';
          offCtx.lineJoin = 'round';
          offCtx.stroke(p2d);

          offCtx.restore();
        }

        // 5. Render Letter Logo
        if (state.sourceMode === 'creator' && state.creatorSubmode === 'letter' && state.letterText) {
          offCtx.save();
          let yPos = size / 2;
          if (state.letterAlign === 'top') yPos = size * 0.35;
          if (state.letterAlign === 'bottom') yPos = size * 0.65;

          offCtx.translate(size / 2 + state.fgX * ratio, yPos + state.fgY * ratio);
          offCtx.rotate((state.fgRotate * Math.PI) / 180);
          offCtx.globalAlpha = state.fgOpacity / 100;

          const fontSize = Math.round(size * 0.45 * (state.fgScale / 65));
          offCtx.font = `${state.letterWeight} ${fontSize}px ${state.letterFont}`;
          offCtx.textAlign = 'center';
          offCtx.textBaseline = 'middle';
          offCtx.fillStyle = state.letterColor;
          offCtx.fillText(state.letterText, 0, 0);

          offCtx.restore();
        }

        return offCanvas;
      }

      // Render Master Canvas and all satellite previews
      function renderAll() {
        if (!ctx) return;

        // 1. Render Master (1024)
        ctx.clearRect(0, 0, 1024, 1024);
        const masterOff = renderOffscreen(1024, { mask: state.canvasMask as any });
        ctx.drawImage(masterOff, 0, 0);

        // 2. Render Android Previews
        if (prevAndroidCircle) {
          const cCtx = prevAndroidCircle.getContext('2d');
          if (cCtx) {
            cCtx.clearRect(0, 0, 128, 128);
            cCtx.drawImage(renderOffscreen(128, { mask: 'circle' }), 0, 0);
          }
        }
        if (prevAndroidSquircle) {
          const sCtx = prevAndroidSquircle.getContext('2d');
          if (sCtx) {
            sCtx.clearRect(0, 0, 128, 128);
            sCtx.drawImage(renderOffscreen(128, { mask: 'squircle' }), 0, 0);
          }
        }
        if (prevAndroidRounded) {
          const rCtx = prevAndroidRounded.getContext('2d');
          if (rCtx) {
            rCtx.clearRect(0, 0, 128, 128);
            rCtx.drawImage(renderOffscreen(128, { mask: 'round-rect' }), 0, 0);
          }
        }
        if (prevAndroidSquare) {
          const sqCtx = prevAndroidSquare.getContext('2d');
          if (sqCtx) {
            sqCtx.clearRect(0, 0, 128, 128);
            sqCtx.drawImage(renderOffscreen(128, { mask: 'none' }), 0, 0);
          }
        }
        if (mockAndroidHome) {
          const hCtx = mockAndroidHome.getContext('2d');
          if (hCtx) {
            hCtx.clearRect(0, 0, 96, 96);
            hCtx.drawImage(renderOffscreen(96, { mask: 'circle' }), 0, 0);
          }
        }
        if (mockAndroidSettings) {
          const stCtx = mockAndroidSettings.getContext('2d');
          if (stCtx) {
            stCtx.clearRect(0, 0, 64, 64);
            stCtx.drawImage(renderOffscreen(64, { mask: 'circle' }), 0, 0);
          }
        }

        // 3. Render iOS Previews
        if (mockIosHome) {
          const iCtx = mockIosHome.getContext('2d');
          if (iCtx) {
            iCtx.clearRect(0, 0, 128, 128);
            iCtx.drawImage(renderOffscreen(128, { mask: 'squircle' }), 0, 0);
          }
        }
        if (mockIosSpotlight) {
          const spCtx = mockIosSpotlight.getContext('2d');
          if (spCtx) {
            spCtx.clearRect(0, 0, 64, 64);
            spCtx.drawImage(renderOffscreen(64, { mask: 'squircle' }), 0, 0);
          }
        }
        if (mockIosSettings) {
          const setCtx = mockIosSettings.getContext('2d');
          if (setCtx) {
            setCtx.clearRect(0, 0, 58, 58);
            setCtx.drawImage(renderOffscreen(58, { mask: 'squircle' }), 0, 0);
          }
        }
        if (mockStoreArt) {
          const stCtx = mockStoreArt.getContext('2d');
          if (stCtx) {
            stCtx.clearRect(0, 0, 256, 256);
            stCtx.drawImage(renderOffscreen(256, { mask: 'squircle' }), 0, 0);
          }
        }

        // 4. Run Verification Checks
        runVerification();

        // 5. Persist to localStorage
        saveState();
      }

      // ================= VERIFICATION CHECKS =================
      function runVerification() {
        if (!validationList) return;
        const warnings: { type: 'ok' | 'warn'; msg: string }[] = [];

        // Check 1: Safe Zone (Android 66% circular mask = 676px radius 338px)
        const radius = 338;
        const currentScale = state.fgScale;
        const offsetDist = Math.sqrt(state.fgX * state.fgX + state.fgY * state.fgY);
        if (currentScale > 72 || offsetDist > 120) {
          warnings.push({
            type: 'warn',
            msg: 'Artwork extends outside the 66% adaptive safe zone. It may be partially clipped by circular or squircle launcher masks.'
          });
        } else {
          warnings.push({
            type: 'ok',
            msg: 'Safe zone: Foreground sits safely within the 66% Android Adaptive boundary.'
          });
        }

        // Check 2: Background Transparency
        if (state.bgType === 'transparent' || !state.bgVisible) {
          warnings.push({
            type: 'warn',
            msg: 'Transparent background: Standard Android and iOS app icons require an opaque background. Apple & Google Play will reject transparent master icons.'
          });
        } else {
          warnings.push({
            type: 'ok',
            msg: 'Background opacity: Solid background meets app store submission criteria.'
          });
        }

        // Check 3: Scale too small
        if (state.fgScale < 25) {
          warnings.push({
            type: 'warn',
            msg: 'Foreground logo is very small (< 25% scale). It may become illegible on small notification or settings screens.'
          });
        }

        // Check 4: Source Resolution
        if (state.sourceMode === 'upload' && state.uploadedDims.w > 0) {
          if (state.uploadedDims.w < 1024 || state.uploadedDims.h < 1024) {
            warnings.push({
              type: 'warn',
              msg: `Uploaded artwork is ${state.uploadedDims.w}×${state.uploadedDims.h}. For maximum sharpness, use at least 1024×1024.`
            });
          }
        }

        // Render HTML
        validationList.innerHTML = warnings.map(w => `
          <div class="flex items-start gap-2 p-2 rounded-lg ${w.type === 'warn' ? 'bg-amber-500/10 border border-amber-500/20 text-amber-300' : 'bg-emerald-500/10 border border-emerald-500/20 text-emerald-300'}">
            <span class="font-bold shrink-0">${w.type === 'warn' ? '⚠' : '✓'}</span>
            <span class="text-[11px] leading-tight">${w.msg}</span>
          </div>
        `).join('');

        const hasWarn = warnings.some(w => w.type === 'warn');
        if (badgeAllClear) {
          if (hasWarn) {
            badgeAllClear.textContent = '⚠ Review Warnings';
            badgeAllClear.className = 'text-[10px] text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/30';
          } else {
            badgeAllClear.textContent = '✓ All Checks Passing';
            badgeAllClear.className = 'text-[10px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/30';
          }
        }
      }

      // ================= LOCAL STORAGE PERSISTENCE =================
      function saveState() {
        try {
          const serialized = {
            sourceMode: state.sourceMode,
            creatorSubmode: state.creatorSubmode,
            selectedIconId: state.selectedIcon?.id,
            letterText: state.letterText,
            letterFont: state.letterFont,
            letterWeight: state.letterWeight,
            letterColor: state.letterColor,
            shapeType: state.shapeType,
            shapeFill: state.shapeFill,
            shapeStroke: state.shapeStroke,
            bgType: state.bgType,
            bgSolid: state.bgSolid,
            bgGrad1: state.bgGrad1,
            bgGrad2: state.bgGrad2,
            bgGradAngle: state.bgGradAngle,
            fgScale: state.fgScale,
            fgRotate: state.fgRotate,
            fgX: state.fgX,
            fgY: state.fgY,
            fgOpacity: state.fgOpacity,
            fgTintEnabled: state.fgTintEnabled,
            fgTintColor: state.fgTintColor
          };
          localStorage.setItem('app_icon_state', JSON.stringify(serialized));
        } catch (e) {
          // ignore quota issues
        }
      }

      function loadSavedState() {
        try {
          const raw = localStorage.getItem('app_icon_state');
          if (raw) {
            const data = JSON.parse(raw);
            if (data.sourceMode) state.sourceMode = data.sourceMode;
            if (data.creatorSubmode) state.creatorSubmode = data.creatorSubmode;
            if (data.selectedIconId) {
              const f = ICON_LIBRARY.find(i => i.id === data.selectedIconId);
              if (f) state.selectedIcon = f;
            }
            if (data.letterText) state.letterText = data.letterText;
            if (data.shapeType) state.shapeType = data.shapeType;
            if (data.shapeFill) state.shapeFill = data.shapeFill;
            if (data.bgType) state.bgType = data.bgType;
            if (data.bgSolid) state.bgSolid = data.bgSolid;
            if (data.bgGrad1) state.bgGrad1 = data.bgGrad1;
            if (data.bgGrad2) state.bgGrad2 = data.bgGrad2;
            if (data.bgGradAngle) state.bgGradAngle = data.bgGradAngle;
            if (data.fgScale) state.fgScale = data.fgScale;
            if (data.fgRotate) state.fgRotate = data.fgRotate;
            if (data.fgX) state.fgX = data.fgX;
            if (data.fgY) state.fgY = data.fgY;
            if (data.fgOpacity) state.fgOpacity = data.fgOpacity;
            if (data.fgTintEnabled !== undefined) state.fgTintEnabled = data.fgTintEnabled;
            if (data.fgTintColor) state.fgTintColor = data.fgTintColor;
          }
        } catch (e) {
          // ignore
        }
      }

      // Check for incoming shared artwork or color from Color Studio or SVG Studio
      function checkSharedPayloads() {
        try {
          const raw = localStorage.getItem('app_icon_shared_artwork');
          if (raw) {
            const parsed = JSON.parse(raw);
            if (parsed.color) {
              state.bgSolid = parsed.color;
              state.bgType = 'solid';
              showSharedToast(`Applied color ${parsed.color} from Color Studio.`);
            } else if (parsed.svg) {
              loadSvgString(parsed.svg, 'Imported SVG from SVG Studio');
              showSharedToast('Loaded SVG from SVG Studio into foreground canvas.');
            }
            localStorage.removeItem('app_icon_shared_artwork');
          }
        } catch (e) {
          // ignore
        }
      }

      function showSharedToast(msg: string) {
        if (sharedNotice && sharedNoticeText) {
          sharedNoticeText.textContent = msg;
          sharedNotice.classList.remove('hidden');
        }
      }

      // Load SVG String onto Image
      function loadSvgString(svgText: string, label: string) {
        const blob = new Blob([svgText], { type: 'image/svg+xml;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const img = new Image();
        img.onload = () => {
          state.uploadedImage = img;
          state.sourceMode = 'upload';
          state.uploadedFilename = label;
          state.uploadedDims = { w: img.width || 1024, h: img.height || 1024 };

          // Update UI
          updateUploadMeta(label, img.width || 1024, img.height || 1024);
          switchSourceMode('upload');
          renderAll();
        };
        img.src = url;
      }

      function updateUploadMeta(name: string, w: number, h: number) {
        const bar = document.getElementById('upload-meta-bar');
        const fName = document.getElementById('upload-file-name');
        const fDims = document.getElementById('upload-file-dims');
        const lowRes = document.getElementById('low-res-warn');
        const lowResMsg = document.getElementById('low-res-warn-msg');

        if (bar && fName && fDims) {
          bar.classList.remove('hidden');
          fName.textContent = name;
          fDims.textContent = `${w}×${h}`;
        }
        if (lowRes && lowResMsg) {
          if (w < 1024 || h < 1024) {
            lowRes.classList.remove('hidden');
            lowResMsg.textContent = `Your source image is ${w} × ${h}. For crisp icons across all densities, use artwork at least 1024 × 1024.`;
          } else {
            lowRes.classList.add('hidden');
          }
        }
      }

      // ================= EXPORT PACKAGING (JSZIP ENGINE) =================
      async function generateZip(type: 'all' | 'android' | 'ios' | 'master') {
        const zip = new JSZip();

        // 1. Android Asset Specification
        const androidSizes = [
          { folder: 'res/mipmap-mdpi', size: 48, name: 'ic_launcher.png' },
          { folder: 'res/mipmap-mdpi', size: 48, name: 'ic_launcher_round.png' },
          { folder: 'res/mipmap-hdpi', size: 72, name: 'ic_launcher.png' },
          { folder: 'res/mipmap-hdpi', size: 72, name: 'ic_launcher_round.png' },
          { folder: 'res/mipmap-xhdpi', size: 96, name: 'ic_launcher.png' },
          { folder: 'res/mipmap-xhdpi', size: 96, name: 'ic_launcher_round.png' },
          { folder: 'res/mipmap-xxhdpi', size: 144, name: 'ic_launcher.png' },
          { folder: 'res/mipmap-xxhdpi', size: 144, name: 'ic_launcher_round.png' },
          { folder: 'res/mipmap-xxxhdpi', size: 192, name: 'ic_launcher.png' },
          { folder: 'res/mipmap-xxxhdpi', size: 192, name: 'ic_launcher_round.png' },
          // Adaptive layers (432x432 for xxxhdpi)
          { folder: 'res/mipmap-xxxhdpi', size: 432, name: 'ic_launcher_foreground.png', onlyFg: true },
          { folder: 'res/mipmap-xxxhdpi', size: 432, name: 'ic_launcher_background.png', skipBg: false, onlyBg: true }
        ];

        // 2. iOS Asset Specification
        const iosSizes = [
          { size: 40, filename: 'icon-20@2x.png', idiom: 'iphone', scale: '2x', expected: '20x20' },
          { size: 60, filename: 'icon-20@3x.png', idiom: 'iphone', scale: '3x', expected: '20x20' },
          { size: 58, filename: 'icon-29@2x.png', idiom: 'iphone', scale: '2x', expected: '29x29' },
          { size: 87, filename: 'icon-29@3x.png', idiom: 'iphone', scale: '3x', expected: '29x29' },
          { size: 80, filename: 'icon-40@2x.png', idiom: 'iphone', scale: '2x', expected: '40x40' },
          { size: 120, filename: 'icon-40@3x.png', idiom: 'iphone', scale: '3x', expected: '40x40' },
          { size: 120, filename: 'icon-60@2x.png', idiom: 'iphone', scale: '2x', expected: '60x60' },
          { size: 180, filename: 'icon-60@3x.png', idiom: 'iphone', scale: '3x', expected: '60x60' },
          { size: 20, filename: 'icon-20@1x-ipad.png', idiom: 'ipad', scale: '1x', expected: '20x20' },
          { size: 29, filename: 'icon-29@1x-ipad.png', idiom: 'ipad', scale: '1x', expected: '29x29' },
          { size: 40, filename: 'icon-40@1x-ipad.png', idiom: 'ipad', scale: '1x', expected: '40x40' },
          { size: 76, filename: 'icon-76@1x.png', idiom: 'ipad', scale: '1x', expected: '76x76' },
          { size: 152, filename: 'icon-76@2x.png', idiom: 'ipad', scale: '2x', expected: '76x76' },
          { size: 167, filename: 'icon-83.5@2x.png', idiom: 'ipad', scale: '2x', expected: '83.5x83.5' },
          { size: 1024, filename: 'icon-1024.png', idiom: 'ios-marketing', scale: '1x', expected: '1024x1024' }
        ];

        // Helper: Convert canvas to Blob
        function canvasToBlob(cv: HTMLCanvasElement): Promise<Blob> {
          return new Promise((res) => cv.toBlob((b) => res(b || new Blob()), 'image/png'));
        }

        // Add Android assets
        if (type === 'all' || type === 'android') {
          const androidBase = type === 'all' ? 'app-icons/android/' : '';
          
          for (const item of androidSizes) {
            const mask = item.name.includes('_round') ? 'circle' : 'none';
            const cv = renderOffscreen(item.size, {
              mask: mask as any,
              onlyFg: (item as any).onlyFg,
              skipBg: (item as any).onlyFg
            });
            const blob = await canvasToBlob(cv);
            zip.file(`${androidBase}${item.folder}/${item.name}`, blob);
          }

          // XML Adaptive Icon Files
          const icLauncherXml = `<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>`;

          const icLauncherRoundXml = `<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>`;

          const icBackgroundValuesXml = `<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">${state.bgSolid}</color>
</resources>`;

          zip.file(`${androidBase}res/mipmap-anydpi-v26/ic_launcher.xml`, icLauncherXml);
          zip.file(`${androidBase}res/mipmap-anydpi-v26/ic_launcher_round.xml`, icLauncherRoundXml);
          zip.file(`${androidBase}res/values/ic_launcher_background.xml`, icBackgroundValuesXml);
        }

        // Add iOS Assets
        if (type === 'all' || type === 'ios') {
          const iosBase = type === 'all' ? 'app-icons/ios/AppIcon.appiconset/' : 'AppIcon.appiconset/';
          
          // Contents.json
          const contentsJson = {
            images: iosSizes.map(s => ({
              size: s.expected,
              idiom: s.idiom,
              filename: s.filename,
              scale: s.scale
            })),
            info: {
              version: 1,
              author: 'xcode'
            }
          };

          zip.file(`${iosBase}Contents.json`, JSON.stringify(contentsJson, null, 2));

          for (const item of iosSizes) {
            // Note: Apple Xcode requires unmasked square icons with opaque backgrounds
            const cv = renderOffscreen(item.size, { mask: 'none' });
            const blob = await canvasToBlob(cv);
            zip.file(`${iosBase}${item.filename}`, blob);
          }
        }

        // Add Master / Store Assets
        if (type === 'all' || type === 'master') {
          const masterBase = type === 'all' ? 'app-icons/master/' : '';
          
          // 1024 Master
          const master1024 = renderOffscreen(1024, { mask: 'none' });
          zip.file(`${masterBase}master-1024x1024.png`, await canvasToBlob(master1024));

          // 512 Google Play Store
          const store512 = renderOffscreen(512, { mask: 'none' });
          zip.file(`${masterBase}playstore-512x512.png`, await canvasToBlob(store512));

          // 1024 Apple App Store
          const store1024 = renderOffscreen(1024, { mask: 'none' });
          zip.file(`${masterBase}appstore-1024x1024.png`, await canvasToBlob(store1024));
        }

        // Download ZIP
        const zipName = type === 'android'
          ? 'android-app-icons.zip'
          : type === 'ios'
            ? 'ios-app-icons.zip'
            : 'app-icons.zip';

        const content = await zip.generateAsync({ type: 'blob' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(content);
        a.download = zipName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(a.href);
      }

      // Download single PNG
      function downloadSingleImage(size: number, filename: string) {
        const cv = renderOffscreen(size, { mask: 'none' });
        cv.toBlob((blob) => {
          if (!blob) return;
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(a.href);
        }, 'image/png');
      }

      // ================= UI SWITCHERS & CONTROLS =================
      function switchSourceMode(mode: 'upload' | 'creator') {
        state.sourceMode = mode;
        const btnUpload = document.getElementById('tab-src-upload');
        const btnCreator = document.getElementById('tab-src-creator');
        const secUpload = document.getElementById('section-upload');
        const secCreator = document.getElementById('section-creator');

        if (mode === 'upload') {
          btnUpload?.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          btnUpload?.classList.remove('text-[var(--color-text-muted)]');
          btnCreator?.classList.remove('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          btnCreator?.classList.add('text-[var(--color-text-muted)]');

          secUpload?.classList.remove('hidden');
          secCreator?.classList.add('hidden');
        } else {
          btnCreator?.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          btnCreator?.classList.remove('text-[var(--color-text-muted)]');
          btnUpload?.classList.remove('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          btnUpload?.classList.add('text-[var(--color-text-muted)]');

          secCreator?.classList.remove('hidden');
          secUpload?.classList.add('hidden');
        }
      }

      function switchCreatorSubmode(submode: 'icon' | 'letter' | 'shape') {
        state.creatorSubmode = submode;
        const bIcon = document.getElementById('subtab-icon');
        const bLetter = document.getElementById('subtab-letter');
        const bShape = document.getElementById('subtab-shape');

        const pIcon = document.getElementById('creator-icon-panel');
        const pLetter = document.getElementById('creator-letter-panel');
        const pShape = document.getElementById('creator-shape-panel');

        [bIcon, bLetter, bShape].forEach(b => {
          b?.classList.remove('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          b?.classList.add('text-[var(--color-text-muted)]');
        });
        [pIcon, pLetter, pShape].forEach(p => p?.classList.add('hidden'));

        if (submode === 'icon') {
          bIcon?.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          bIcon?.classList.remove('text-[var(--color-text-muted)]');
          pIcon?.classList.remove('hidden');
        } else if (submode === 'letter') {
          bLetter?.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          bLetter?.classList.remove('text-[var(--color-text-muted)]');
          pLetter?.classList.remove('hidden');
        } else {
          bShape?.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          bShape?.classList.remove('text-[var(--color-text-muted)]');
          pShape?.classList.remove('hidden');
        }
        renderAll();
      }

      function switchBgType(type: 'solid' | 'linear' | 'radial' | 'transparent') {
        state.bgType = type;
        const bSolid = document.getElementById('bg-type-solid');
        const bLinear = document.getElementById('bg-type-linear');
        const bRadial = document.getElementById('bg-type-radial');
        const bTrans = document.getElementById('bg-type-transparent');

        const secSolid = document.getElementById('bg-solid-controls');
        const secGrad = document.getElementById('bg-grad-controls');
        const angleRow = document.getElementById('grad-angle-row');

        [bSolid, bLinear, bRadial, bTrans].forEach(b => {
          b?.classList.remove('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          b?.classList.add('text-[var(--color-text-muted)]');
        });

        if (type === 'solid') {
          bSolid?.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          bSolid?.classList.remove('text-[var(--color-text-muted)]');
          secSolid?.classList.remove('hidden');
          secGrad?.classList.add('hidden');
        } else if (type === 'linear') {
          bLinear?.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          bLinear?.classList.remove('text-[var(--color-text-muted)]');
          secSolid?.classList.add('hidden');
          secGrad?.classList.remove('hidden');
          angleRow?.classList.remove('hidden');
        } else if (type === 'radial') {
          bRadial?.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          bRadial?.classList.remove('text-[var(--color-text-muted)]');
          secSolid?.classList.add('hidden');
          secGrad?.classList.remove('hidden');
          angleRow?.classList.add('hidden');
        } else {
          bTrans?.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          bTrans?.classList.remove('text-[var(--color-text-muted)]');
          secSolid?.classList.add('hidden');
          secGrad?.classList.add('hidden');
        }

        renderAll();
      }

      function populateIconGrid() {
        const grid = document.getElementById('icon-grid');
        if (!grid) return;

        const cat = (document.getElementById('icon-category-select') as HTMLSelectElement)?.value || 'all';
        const query = ((document.getElementById('icon-search-input') as HTMLInputElement)?.value || '').toLowerCase().trim();

        const filtered = ICON_LIBRARY.filter(i => {
          if (cat !== 'all' && i.category !== cat) return false;
          if (query && !i.name.toLowerCase().includes(query) && !i.category.toLowerCase().includes(query)) return false;
          return true;
        });

        grid.innerHTML = filtered.map(item => `
          <button
            type="button"
            class="btn-pick-icon p-2 rounded-lg border ${state.selectedIcon?.id === item.id ? 'border-[var(--accent)] bg-[rgba(var(--accent-rgb),0.15)] text-[var(--accent)]' : 'border-[var(--color-border)] bg-[var(--color-card)] text-[var(--color-text-secondary)] hover:text-foreground hover:border-[var(--accent)]'} flex flex-col items-center justify-center transition-all group"
            data-id="${item.id}"
            title="${item.name} (${item.category})"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none group-hover:scale-110 transition-transform">
              <path d="${item.path}" />
            </svg>
          </button>
        `).join('');

        // Attach clicks
        grid.querySelectorAll('.btn-pick-icon').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
            const found = ICON_LIBRARY.find(i => i.id === id);
            if (found) {
              state.selectedIcon = found;
              const lbl = document.getElementById('icon-status-label');
              if (lbl) lbl.textContent = `Selected: ${found.name} (${found.category})`;
              populateIconGrid();
              renderAll();
            }
          });
        });
      }

      // ================= ATTACH EVENT LISTENERS =================
      function initAppIconCreator() {
        loadSavedState();
        checkSharedPayloads();

        // 1. Source tabs
        document.getElementById('tab-src-upload')?.addEventListener('click', () => switchSourceMode('upload'));
        document.getElementById('tab-src-creator')?.addEventListener('click', () => switchSourceMode('creator'));

        // 2. Creator sub-tabs
        document.getElementById('subtab-icon')?.addEventListener('click', () => switchCreatorSubmode('icon'));
        document.getElementById('subtab-letter')?.addEventListener('click', () => switchCreatorSubmode('letter'));
        document.getElementById('subtab-shape')?.addEventListener('click', () => switchCreatorSubmode('shape'));

        // 3. File upload & Drag/Drop
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('file-input') as HTMLInputElement;

        dropZone?.addEventListener('click', () => fileInput?.click());
        dropZone?.addEventListener('dragover', (e) => {
          e.preventDefault();
          dropZone.classList.add('border-[var(--accent)]', 'bg-[rgba(var(--accent-rgb),0.08)]');
        });
        dropZone?.addEventListener('dragleave', () => {
          dropZone.classList.remove('border-[var(--accent)]', 'bg-[rgba(var(--accent-rgb),0.08)]');
        });
        dropZone?.addEventListener('drop', (e) => {
          e.preventDefault();
          dropZone.classList.remove('border-[var(--accent)]', 'bg-[rgba(var(--accent-rgb),0.08)]');
          if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
            handleFile(e.dataTransfer.files[0]);
          }
        });

        fileInput?.addEventListener('change', () => {
          if (fileInput.files && fileInput.files[0]) {
            handleFile(fileInput.files[0]);
          }
        });

        function handleFile(file: File) {
          if (file.type === 'image/svg+xml' || file.name.endsWith('.svg')) {
            const reader = new FileReader();
            reader.onload = (e) => {
              const svgText = e.target?.result as string;
              loadSvgString(svgText, file.name);
            };
            reader.readAsText(file);
          } else {
            const reader = new FileReader();
            reader.onload = (e) => {
              const img = new Image();
              img.onload = () => {
                state.uploadedImage = img;
                state.sourceMode = 'upload';
                state.uploadedFilename = file.name;
                state.uploadedDims = { w: img.width, h: img.height };
                updateUploadMeta(file.name, img.width, img.height);
                switchSourceMode('upload');
                renderAll();
              };
              img.src = e.target?.result as string;
            };
            reader.readAsDataURL(file);
          }
        }

        document.getElementById('btn-remove-upload')?.addEventListener('click', () => {
          state.uploadedImage = null;
          state.uploadedDims = { w: 0, h: 0 };
          document.getElementById('upload-meta-bar')?.classList.add('hidden');
          document.getElementById('low-res-warn')?.classList.add('hidden');
          switchSourceMode('creator');
          renderAll();
        });

        // 4. Icon Search & Category
        document.getElementById('icon-category-select')?.addEventListener('change', populateIconGrid);
        document.getElementById('icon-search-input')?.addEventListener('input', populateIconGrid);
        populateIconGrid();

        // 5. Letter Logo inputs
        const letterInput = document.getElementById('letter-text') as HTMLInputElement;
        letterInput?.addEventListener('input', (e) => {
          state.letterText = (e.target as HTMLInputElement).value || '';
          renderAll();
        });
        document.getElementById('letter-font')?.addEventListener('change', (e) => {
          state.letterFont = (e.target as HTMLSelectElement).value;
          renderAll();
        });
        document.getElementById('letter-weight')?.addEventListener('change', (e) => {
          state.letterWeight = (e.target as HTMLSelectElement).value;
          renderAll();
        });
        document.getElementById('letter-color')?.addEventListener('input', (e) => {
          state.letterColor = (e.target as HTMLInputElement).value;
          const hex = document.getElementById('letter-color-hex') as HTMLInputElement;
          if (hex) hex.value = state.letterColor.toUpperCase();
          renderAll();
        });
        document.getElementById('letter-color-hex')?.addEventListener('change', (e) => {
          state.letterColor = (e.target as HTMLInputElement).value;
          renderAll();
        });
        document.getElementById('letter-align')?.addEventListener('change', (e) => {
          state.letterAlign = (e.target as HTMLSelectElement).value;
          renderAll();
        });

        // 6. Shapes inputs
        document.querySelectorAll('.btn-shape-select').forEach(btn => {
          btn.addEventListener('click', (e) => {
            document.querySelectorAll('.btn-shape-select').forEach(b => b.classList.remove('sw-tool-btn-primary'));
            (e.currentTarget as HTMLElement).classList.add('sw-tool-btn-primary');
            state.shapeType = (e.currentTarget as HTMLElement).getAttribute('data-shape') || 'circle';
            renderAll();
          });
        });

        document.getElementById('shape-fill-color')?.addEventListener('input', (e) => {
          state.shapeFill = (e.target as HTMLInputElement).value;
          const hex = document.getElementById('shape-fill-hex') as HTMLInputElement;
          if (hex) hex.value = state.shapeFill.toUpperCase();
          renderAll();
        });
        document.getElementById('shape-stroke-color')?.addEventListener('input', (e) => {
          state.shapeStroke = (e.target as HTMLInputElement).value;
          renderAll();
        });
        document.getElementById('shape-stroke-width')?.addEventListener('input', (e) => {
          state.shapeStrokeWidth = parseInt((e.target as HTMLInputElement).value, 10);
          renderAll();
        });

        // 7. Background Types & Controls
        document.getElementById('bg-type-solid')?.addEventListener('click', () => switchBgType('solid'));
        document.getElementById('bg-type-linear')?.addEventListener('click', () => switchBgType('linear'));
        document.getElementById('bg-type-radial')?.addEventListener('click', () => switchBgType('radial'));
        document.getElementById('bg-type-transparent')?.addEventListener('click', () => switchBgType('transparent'));

        document.getElementById('bg-solid-color')?.addEventListener('input', (e) => {
          state.bgSolid = (e.target as HTMLInputElement).value;
          const hex = document.getElementById('bg-solid-hex') as HTMLInputElement;
          if (hex) hex.value = state.bgSolid.toUpperCase();
          renderAll();
        });
        document.getElementById('bg-solid-hex')?.addEventListener('change', (e) => {
          state.bgSolid = (e.target as HTMLInputElement).value;
          renderAll();
        });

        document.querySelectorAll('.preset-color').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const col = (e.currentTarget as HTMLElement).getAttribute('data-color') || '#1B5448';
            state.bgSolid = col;
            const picker = document.getElementById('bg-solid-color') as HTMLInputElement;
            const hex = document.getElementById('bg-solid-hex') as HTMLInputElement;
            if (picker) picker.value = col;
            if (hex) hex.value = col.toUpperCase();
            renderAll();
          });
        });

        document.getElementById('bg-grad-color1')?.addEventListener('input', (e) => {
          state.bgGrad1 = (e.target as HTMLInputElement).value;
          const hex = document.getElementById('bg-grad-hex1') as HTMLInputElement;
          if (hex) hex.value = state.bgGrad1.toUpperCase();
          renderAll();
        });
        document.getElementById('bg-grad-color2')?.addEventListener('input', (e) => {
          state.bgGrad2 = (e.target as HTMLInputElement).value;
          const hex = document.getElementById('bg-grad-hex2') as HTMLInputElement;
          if (hex) hex.value = state.bgGrad2.toUpperCase();
          renderAll();
        });
        document.getElementById('bg-grad-angle')?.addEventListener('input', (e) => {
          state.bgGradAngle = parseInt((e.target as HTMLInputElement).value, 10);
          const lbl = document.getElementById('grad-angle-val');
          if (lbl) lbl.textContent = `${state.bgGradAngle}°`;
          renderAll();
        });

        document.querySelectorAll('.btn-grad-preset').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLElement;
            state.bgGrad1 = target.getAttribute('data-c1') || '#1B5448';
            state.bgGrad2 = target.getAttribute('data-c2') || '#ADE1CD';
            state.bgGradAngle = parseInt(target.getAttribute('data-angle') || '135', 10);

            const c1 = document.getElementById('bg-grad-color1') as HTMLInputElement;
            const c2 = document.getElementById('bg-grad-color2') as HTMLInputElement;
            const h1 = document.getElementById('bg-grad-hex1') as HTMLInputElement;
            const h2 = document.getElementById('bg-grad-hex2') as HTMLInputElement;
            const a = document.getElementById('bg-grad-angle') as HTMLInputElement;
            const lbl = document.getElementById('grad-angle-val');

            if (c1) c1.value = state.bgGrad1;
            if (c2) c2.value = state.bgGrad2;
            if (h1) h1.value = state.bgGrad1.toUpperCase();
            if (h2) h2.value = state.bgGrad2.toUpperCase();
            if (a) a.value = state.bgGradAngle.toString();
            if (lbl) lbl.textContent = `${state.bgGradAngle}°`;

            renderAll();
          });
        });

        document.getElementById('btn-toggle-bg-visible')?.addEventListener('click', (e) => {
          state.bgVisible = !state.bgVisible;
          (e.currentTarget as HTMLElement).textContent = state.bgVisible ? '👁️ Visible' : '🚫 Hidden';
          renderAll();
        });

        // 8. Sliders (Scale, Rotate, Offset, Opacity)
        fgScale?.addEventListener('input', (e) => {
          state.fgScale = parseInt((e.target as HTMLInputElement).value, 10);
          if (fgScaleVal) fgScaleVal.textContent = `${state.fgScale}%`;
          renderAll();
        });
        fgRotate?.addEventListener('input', (e) => {
          state.fgRotate = parseInt((e.target as HTMLInputElement).value, 10);
          if (fgRotateVal) fgRotateVal.textContent = `${state.fgRotate}°`;
          renderAll();
        });
        fgX?.addEventListener('input', (e) => {
          state.fgX = parseInt((e.target as HTMLInputElement).value, 10);
          if (fgXVal) fgXVal.textContent = `${state.fgX}px`;
          renderAll();
        });
        fgY?.addEventListener('input', (e) => {
          state.fgY = parseInt((e.target as HTMLInputElement).value, 10);
          if (fgYVal) fgYVal.textContent = `${state.fgY}px`;
          renderAll();
        });
        fgOpacity?.addEventListener('input', (e) => {
          state.fgOpacity = parseInt((e.target as HTMLInputElement).value, 10);
          if (fgOpacityVal) fgOpacityVal.textContent = `${state.fgOpacity}%`;
          renderAll();
        });

        // Transform helpers
        document.getElementById('btn-fg-center')?.addEventListener('click', () => {
          state.fgX = 0;
          state.fgY = 0;
          if (fgX) fgX.value = '0';
          if (fgY) fgY.value = '0';
          if (fgXVal) fgXVal.textContent = '0px';
          if (fgYVal) fgYVal.textContent = '0px';
          renderAll();
        });

        document.getElementById('btn-fg-fit')?.addEventListener('click', () => {
          state.fgScale = 65; // standard 65-66% adaptive safe zone fit
          state.fgX = 0;
          state.fgY = 0;
          state.fgRotate = 0;
          if (fgScale) fgScale.value = '65';
          if (fgScaleVal) fgScaleVal.textContent = '65%';
          if (fgRotate) fgRotate.value = '0';
          if (fgRotateVal) fgRotateVal.textContent = '0°';
          if (fgX) fgX.value = '0';
          if (fgY) fgY.value = '0';
          if (fgXVal) fgXVal.textContent = '0px';
          if (fgYVal) fgYVal.textContent = '0px';
          renderAll();
        });

        document.getElementById('btn-fg-reset')?.addEventListener('click', () => {
          state.fgScale = 65;
          state.fgRotate = 0;
          state.fgX = 0;
          state.fgY = 0;
          state.fgOpacity = 100;
          if (fgScale) fgScale.value = '65';
          if (fgRotate) fgRotate.value = '0';
          if (fgX) fgX.value = '0';
          if (fgY) fgY.value = '0';
          if (fgOpacity) fgOpacity.value = '100';
          if (fgScaleVal) fgScaleVal.textContent = '65%';
          if (fgRotateVal) fgRotateVal.textContent = '0°';
          if (fgXVal) fgXVal.textContent = '0px';
          if (fgYVal) fgYVal.textContent = '0px';
          if (fgOpacityVal) fgOpacityVal.textContent = '100%';
          renderAll();
        });

        // Tint toggle
        document.getElementById('btn-toggle-fg-tint')?.addEventListener('click', (e) => {
          state.fgTintEnabled = !state.fgTintEnabled;
          const box = document.getElementById('fg-tint-box');
          if (box) {
            box.classList.toggle('opacity-50', !state.fgTintEnabled);
            box.classList.toggle('pointer-events-none', !state.fgTintEnabled);
          }
          (e.currentTarget as HTMLElement).textContent = state.fgTintEnabled ? 'Disable Tint' : 'Enable Tint';
          renderAll();
        });

        document.getElementById('fg-tint-color')?.addEventListener('input', (e) => {
          state.fgTintColor = (e.target as HTMLInputElement).value;
          const hex = document.getElementById('fg-tint-hex') as HTMLInputElement;
          if (hex) hex.value = state.fgTintColor.toUpperCase();
          renderAll();
        });

        // 9. Overlay toggles
        document.getElementById('chk-guide-safezone')?.addEventListener('change', (e) => {
          state.showSafeZone = (e.target as HTMLInputElement).checked;
          overlaySafeZone?.classList.toggle('hidden', !state.showSafeZone);
        });
        document.getElementById('chk-guide-grid')?.addEventListener('change', (e) => {
          state.showGrid = (e.target as HTMLInputElement).checked;
          overlayGrid?.classList.toggle('hidden', !state.showGrid);
        });
        document.getElementById('chk-guide-center')?.addEventListener('change', (e) => {
          state.showCenterGuides = (e.target as HTMLInputElement).checked;
          overlayCenter?.classList.toggle('hidden', !state.showCenterGuides);
        });

        // 10. Canvas Mask Buttons
        document.querySelectorAll('.btn-canvas-mask').forEach(btn => {
          btn.addEventListener('click', (e) => {
            document.querySelectorAll('.btn-canvas-mask').forEach(b => b.classList.remove('sw-tool-btn-primary'));
            (e.currentTarget as HTMLElement).classList.add('sw-tool-btn-primary');
            state.canvasMask = (e.currentTarget as HTMLElement).getAttribute('data-mask') || 'none';
            renderAll();
          });
        });

        // 11. Canvas Direct Dragging
        canvasWrapper?.addEventListener('mousedown', (e) => {
          isDragging = true;
          dragStartX = e.clientX;
          dragStartY = e.clientY;
          initialFgX = state.fgX;
          initialFgY = state.fgY;
        });

        window.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
          const dx = e.clientX - dragStartX;
          const dy = e.clientY - dragStartY;
          // Canvas wrapper is ~320px wide representing 1024px
          const scaleFactor = 1024 / (canvasWrapper?.clientWidth || 320);
          state.fgX = Math.round(initialFgX + dx * scaleFactor);
          state.fgY = Math.round(initialFgY + dy * scaleFactor);

          if (fgX) fgX.value = state.fgX.toString();
          if (fgY) fgY.value = state.fgY.toString();
          if (fgXVal) fgXVal.textContent = `${state.fgX}px`;
          if (fgYVal) fgYVal.textContent = `${state.fgY}px`;
          renderAll();
        });

        window.addEventListener('mouseup', () => {
          isDragging = false;
        });

        // 12. Preview Tabs Switcher (Android / iOS / Store)
        const tabPAndroid = document.getElementById('tab-preview-android');
        const tabPIos = document.getElementById('tab-preview-ios');
        const tabPStore = document.getElementById('tab-preview-store');

        const secPAndroid = document.getElementById('preview-android-container');
        const secPIos = document.getElementById('preview-ios-container');
        const secPStore = document.getElementById('preview-store-container');

        tabPAndroid?.addEventListener('click', () => {
          [tabPAndroid, tabPIos, tabPStore].forEach(t => t?.classList.remove('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs'));
          tabPAndroid.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          secPAndroid?.classList.remove('hidden');
          secPIos?.classList.add('hidden');
          secPStore?.classList.add('hidden');
        });

        tabPIos?.addEventListener('click', () => {
          [tabPAndroid, tabPIos, tabPStore].forEach(t => t?.classList.remove('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs'));
          tabPIos.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          secPIos?.classList.remove('hidden');
          secPAndroid?.classList.add('hidden');
          secPStore?.classList.add('hidden');
        });

        tabPStore?.addEventListener('click', () => {
          [tabPAndroid, tabPIos, tabPStore].forEach(t => t?.classList.remove('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs'));
          tabPStore.classList.add('bg-[var(--color-card)]', 'text-foreground', 'font-semibold', 'shadow-xs');
          secPStore?.classList.remove('hidden');
          secPAndroid?.classList.add('hidden');
          secPIos?.classList.add('hidden');
        });

        // iOS Wallpaper switchers
        document.getElementById('btn-ios-wall-dark')?.addEventListener('click', () => {
          const wall = document.getElementById('ios-wall-bg');
          if (wall) wall.className = 'p-5 rounded-2xl bg-gradient-to-b from-indigo-950 via-slate-900 to-zinc-950 border border-white/10 space-y-5 transition-colors';
        });
        document.getElementById('btn-ios-wall-light')?.addEventListener('click', () => {
          const wall = document.getElementById('ios-wall-bg');
          if (wall) wall.className = 'p-5 rounded-2xl bg-gradient-to-b from-amber-100 via-rose-100 to-teal-100 border border-black/10 space-y-5 transition-colors';
        });

        // 13. Export CTA Buttons
        document.getElementById('btn-download-all')?.addEventListener('click', () => generateZip('all'));
        document.getElementById('btn-download-android')?.addEventListener('click', () => generateZip('android'));
        document.getElementById('btn-download-ios')?.addEventListener('click', () => generateZip('ios'));
        document.getElementById('btn-download-master')?.addEventListener('click', () => generateZip('master'));

        // Individual downloads
        document.querySelectorAll('.btn-single-dl').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const size = parseInt((e.currentTarget as HTMLElement).getAttribute('data-size') || '1024', 10);
            const name = (e.currentTarget as HTMLElement).getAttribute('data-name') || 'app-icon.png';
            downloadSingleImage(size, name);
          });
        });

        // Clear local data
        document.getElementById('btn-clear-local')?.addEventListener('click', () => {
          if (confirm('Reset all icon settings and artwork to default state?')) {
            localStorage.removeItem('app_icon_state');
            location.reload();
          }
        });

        btnDismissNotice?.addEventListener('click', () => {
          sharedNotice?.classList.add('hidden');
        });

        // Initial render
        renderAll();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAppIconCreator);
      } else {
        initAppIconCreator();
      }
    </script>
  </body>
</html>
