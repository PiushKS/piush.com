---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import GlowLineSeparator from '../../components/ui/separator/GlowLineSeparator.astro';

const pageTitle = "Android & iOS App Icon Generator Online | Piush";
const pageDescription = "Create Android and iOS app icons online. Generate launcher icons, adaptive icons and Xcode-ready icon assets from one design.";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <!-- Structured Data: WebApplication & BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebApplication',
          name: 'App Icon & Logo Creator',
          applicationCategory: 'DesignApplication',
          operatingSystem: 'All',
          browserRequirements: 'Requires JavaScript',
          url: new URL('/tools/app-icon', Astro.site || 'https://piush.com').toString(),
          description: pageDescription,
          offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site || 'https://piush.com').toString() },
            { '@type': 'ListItem', position: 2, name: 'Tools', item: new URL('/tools', Astro.site || 'https://piush.com').toString() },
            { '@type': 'ListItem', position: 3, name: 'App Icon Creator', item: new URL('/tools/app-icon', Astro.site || 'https://piush.com').toString() }
          ]
        }
      ]
    })} />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col font-sans">
    <Header />
    <main class="flex-1 w-full px-3 sm:px-6 lg:px-10 py-4 sm:py-6 space-y-6 max-w-[1680px] mx-auto">
      
      <!-- Top Navigation & Breadcrumbs -->
      <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--color-text-muted)] border-b border-[var(--color-border)] pb-3">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2">
          <a href="/" class="hover:text-[var(--accent)] transition-colors no-underline">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--accent)] transition-colors no-underline">Tools</a>
          <span>/</span>
          <span class="text-[var(--accent)] font-medium">App Icon Creator</span>
        </nav>
        <div class="flex items-center gap-3 font-mono text-[11px] text-[var(--color-text-secondary)]">
          <div class="flex items-center gap-1.5">
            <span class="inline-flex size-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
            <span>100% Client-Side • Zero Server Uploads</span>
          </div>
          <button id="btn-clear-local" type="button" class="text-[var(--color-text-muted)] hover:text-red-400 transition-colors text-[10px] underline ml-2" title="Reset all settings to defaults">
            Reset All
          </button>
        </div>
      </div>

      <!-- Header Title & Cross-Link -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
          <div class="flex items-center gap-2.5">
            <div class="size-9 rounded-xl flex items-center justify-center text-[var(--accent)] bg-[rgba(var(--accent-rgb),0.1)] border border-[rgba(var(--accent-rgb),0.2)]">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="4"/>
                <path d="M3 9h18"/>
                <path d="M9 21V9"/>
              </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight m-0">
              App Icon & Logo Creator
            </h1>
            <span class="text-[11px] font-mono font-medium px-2 py-0.5 rounded-full bg-[rgba(var(--accent-rgb),0.1)] text-[var(--accent)] border border-[rgba(var(--accent-rgb),0.2)]">
              Android + iOS
            </span>
          </div>
          <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1 m-0">
            Design master app icons, configure adaptive layers, simulate native device environments, and export complete Xcode & Android asset catalogs.
          </p>
        </div>

        <!-- Cross-link Callout to Color Studio -->
        <div class="flex items-center gap-2">
          <a
            href="/tools/colors"
            class="sw-tool-btn text-xs font-semibold text-[var(--accent)] border-[rgba(var(--accent-rgb),0.35)] hover:bg-[rgba(var(--accent-rgb),0.12)]"
            title="Open Color Studio to pick or generate palettes"
          >
            <span>Need the perfect color? Open Color Studio</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Notification Toast for Shared Artwork / Actions -->
      <div id="shared-notice" class="hidden p-3 rounded-xl border border-[rgba(var(--accent-rgb),0.3)] bg-[rgba(var(--accent-rgb),0.08)] flex items-center justify-between text-xs text-foreground animate-fadeIn">
        <div class="flex items-center gap-2">
          <span class="text-[var(--accent)] font-bold">✨</span>
          <span id="shared-notice-text">Imported artwork from session.</span>
        </div>
        <button id="btn-dismiss-notice" type="button" class="text-xs text-[var(--color-text-muted)] hover:text-foreground">✕</button>
      </div>

      <!-- MAIN STUDIO GRID: Controls (5 cols) & Live Preview / Validation / Export (7 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        
        <!-- ================= LEFT PANEL: ARTWORK & LAYER CONTROLS (5 cols) ================= -->
        <div class="lg:col-span-5 space-y-4">
          
          <!-- Source Artwork Mode Selector -->
          <div class="card-surface p-4 border border-[var(--color-border)] rounded-2xl space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-foreground flex items-center gap-1.5 uppercase tracking-wider">
                <span>🎨</span> 1. Source Artwork
              </span>
              <span class="text-[10px] font-mono text-[var(--accent)] bg-[rgba(var(--accent-rgb),0.1)] px-2 py-0.5 rounded border border-[rgba(var(--accent-rgb),0.2)]">
                1024 × 1024 Master
              </span>
            </div>

            <!-- Tabs: Upload vs Built-in Creator -->
            <div class="grid grid-cols-2 p-1 bg-[var(--color-bg-secondary)] border border-[var(--color-border)] rounded-xl gap-1 text-xs font-medium">
              <button id="tab-src-upload" type="button" class="py-1.5 px-3 rounded-lg bg-[var(--color-card)] text-foreground shadow-xs font-semibold transition-all">
                Upload Artwork
              </button>
              <button id="tab-src-creator" type="button" class="py-1.5 px-3 rounded-lg text-[var(--color-text-muted)] hover:text-foreground transition-all">
                Built-in Creator
              </button>
            </div>

            <!-- Upload Section -->
            <div id="section-upload" class="space-y-3">
              <div
                id="drop-zone"
                class="border-2 border-dashed border-[var(--color-border)] hover:border-[var(--accent)] rounded-xl p-5 text-center cursor-pointer transition-colors bg-[var(--color-bg-secondary)]/50 group"
              >
                <input type="file" id="file-input" accept=".png,.jpg,.jpeg,.webp,.svg,image/png,image/jpeg,image/webp,image/svg+xml" class="hidden" />
                <div class="flex flex-col items-center justify-center space-y-2 pointer-events-none">
                  <div class="size-10 rounded-full bg-[rgba(var(--accent-rgb),0.1)] text-[var(--accent)] flex items-center justify-center group-hover:scale-110 transition-transform">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                      <polyline points="17 8 12 3 7 8"/>
                      <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                  </div>
                  <div class="text-xs font-semibold text-foreground">
                    Drop PNG, SVG, WEBP, or JPG here
                  </div>
                  <div class="text-[11px] text-[var(--color-text-muted)]">
                    or click to browse from device (1024×1024+ recommended)
                  </div>
                </div>
              </div>

              <!-- Upload info / warning bar -->
              <div id="upload-meta-bar" class="hidden p-2.5 rounded-lg bg-[var(--color-bg-secondary)] border border-[var(--color-border)] flex items-center justify-between text-xs">
                <div class="flex items-center gap-2 truncate">
                  <span id="upload-file-icon" class="text-[var(--accent)] font-bold">📄</span>
                  <span id="upload-file-name" class="font-mono text-[11px] truncate max-w-[200px]">logo.png</span>
                  <span id="upload-file-dims" class="text-[10px] text-[var(--color-text-muted)] font-mono">1024×1024</span>
                </div>
                <button id="btn-remove-upload" type="button" class="text-[11px] text-red-400 hover:underline">Remove</button>
              </div>

              <!-- Low resolution warning if needed -->
              <div id="low-res-warn" class="hidden p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/25 text-[11px] text-amber-300 flex items-center gap-2">
                <span>⚠</span>
                <span id="low-res-warn-msg">Your source image is smaller than recommended. For crisp icons across all densities, use at least 1024×1024.</span>
              </div>
            </div>

            <!-- Built-in Creator Mode Controls -->
            <div id="section-creator" class="hidden space-y-3">
              <!-- Sub-tabs: Icon Library vs Letter Logo vs Shapes -->
              <div class="grid grid-cols-3 p-1 bg-[var(--color-bg-secondary)] border border-[var(--color-border)] rounded-lg gap-1 text-[11px] font-medium text-center">
                <button id="subtab-icon" type="button" class="py-1 px-2 rounded bg-[var(--color-card)] text-foreground font-semibold shadow-xs">
                  Icons (84)
                </button>
                <button id="subtab-letter" type="button" class="py-1 px-2 rounded text-[var(--color-text-muted)] hover:text-foreground">
                  Letter Logo
                </button>
                <button id="subtab-shape" type="button" class="py-1 px-2 rounded text-[var(--color-text-muted)] hover:text-foreground">
                  Shapes (9)
                </button>
              </div>

              <!-- 1. ICON LIBRARY -->
              <div id="creator-icon-panel" class="space-y-2.5">
                <div class="flex items-center gap-2">
                  <input
                    type="text"
                    id="icon-search-input"
                    placeholder="Search 84 icons (e.g., code, rocket, wallet, chart)..."
                    class="sw-tool-input text-xs w-full py-1.5"
                  />
                  <select id="icon-category-select" class="sw-tool-select text-[11px] py-1.5 w-36" aria-label="Icon Category">
                    <option value="all">All Categories</option>
                    <option value="technology">Technology</option>
                    <option value="business">Business</option>
                    <option value="education">Education</option>
                    <option value="finance">Finance</option>
                    <option value="health">Health</option>
                    <option value="travel">Travel</option>
                    <option value="food">Food</option>
                    <option value="music">Music</option>
                    <option value="photography">Photography</option>
                    <option value="shopping">Shopping</option>
                    <option value="sports">Sports</option>
                    <option value="social">Social</option>
                    <option value="tools">Tools</option>
                    <option value="games">Games</option>
                    <option value="weather">Weather</option>
                  </select>
                </div>

                <!-- Icon Grid Display -->
                <div id="icon-grid" class="grid grid-cols-6 sm:grid-cols-7 gap-1.5 max-h-48 overflow-y-auto p-1.5 bg-[var(--color-bg-secondary)] border border-[var(--color-border)] rounded-xl scrollbar-thin">
                  <!-- Injected via JavaScript -->
                </div>
                <div class="text-[10px] text-[var(--color-text-muted)] flex items-center justify-between">
                  <span id="icon-status-label">Selected: Sparkles (Games)</span>
                  <span>Click icon to select</span>
                </div>
              </div>

              <!-- 2. LETTER LOGO -->
              <div id="creator-letter-panel" class="hidden space-y-3">
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="text-[11px] text-[var(--color-text-muted)] block mb-1">Text / Initials</label>
                    <input type="text" id="letter-text" value="P" maxlength="4" class="sw-tool-input font-bold text-center text-sm py-1" />
                  </div>
                  <div>
                    <label class="text-[11px] text-[var(--color-text-muted)] block mb-1">Font Family</label>
                    <select id="letter-font" class="sw-tool-select text-xs py-1 w-full">
                      <option value="system-ui, -apple-system, sans-serif">Modern Sans</option>
                      <option value="monospace">Monospace Code</option>
                      <option value="serif">Classic Serif</option>
                      <option value="'Impact', 'Arial Black', sans-serif">Impact / Bold</option>
                    </select>
                  </div>
                </div>

                <div class="grid grid-cols-3 gap-2">
                  <div>
                    <label class="text-[11px] text-[var(--color-text-muted)] block mb-1">Font Weight</label>
                    <select id="letter-weight" class="sw-tool-select text-xs py-1 w-full">
                      <option value="400">Regular (400)</option>
                      <option value="600">SemiBold (600)</option>
                      <option value="700" selected>Bold (700)</option>
                      <option value="900">Black (900)</option>
                    </select>
                  </div>
                  <div>
                    <label class="text-[11px] text-[var(--color-text-muted)] block mb-1">Letter Color</label>
                    <div class="flex items-center gap-1.5">
                      <input type="color" id="letter-color" value="#ffffff" class="size-7 rounded cursor-pointer border border-[var(--color-border)] bg-transparent p-0" />
                      <input type="text" id="letter-color-hex" value="#FFFFFF" class="sw-tool-input text-[10px] font-mono py-1 px-1.5 w-full uppercase" />
                    </div>
                  </div>
                  <div>
                    <label class="text-[11px] text-[var(--color-text-muted)] block mb-1">Alignment</label>
                    <select id="letter-align" class="sw-tool-select text-xs py-1 w-full">
                      <option value="center" selected>Center</option>
                      <option value="top">Top</option>
                      <option value="bottom">Bottom</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- 3. SHAPE BUILDER -->
              <div id="creator-shape-panel" class="hidden space-y-3">
                <div>
                  <label class="text-[11px] text-[var(--color-text-muted)] block mb-1.5">Shape Geometry</label>
                  <div class="grid grid-cols-5 gap-1 text-[11px]">
                    <button type="button" class="btn-shape-select sw-tool-btn py-1 text-[10px] sw-tool-btn-primary" data-shape="circle">Circle</button>
                    <button type="button" class="btn-shape-select sw-tool-btn py-1 text-[10px]" data-shape="rounded-square">Squircle</button>
                    <button type="button" class="btn-shape-select sw-tool-btn py-1 text-[10px]" data-shape="square">Square</button>
                    <button type="button" class="btn-shape-select sw-tool-btn py-1 text-[10px]" data-shape="triangle">Triangle</button>
                    <button type="button" class="btn-shape-select sw-tool-btn py-1 text-[10px]" data-shape="diamond">Diamond</button>
                    <button type="button" class="btn-shape-select sw-tool-btn py-1 text-[10px]" data-shape="hexagon">Hexagon</button>
                    <button type="button" class="btn-shape-select sw-tool-btn py-1 text-[10px]" data-shape="star">Star</button>
                    <button type="button" class="btn-shape-select sw-tool-btn py-1 text-[10px]" data-shape="heart">Heart</button>
                    <button type="button" class="btn-shape-select sw-tool-btn py-1 text-[10px]" data-shape="blob">Blob</button>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="text-[11px] text-[var(--color-text-muted)] block mb-1">Shape Fill</label>
                    <div class="flex items-center gap-1.5">
                      <input type="color" id="shape-fill-color" value="#ade1cd" class="size-7 rounded cursor-pointer border border-[var(--color-border)] bg-transparent p-0" />
                      <input type="text" id="shape-fill-hex" value="#ADE1CD" class="sw-tool-input text-[10px] font-mono py-1 px-1.5 w-full uppercase" />
                    </div>
                  </div>
                  <div>
                    <label class="text-[11px] text-[var(--color-text-muted)] block mb-1">Stroke Color & Width</label>
                    <div class="flex items-center gap-1.5">
                      <input type="color" id="shape-stroke-color" value="#1B5448" class="size-7 rounded cursor-pointer border border-[var(--color-border)] bg-transparent p-0" />
                      <input type="range" id="shape-stroke-width" min="0" max="30" value="0" class="w-full accent-[var(--accent)]" />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- BACKGROUND LAYER CONTROLS -->
          <div class="card-surface p-4 border border-[var(--color-border)] rounded-2xl space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-foreground flex items-center gap-1.5 uppercase tracking-wider">
                <span>🖼️</span> 2. Background Layer
              </span>
              <div class="flex items-center gap-1">
                <button id="btn-toggle-bg-visible" type="button" class="text-[11px] text-[var(--color-text-muted)] hover:text-foreground px-1" title="Toggle background visibility">
                  👁️ Visible
                </button>
              </div>
            </div>

            <!-- Background Type Selector -->
            <div class="grid grid-cols-4 p-1 bg-[var(--color-bg-secondary)] border border-[var(--color-border)] rounded-xl gap-1 text-[11px] font-medium text-center">
              <button id="bg-type-solid" type="button" class="py-1 px-1 rounded-lg bg-[var(--color-card)] text-foreground shadow-xs font-semibold">
                Solid
              </button>
              <button id="bg-type-linear" type="button" class="py-1 px-1 rounded-lg text-[var(--color-text-muted)] hover:text-foreground">
                Linear Grad
              </button>
              <button id="bg-type-radial" type="button" class="py-1 px-1 rounded-lg text-[var(--color-text-muted)] hover:text-foreground">
                Radial Grad
              </button>
              <button id="bg-type-transparent" type="button" class="py-1 px-1 rounded-lg text-[var(--color-text-muted)] hover:text-foreground">
                Transparent
              </button>
            </div>

            <!-- Solid Color Controls -->
            <div id="bg-solid-controls" class="space-y-2">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <input type="color" id="bg-solid-color" value="#1B5448" class="size-8 rounded-lg cursor-pointer border border-[var(--color-border)] bg-transparent p-0" />
                  <input type="text" id="bg-solid-hex" value="#1B5448" class="sw-tool-input text-xs font-mono py-1 px-2 w-28 uppercase" />
                </div>
                <!-- Presets -->
                <div class="flex items-center gap-1">
                  <button type="button" class="preset-color size-5 rounded-md border border-[var(--color-border)] hover:scale-110 transition-transform" style="background:#1B5448" data-color="#1B5448" title="#1B5448"></button>
                  <button type="button" class="preset-color size-5 rounded-md border border-[var(--color-border)] hover:scale-110 transition-transform" style="background:#23382B" data-color="#23382B" title="#23382B"></button>
                  <button type="button" class="preset-color size-5 rounded-md border border-[var(--color-border)] hover:scale-110 transition-transform" style="background:#0F172A" data-color="#0F172A" title="#0F172A"></button>
                  <button type="button" class="preset-color size-5 rounded-md border border-[var(--color-border)] hover:scale-110 transition-transform" style="background:#18181B" data-color="#18181B" title="#18181B"></button>
                  <button type="button" class="preset-color size-5 rounded-md border border-[var(--color-border)] hover:scale-110 transition-transform" style="background:#4e5850" data-color="#4e5850" title="#4e5850"></button>
                  <button type="button" class="preset-color size-5 rounded-md border border-[var(--color-border)] hover:scale-110 transition-transform" style="background:#E1F8DC" data-color="#E1F8DC" title="#E1F8DC"></button>
                </div>
              </div>
            </div>

            <!-- Gradient Controls -->
            <div id="bg-grad-controls" class="hidden space-y-2">
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="text-[10px] text-[var(--color-text-muted)] block mb-1">Color 1 (Start)</label>
                  <div class="flex items-center gap-1.5">
                    <input type="color" id="bg-grad-color1" value="#1B5448" class="size-7 rounded cursor-pointer border border-[var(--color-border)] bg-transparent p-0" />
                    <input type="text" id="bg-grad-hex1" value="#1B5448" class="sw-tool-input text-[10px] font-mono py-1 px-1.5 w-full uppercase" />
                  </div>
                </div>
                <div>
                  <label class="text-[10px] text-[var(--color-text-muted)] block mb-1">Color 2 (End)</label>
                  <div class="flex items-center gap-1.5">
                    <input type="color" id="bg-grad-color2" value="#ade1cd" class="size-7 rounded cursor-pointer border border-[var(--color-border)] bg-transparent p-0" />
                    <input type="text" id="bg-grad-hex2" value="#ADE1CD" class="sw-tool-input text-[10px] font-mono py-1 px-1.5 w-full uppercase" />
                  </div>
                </div>
              </div>

              <div id="grad-angle-row" class="space-y-1">
                <div class="flex items-center justify-between text-[11px] text-[var(--color-text-muted)]">
                  <span>Gradient Angle</span>
                  <span id="grad-angle-val" class="font-mono text-foreground font-semibold">135°</span>
                </div>
                <input type="range" id="bg-grad-angle" min="0" max="360" value="135" class="w-full accent-[var(--accent)]" />
              </div>

              <!-- Gradient Presets -->
              <div class="flex items-center gap-1.5 pt-1">
                <span class="text-[10px] text-[var(--color-text-muted)]">Presets:</span>
                <button type="button" class="btn-grad-preset text-[10px] px-2 py-0.5 rounded bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--accent)]" data-c1="#1B5448" data-c2="#ade1cd" data-angle="135">Forest Mint</button>
                <button type="button" class="btn-grad-preset text-[10px] px-2 py-0.5 rounded bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--accent)]" data-c1="#0F172A" data-c2="#334155" data-angle="180">Dark Slate</button>
                <button type="button" class="btn-grad-preset text-[10px] px-2 py-0.5 rounded bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--accent)]" data-c1="#23382B" data-c2="#1B5448" data-angle="90">Emerald Deep</button>
              </div>
            </div>
          </div>

          <!-- FOREGROUND & POSITIONING CONTROLS -->
          <div class="card-surface p-4 border border-[var(--color-border)] rounded-2xl space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-foreground flex items-center gap-1.5 uppercase tracking-wider">
                <span>📐</span> 3. Foreground & Transform
              </span>
              <div class="flex items-center gap-1">
                <button id="btn-fg-center" type="button" class="sw-tool-btn text-[10px] py-0.5 px-2" title="Center artwork">Center</button>
                <button id="btn-fg-fit" type="button" class="sw-tool-btn text-[10px] py-0.5 px-2" title="Fit to 66% Adaptive Safe Zone">Fit Safe Zone</button>
                <button id="btn-fg-reset" type="button" class="sw-tool-btn text-[10px] py-0.5 px-2" title="Reset transforms">Reset</button>
              </div>
            </div>

            <!-- Scale & Padding -->
            <div class="grid grid-cols-2 gap-3">
              <div class="space-y-1">
