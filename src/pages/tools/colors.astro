---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import GlowLineSeparator from '../../components/ui/separator/GlowLineSeparator.astro';

const pageTitle = "Color Picker & Palette Generator for Developers | Piush";
const pageDescription = "Modern color picker, OKLCH palette generator, contrast checker and UI color system generator for web, Flutter, Swift and Android development.";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <!-- Structured Data: WebApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Modern Color Studio',
      applicationCategory: 'DesignApplication',
      operatingSystem: 'All',
      browserRequirements: 'Requires JavaScript',
      url: new URL('/tools/colors', Astro.site || 'https://piush.com').toString(),
      description: pageDescription,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
    })} />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col font-sans">
    <Header />
    <main class="flex-1 w-full px-3 sm:px-6 lg:px-10 py-4 sm:py-6 space-y-5 max-w-[1680px] mx-auto">
      
      <!-- Top Navigation & Breadcrumbs -->
      <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--color-text-muted)] border-b border-[var(--color-border)] pb-3">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2">
          <a href="/" class="hover:text-[var(--accent)] transition-colors no-underline">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-[var(--accent)] transition-colors no-underline">Tools</a>
          <span>/</span>
          <span class="text-[var(--accent)] font-medium">Color Studio</span>
        </nav>
        <div class="flex items-center gap-2 font-mono text-[11px] text-[var(--color-text-secondary)]">
          <span class="inline-flex size-2 rounded-full bg-[var(--accent)]"></span>
          <span>100% Client-Side • Local Color Processing</span>
        </div>
      </div>

      <!-- Header Title & Cross-Link -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
          <div class="flex items-center gap-2.5">
            <div class="size-9 rounded-xl flex items-center justify-center text-[var(--accent)] bg-[rgba(var(--accent-rgb),0.1)] border border-[rgba(var(--accent-rgb),0.2)]">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z"/>
              </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight m-0">
              Modern Color Studio
            </h1>
            <span class="text-[11px] font-mono font-medium px-2 py-0.5 rounded-full bg-[rgba(var(--accent-rgb),0.1)] text-[var(--accent)] border border-[rgba(var(--accent-rgb),0.2)]">
              OKLCH Engine
            </span>
          </div>
          <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1 m-0">
            Pick, adjust, generate 50–950 shades, evaluate accessibility contrast, and export cross-platform design tokens.
          </p>
        </div>

        <!-- Cross-link Callout to App Icon Creator -->
        <div class="flex items-center gap-2">
          <a
            href="/tools/app-icon"
            id="link-send-to-icon"
            class="sw-tool-btn text-xs font-semibold text-[var(--accent)] border-[rgba(var(--accent-rgb),0.35)] hover:bg-[rgba(var(--accent-rgb),0.12)]"
            title="Transfer active color to App Icon Creator"
          >
            <span>Creating an app? Use these colors in App Icon Creator</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- SECTION 1: COLOR PICKER & COLOR FORMATS -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">
        
        <!-- Interactive 2D Visual Picker + Sliders (5 cols) -->
        <div class="lg:col-span-5 card-surface p-4 sm:p-5 border border-[var(--color-border)] rounded-2xl flex flex-col justify-between space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-foreground flex items-center gap-1.5 uppercase tracking-wider">
              <span>🎯</span> Visual Color Selector
            </span>
            <div class="flex items-center gap-1.5">
              <button id="btn-eyedropper" type="button" class="sw-tool-btn text-[11px] py-1 px-2" title="Pick color from screen">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m2 22 1-1h3l9-9"/>
                  <path d="M3 21v-3l9-9"/>
                  <path d="m15 6 3.4-3.4a2.1 2.1 0 1 1 3 3L18 9l-3-3Z"/>
                </svg>
                <span>Eyedropper</span>
              </button>
              <button id="btn-random-color" type="button" class="sw-tool-btn text-[11px] py-1 px-2" title="Generate random harmonious color">
                <span>Random</span>
              </button>
            </div>
          </div>

          <!-- 2D Saturation / Value Area -->
          <div id="sat-val-canvas" class="relative w-full h-44 rounded-xl cursor-crosshair overflow-hidden border border-[var(--color-border)] select-none">
            <div class="absolute inset-0 bg-gradient-to-r from-white to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent"></div>
            <!-- Draggable Handle Pin -->
            <div id="sat-val-handle" class="absolute size-4 -ml-2 -mt-2 rounded-full border-2 border-white shadow-md pointer-events-none ring-1 ring-black/40"></div>
          </div>

          <!-- Sliders: Hue & Alpha -->
          <div class="space-y-3 pt-1">
            <!-- Hue Slider (0-360) -->
            <div>
              <div class="flex justify-between text-[11px] font-mono text-[var(--color-text-muted)] mb-1">
                <span>Hue</span>
                <span id="label-hue">168°</span>
              </div>
              <input type="range" id="slider-hue" min="0" max="360" value="168" class="w-full h-3 rounded-lg appearance-none cursor-pointer hue-slider-track" />
            </div>

            <!-- Alpha Slider (0-100%) -->
            <div>
              <div class="flex justify-between text-[11px] font-mono text-[var(--color-text-muted)] mb-1">
                <span>Opacity / Alpha</span>
                <span id="label-alpha">100%</span>
              </div>
              <input type="range" id="slider-alpha" min="0" max="100" value="100" class="w-full h-3 rounded-lg appearance-none cursor-pointer alpha-slider-track" />
            </div>
          </div>

          <!-- Color Comparison Swatch (BEFORE vs CURRENT) -->
          <div class="pt-2 border-t border-[var(--color-border)] flex items-center justify-between text-xs font-mono">
            <div class="flex items-center gap-2">
              <div class="flex rounded-lg overflow-hidden border border-[var(--color-border)] shadow-xs">
                <div id="swatch-prev" class="size-8 cursor-pointer" title="Previous color (click to restore)"></div>
                <div id="swatch-curr" class="size-8" title="Current color"></div>
              </div>
              <div>
                <span class="text-[10px] text-[var(--color-text-muted)] block">Before / Now</span>
                <span id="display-hex-main" class="font-bold text-foreground text-sm">#1B5448</span>
              </div>
            </div>

            <!-- Smart Text Contrast Pill -->
            <div id="smart-text-pill" class="px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-xs">
              <span id="smart-text-label">White Text</span>
            </div>
          </div>
        </div>

        <!-- Color Codes & Conversions Grid (7 cols) -->
        <div class="lg:col-span-7 card-surface p-4 sm:p-5 border border-[var(--color-border)] rounded-2xl flex flex-col justify-between space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-foreground flex items-center gap-1.5 uppercase tracking-wider">
              <span>📋</span> Standard & Perceptual Color Formats
            </span>
            <span class="text-[11px] text-[var(--color-text-muted)] font-mono">Click code to copy</span>
          </div>

          <!-- Format Fields Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono" id="format-fields-list">
            <!-- Format Item: HEX -->
            <div class="sw-format-box">
              <span class="sw-format-label">HEX</span>
              <input type="text" id="code-hex" readonly class="sw-format-input" value="#1B5448" />
              <button type="button" class="sw-copy-btn" data-copy-target="code-hex" title="Copy HEX">Copy</button>
            </div>

            <!-- Format Item: HEX8 -->
            <div class="sw-format-box">
              <span class="sw-format-label">HEX8</span>
              <input type="text" id="code-hex8" readonly class="sw-format-input" value="#1B5448FF" />
              <button type="button" class="sw-copy-btn" data-copy-target="code-hex8" title="Copy HEX8">Copy</button>
            </div>

            <!-- Format Item: RGB -->
            <div class="sw-format-box">
              <span class="sw-format-label">RGB</span>
              <input type="text" id="code-rgb" readonly class="sw-format-input" value="rgb(27, 84, 72)" />
              <button type="button" class="sw-copy-btn" data-copy-target="code-rgb" title="Copy RGB">Copy</button>
            </div>

            <!-- Format Item: RGBA -->
            <div class="sw-format-box">
              <span class="sw-format-label">RGBA</span>
              <input type="text" id="code-rgba" readonly class="sw-format-input" value="rgba(27, 84, 72, 1)" />
              <button type="button" class="sw-copy-btn" data-copy-target="code-rgba" title="Copy RGBA">Copy</button>
            </div>

            <!-- Format Item: HSL -->
            <div class="sw-format-box">
              <span class="sw-format-label">HSL</span>
              <input type="text" id="code-hsl" readonly class="sw-format-input" value="hsl(167, 51%, 22%)" />
              <button type="button" class="sw-copy-btn" data-copy-target="code-hsl" title="Copy HSL">Copy</button>
            </div>

            <!-- Format Item: HSLA -->
            <div class="sw-format-box">
              <span class="sw-format-label">HSLA</span>
              <input type="text" id="code-hsla" readonly class="sw-format-input" value="hsla(167, 51%, 22%, 1)" />
              <button type="button" class="sw-copy-btn" data-copy-target="code-hsla" title="Copy HSLA">Copy</button>
            </div>

            <!-- Format Item: HSV -->
            <div class="sw-format-box">
              <span class="sw-format-label">HSV</span>
              <input type="text" id="code-hsv" readonly class="sw-format-input" value="hsv(167, 68%, 33%)" />
              <button type="button" class="sw-copy-btn" data-copy-target="code-hsv" title="Copy HSV">Copy</button>
            </div>

            <!-- Format Item: HWB -->
            <div class="sw-format-box">
              <span class="sw-format-label">HWB</span>
              <input type="text" id="code-hwb" readonly class="sw-format-input" value="hwb(167 11% 67%)" />
              <button type="button" class="sw-copy-btn" data-copy-target="code-hwb" title="Copy HWB">Copy</button>
            </div>

            <!-- Format Item: OKLCH -->
            <div class="sw-format-box">
              <span class="sw-format-label text-[var(--accent)] font-bold">OKLCH</span>
              <input type="text" id="code-oklch" readonly class="sw-format-input font-bold" value="oklch(0.38 0.08 174)" />
              <button type="button" class="sw-copy-btn" data-copy-target="code-oklch" title="Copy OKLCH">Copy</button>
            </div>

            <!-- Format Item: OKLAB -->
            <div class="sw-format-box">
              <span class="sw-format-label">OKLAB</span>
              <input type="text" id="code-oklab" readonly class="sw-format-input" value="oklab(0.38 -0.07 0.02)" />
              <button type="button" class="sw-copy-btn" data-copy-target="code-oklab" title="Copy OKLAB">Copy</button>
            </div>
          </div>

          <!-- Component Previews Strip -->
          <div class="pt-3 border-t border-[var(--color-border)]">
            <span class="text-[10px] font-mono text-[var(--color-text-muted)] block mb-2 uppercase">Color in Context:</span>
            <div class="flex flex-wrap items-center gap-2">
              <button id="preview-btn-fill" type="button" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white shadow-xs">Button</button>
              <button id="preview-btn-outline" type="button" class="px-3 py-1.5 rounded-lg text-xs font-semibold border bg-transparent">Outline</button>
              <span id="preview-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold">Status Badge</span>
              <span id="preview-text" class="text-xs font-bold">Colored Typography</span>
              <input type="text" id="preview-input" value="Input focus ring" class="px-2 py-1 rounded text-xs border w-36 font-mono bg-transparent outline-none" />
            </div>
          </div>
        </div>

      </div>

      <!-- SECTION 2: 50–950 COLOR SHADES GENERATOR (OKLCH BALANCED) -->
      <section class="card-surface p-4 sm:p-5 border border-[var(--color-border)] rounded-2xl space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-foreground m-0 flex items-center gap-2">
              <span class="text-[var(--accent)]">✦</span>
              Perceptual 50–950 Color Shades Scale
            </h2>
            <p class="text-xs text-[var(--color-text-muted)] mt-0.5 m-0">
              Balanced lightness and chroma distribution designed for design systems (Tailwind & CSS variable ready).
            </p>
          </div>
          <div class="flex items-center gap-2">
            <button id="btn-copy-all-shades" type="button" class="sw-tool-btn text-xs">
              <span>Copy All Shades</span>
            </button>
          </div>
        </div>

        <!-- 11 Steps Swatches Grid -->
        <div id="shades-scale-grid" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-11 gap-2 font-mono text-center">
          <!-- Populated by JS -->
        </div>
      </section>

      <!-- SECTION 3: COLOR HARMONIES & ACCESSIBILITY CONTRAST -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">
        
        <!-- Harmonies (6 cols) -->
        <div class="lg:col-span-6 card-surface p-4 sm:p-5 border border-[var(--color-border)] rounded-2xl space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-foreground font-mono m-0 flex items-center gap-1.5">
              <span>🎨</span> Color Harmonies
            </h2>
            <span class="text-[10px] text-[var(--color-text-muted)] font-mono">Click swatch to select color</span>
          </div>

          <div class="space-y-2.5 text-xs font-mono" id="harmonies-list">
            <!-- Populated by JS: Complementary, Analogous, Triadic, Tetradic, Split, Monochromatic -->
          </div>
        </div>

        <!-- Accessibility Contrast Checker (6 cols) -->
        <div class="lg:col-span-6 card-surface p-4 sm:p-5 border border-[var(--color-border)] rounded-2xl space-y-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <h2 class="text-sm font-bold text-foreground font-mono m-0 flex items-center gap-1.5">
                <span>👁️</span> WCAG 2.1 Contrast Checker
              </h2>
              <span id="contrast-ratio-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold font-mono bg-[rgba(var(--accent-rgb),0.15)] text-[var(--accent)] border border-[rgba(var(--accent-rgb),0.3)]">
                8.4 : 1
              </span>
            </div>

            <!-- Foreground & Background pickers -->
            <div class="grid grid-cols-2 gap-3 mb-3">
              <div class="p-2.5 rounded-xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">
                <span class="text-[10px] text-[var(--color-text-muted)] block mb-1">Text Color (Foreground)</span>
                <div class="flex items-center gap-2">
                  <input type="color" id="contrast-fg-picker" value="#ffffff" class="size-6 rounded border border-[var(--color-border)] p-0 cursor-pointer" />
                  <span id="contrast-fg-hex" class="text-xs font-mono font-bold">#FFFFFF</span>
                </div>
              </div>
              <div class="p-2.5 rounded-xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">
                <span class="text-[10px] text-[var(--color-text-muted)] block mb-1">Surface (Background)</span>
                <div class="flex items-center gap-2">
                  <input type="color" id="contrast-bg-picker" value="#1B5448" class="size-6 rounded border border-[var(--color-border)] p-0 cursor-pointer" />
                  <span id="contrast-bg-hex" class="text-xs font-mono font-bold">#1B5448</span>
                </div>
              </div>
            </div>

            <!-- WCAG Pass/Fail Badges -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-xs font-mono">
              <div class="p-2 rounded-lg bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">
                <div class="text-[10px] text-[var(--color-text-muted)]">Normal AA</div>
                <div id="wcag-normal-aa" class="font-bold text-emerald-400 mt-0.5">PASS</div>
              </div>
              <div class="p-2 rounded-lg bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">
                <div class="text-[10px] text-[var(--color-text-muted)]">Normal AAA</div>
                <div id="wcag-normal-aaa" class="font-bold text-emerald-400 mt-0.5">PASS</div>
              </div>
              <div class="p-2 rounded-lg bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">
                <div class="text-[10px] text-[var(--color-text-muted)]">Large AA</div>
                <div id="wcag-large-aa" class="font-bold text-emerald-400 mt-0.5">PASS</div>
              </div>
              <div class="p-2 rounded-lg bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">
                <div class="text-[10px] text-[var(--color-text-muted)]">Large AAA</div>
                <div id="wcag-large-aaa" class="font-bold text-emerald-400 mt-0.5">PASS</div>
              </div>
            </div>
          </div>

          <!-- Live Contrast Visual Preview Box -->
          <div id="contrast-sample-box" class="p-4 rounded-xl border border-[var(--color-border)] text-center transition-colors">
            <h3 class="text-base font-bold m-0" id="contrast-sample-heading">The quick brown fox jumps over the lazy dog.</h3>
            <p class="text-xs mt-1 m-0 leading-relaxed" id="contrast-sample-body">
              Accessibility verified against WCAG 2.1 luminance standards (18pt / 14pt bold and 14pt body text).
            </p>
          </div>
        </div>

      </div>

      <!-- SECTION 4: COLOR MIXER & IMAGE EXTRACTION -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">
        
        <!-- Color Mixer (6 cols) -->
        <div class="lg:col-span-6 card-surface p-4 sm:p-5 border border-[var(--color-border)] rounded-2xl space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-foreground font-mono m-0 flex items-center gap-1.5">
              <span>⚗️</span> Two-Color Interpolation Mixer
            </h2>
            <span id="mixer-result-hex" class="text-xs font-mono font-bold text-[var(--accent)]">#7E9E8C</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-center">
            <div class="flex items-center gap-2 p-2 rounded-xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">
              <input type="color" id="mixer-color-a" value="#1B5448" class="size-7 rounded border border-[var(--color-border)] p-0 cursor-pointer" />
              <div>
                <span class="text-[10px] text-[var(--color-text-muted)] block">Color A</span>
                <span id="mixer-a-label" class="font-mono text-xs font-bold">#1B5448</span>
              </div>
            </div>

            <!-- Middle Mix Result Swatch -->
            <div id="mixer-swatch-box" class="h-12 rounded-xl border border-[var(--color-border)] shadow-xs flex items-center justify-center font-mono text-xs font-bold text-white cursor-pointer" title="Click to use mixed color as active">
              Result
            </div>

            <div class="flex items-center gap-2 p-2 rounded-xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">
              <input type="color" id="mixer-color-b" value="#E1F8DC" class="size-7 rounded border border-[var(--color-border)] p-0 cursor-pointer" />
              <div>
                <span class="text-[10px] text-[var(--color-text-muted)] block">Color B</span>
                <span id="mixer-b-label" class="font-mono text-xs font-bold">#E1F8DC</span>
              </div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-[11px] font-mono text-[var(--color-text-muted)] mb-1">
              <span>Mixing Ratio (Color A vs Color B)</span>
              <span id="mixer-ratio-label">50%</span>
            </div>
            <input type="range" id="slider-mixer" min="0" max="100" value="50" class="w-full accent-[var(--accent)]" />
          </div>
        </div>

        <!-- Image Color Extraction (6 cols) -->
        <div class="lg:col-span-6 card-surface p-4 sm:p-5 border border-[var(--color-border)] rounded-2xl space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-foreground font-mono m-0 flex items-center gap-1.5">
              <span>🖼️</span> Local Image Color Extractor
            </h2>
            <span class="text-[10px] text-[var(--color-text-muted)] font-mono">100% Client-Side</span>
          </div>

          <!-- Dropzone -->
          <label id="image-dropzone" class="block border-2 border-dashed border-[var(--color-border)] rounded-xl p-4 text-center cursor-pointer hover:border-[var(--accent)] transition-colors">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="mx-auto text-[var(--color-text-muted)] mb-1">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
              <circle cx="9" cy="9" r="2"/>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
            </svg>
            <span class="text-xs text-[var(--color-text-secondary)] font-medium">Click to upload or drag & drop image (PNG, JPG, WebP)</span>
            <input type="file" id="image-file-input" accept="image/*" class="hidden" />
          </label>

          <!-- Extracted Swatches Strip -->
          <div id="extracted-swatches-strip" class="flex flex-wrap items-center gap-1.5 min-h-[32px]">
            <span class="text-xs text-[var(--color-text-muted)] italic">Upload an image to extract its primary color palette.</span>
          </div>
        </div>

      </div>

      <!-- SECTION 5: REALISTIC MINIATURE UI PREVIEW -->
      <section class="card-surface p-4 sm:p-6 border border-[var(--color-border)] rounded-2xl space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-foreground m-0 flex items-center gap-2">
              <span>📱</span> Miniature UI Theme Preview
            </h2>
            <p class="text-xs text-[var(--color-text-muted)] mt-0.5 m-0">
              Verify your generated color system on real-world navigation, typography, cards, inputs, and buttons.
