---
interface StudyItem {
  title: string;
  institution: string;
  description: string;
  tags?: string[];
}

interface Props {
  items: StudyItem[];
  title?: string;
  subtitle?: string;
}

const {
  items,
  title = "Education & Academic Foundations",
  subtitle = "Computer science foundations, distributed systems, and software engineering principles."
} = Astro.props as Props;
---

<section class="w-full py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-10">
      {title && (
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-foreground">
          {title}
        </h2>
      )}
      {subtitle && (
        <p class="mt-3 text-base text-[var(--color-text-muted)]">
          {subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {items.map((study) => (
        <article class="card-surface p-6 sm:p-7 flex flex-col justify-between group">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="size-10 rounded-xl bg-[rgba(var(--accent-rgb),0.1)] border border-[rgba(var(--accent-rgb),0.2)] text-[var(--accent)] flex items-center justify-center shrink-0">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-foreground group-hover:text-[var(--accent)] transition-colors m-0">
                  {study.title}
                </h3>
                <div class="text-xs sm:text-sm font-medium text-[var(--color-text-muted)] mt-0.5">
                  {study.institution}
                </div>
              </div>
            </div>

            <p class="mt-3 text-sm text-[var(--color-text-secondary)] leading-relaxed m-0">
              {study.description}
            </p>
          </div>

          {study.tags && study.tags.length > 0 && (
            <div class="mt-5 pt-3 border-t border-[var(--color-border)] flex flex-wrap gap-1.5">
              {study.tags.map((tag) => (
                <span class="tech-chip">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
