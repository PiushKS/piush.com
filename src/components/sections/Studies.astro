---
interface StudyItem {
  title: string;
  institution: string;
  description: string;
  tags?: string[];
}

interface Props {
  items: StudyItem[];
  title?: string;
  subtitle?: string;
}

const {
  items,
  title = "Education & Academic Foundations",
  subtitle = "Computer science foundations, distributed systems, and software engineering principles."
} = Astro.props as Props;
---

<section class="w-full py-4 sm:py-6 md:py-8 select-none">
  <div class="w-full">
    <!-- Header matching reference mockups 2.png & 3.png -->
    <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-8 space-y-2">
      <div class="inline-flex justify-center">
        <span class="retro-info-bubble" aria-hidden="true">i</span>
      </div>
      {title && (
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black font-mono tracking-tight text-[#0057cc] uppercase m-0">
          {title}
        </h2>
      )}
      {subtitle && (
        <p class="text-xs sm:text-sm font-mono text-[#222222] leading-relaxed max-w-xl mx-auto m-0">
          {subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 w-full">
      {items.map((study) => (
        <article class="retro-card p-5 sm:p-6 flex flex-col justify-between group">
          <div>
            <div class="flex items-center gap-3 mb-3 pb-2 border-b-2 border-black">
              <div class="icon-badge-interactive size-9 flex items-center justify-center text-black shrink-0">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base sm:text-lg font-bold font-mono text-[#0057cc] m-0">
                  {study.title}
                </h3>
                <div class="text-xs font-mono font-bold text-black mt-0.5">
                  {study.institution}
                </div>
              </div>
            </div>

            <p class="text-xs sm:text-sm font-mono text-[#333333] leading-relaxed m-0">
              {study.description}
            </p>
          </div>

          {study.tags && study.tags.length > 0 && (
            <div class="mt-4 pt-2 border-t-2 border-black flex flex-wrap gap-1">
              {study.tags.map((tag) => (
                <span class="tech-chip text-[0.65rem] py-0.5 px-1.5">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
