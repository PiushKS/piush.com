---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const normHref = String(href || '').replace(/\/+$/, '');
const normPath = pathname.replace(/\/+$/, '');
const isActive = normHref === normPath || (normHref !== '' && normHref === '/' + (subpath?.[0] || ''));
---

<a
  href={href}
  class:list={[
    'relative px-2.5 py-1 text-sm font-mono transition-none no-underline select-none',
    isActive
      ? 'font-bold text-black underline decoration-2 underline-offset-4 decoration-black'
      : 'text-black hover:underline hover:decoration-2 hover:underline-offset-4 font-normal',
    className
  ]}
  {...props}
>
  <slot />
</a>
