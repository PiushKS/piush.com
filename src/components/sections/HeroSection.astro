---
import Button from "../ui/button/Button.astro";
import InteractivePortrait from "../hero/InteractivePortrait.astro";

interface Cta {
  text: string;
  href: string;
}

interface Props {
  title?: string;
  badge?: string;
  subtitle?: string;
  showCTA?: boolean;
  primaryCTA?: Cta;
  secondaryCTA?: Cta;
  showHighlights?: boolean;
}

const {
  title = "Piush KS",
  badge = "Available for High-Impact Projects",
  subtitle = "Architecting resilient mobile architectures, scalable cloud platforms, and delightful digital products with obsessive craft, speed, and reliability.",
  showCTA = true,
  primaryCTA = { text: "View Portfolio", href: "/portfolio/" },
  secondaryCTA = { text: "Read Blog Articles", href: "/blog/" },
  showHighlights = true,
} = Astro.props as Props;

const techPills = [
  { name: "Swift / iOS", icon: "✦" },
  { name: "Kotlin / Android", icon: "✦" },
  { name: "React Native / Flutter", icon: "✦" },
  { name: "TypeScript / Node", icon: "✦" },
  { name: "AWS & Cloud", icon: "✦" },
];
---

<section class="relative w-full py-4 sm:py-6 md:py-8 overflow-hidden bg-transparent select-none">
  <div class="relative z-10 w-full px-2 sm:px-4 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
      
      <!-- Left Column: Copy, CTAs, Tech Pills & Highlights (Matching 1.png) -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-4 sm:space-y-5">
        
        <!-- Retro Status Info Header matching 1.png & 2.png -->
        <div class="inline-flex items-center gap-2">
          <span class="retro-info-bubble" aria-hidden="true">i</span>
          {badge && (
            <span class="status-pill text-xs">
              <span class="status-dot"></span>
              {badge}
            </span>
          )}
        </div>

        <!-- Main Title: Bold Blue Uppercase (Matching 1.png COMPUTERS) -->
        <div class="space-y-1">
          <div class="text-xs sm:text-sm font-bold uppercase tracking-widest text-[#0057cc] font-mono">
            Introduction to
          </div>
          <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight text-[#0057cc] uppercase leading-none font-mono">
            {title}
            <span class="sr-only"> – Mobile Architect & Full-Stack Engineer</span>
          </h1>
          <div class="text-xs sm:text-sm font-mono uppercase font-bold text-black tracking-wider pt-1">
            Understanding the Architecture • Senior Mobile Architect & Solopreneur
          </div>
        </div>

        <!-- Refined Subtitle Description -->
        {subtitle && (
          <p class="text-sm sm:text-base md:text-lg text-[#222222] font-mono leading-relaxed max-w-2xl mx-auto lg:mx-0">
            {subtitle}
          </p>
        )}

        <!-- Action Buttons matching 1.png [Start] with retro cursor -->
        {showCTA && (primaryCTA || secondaryCTA) && (
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-1">
            <div class="relative inline-flex items-center">
              {primaryCTA && (
                <Button href={primaryCTA.href} variant="primary" size="lg" class="shadow-sm">
                  <span>[ {primaryCTA.text} ]</span>
                  <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" class="ml-1">
                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </Button>
              )}
              <!-- Retro Pixel Arrow Pointer Cursor Overlay -->
              <span class="hidden sm:inline-block ml-3 font-mono text-xs text-[#0057cc] font-bold animate-pulse" aria-hidden="true">
                ◄ CLICK TO START
              </span>
            </div>

            {secondaryCTA && (
              <Button href={secondaryCTA.href} variant="secondary" size="lg">
                <span>[ {secondaryCTA.text} ]</span>
              </Button>
            )}

            <a
              href="mailto:hi@piush.com"
              class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 text-xs font-mono text-black hover:text-[#0057cc] hover:underline"
            >
              <span>hi@piush.com</span>
              <span class="text-[10px] px-1 py-0.5 border border-black bg-[#e0e0e0]">Direct</span>
            </a>
          </div>
        )}

        <!-- Tech Stack Ribbon -->
        <div class="pt-1">
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2">
            <span class="text-xs font-mono text-[#555555] font-bold mr-1">Stack:</span>
            {techPills.map((tech) => (
              <span class="tech-chip text-xs font-mono cursor-default">
                <span class="text-[#0057cc] text-[10px]">{tech.icon}</span>
                <span>{tech.name}</span>
              </span>
            ))}
          </div>
        </div>

        <!-- Highlights Strip (Retro Metric Boxes) -->
        {showHighlights && (
          <div class="pt-3 border-t-2 border-black grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-2xl mx-auto lg:mx-0 font-mono">
            <div class="retro-card p-3 text-center">
              <div class="text-xl sm:text-2xl font-black text-[#0057cc]">8+ Years</div>
              <div class="text-[11px] text-[#333333] font-bold uppercase mt-0.5">Production Exp</div>
            </div>
            <div class="retro-card p-3 text-center">
              <div class="text-xl sm:text-2xl font-black text-black">10M+</div>
              <div class="text-[11px] text-[#333333] font-bold uppercase mt-0.5">Global Users</div>
            </div>
            <div class="col-span-2 sm:col-span-1 retro-card p-3 text-center">
              <div class="text-xl sm:text-2xl font-black text-[#0057cc]">100%</div>
              <div class="text-[11px] text-[#333333] font-bold uppercase mt-0.5">Craft & Arch</div>
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Interactive Portrait inside Retro OS Application Window -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center w-full">
        <!-- Minimized / Closed Restore Bar -->
        <div
          id="hero-avatar-closed-bar"
          class="hidden w-full max-w-[380px] p-2 bg-[#c0c0c0] border-2 border-white shadow-[2px_2px_0px_#000000] text-black font-mono text-xs flex items-center justify-between"
        >
          <div class="flex items-center gap-1.5 truncate">
            <span class="text-sm">🖼️</span>
            <span class="truncate font-bold">piush_avatar.bmp [Closed]</span>
          </div>
          <button
            type="button"
            id="hero-avatar-reopen-btn"
            class="retro-btn !py-0.5 !px-3 !text-xs font-bold"
          >
            Restore
          </button>
        </div>

        <div id="hero-avatar-card" class="w-full max-w-[380px] retro-card overflow-hidden">
          <!-- Mini Application Titlebar -->
          <div class="bg-[#0057cc] text-white px-3 py-1.5 flex items-center justify-between font-mono text-xs font-bold border-b-2 border-black">
            <span class="truncate">piush_avatar.bmp</span>
            <div class="flex items-center gap-1">
              <button
                type="button"
                id="hero-avatar-min-btn"
                class="size-3.5 bg-[#c0c0c0] hover:bg-[#dfdfdf] active:bg-[#a0a0a0] text-black text-[9px] flex items-center justify-center border border-black font-bold cursor-pointer"
                title="Minimize piush_avatar.bmp"
                aria-label="Minimize piush_avatar.bmp"
              >
                _
              </button>
              <button
                type="button"
                id="hero-avatar-max-btn"
                class="size-3.5 bg-[#c0c0c0] hover:bg-[#dfdfdf] active:bg-[#a0a0a0] text-black text-[9px] flex items-center justify-center border border-black font-bold cursor-pointer"
                title="Open in Image Viewer"
                aria-label="Open in Image Viewer"
              >
                &#9633;
              </button>
              <button
                type="button"
                id="hero-avatar-close-btn"
                class="size-3.5 bg-[#c0c0c0] hover:bg-[#cc0000] hover:text-white active:bg-[#990000] text-black text-[9px] flex items-center justify-center border border-black font-bold cursor-pointer"
                title="Close piush_avatar.bmp"
                aria-label="Close piush_avatar.bmp"
              >
                &#10005;
              </button>
            </div>
          </div>
          <!-- Inset Content Area -->
          <div id="hero-avatar-body" class="p-4 bg-[#f4f4f4] flex flex-col items-center justify-center">
            <InteractivePortrait />
          </div>
          <!-- Mini Status Footer -->
          <div id="hero-avatar-footer" class="bg-[#c0c0c0] text-black px-3 py-1 font-mono text-[10px] border-t-2 border-black flex justify-between">
            <span>READY • 420x420</span>
            <span>RGB 24-BIT</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { launchApp } from '../../lib/win95/appRegistry';
  import { audio } from '../../lib/win95/audio';

  function setupAvatarWindowControls() {
    const card = document.getElementById('hero-avatar-card');
    const closedBar = document.getElementById('hero-avatar-closed-bar');
    const body = document.getElementById('hero-avatar-body');
    const footer = document.getElementById('hero-avatar-footer');
    const minBtn = document.getElementById('hero-avatar-min-btn');
    const maxBtn = document.getElementById('hero-avatar-max-btn');
    const closeBtn = document.getElementById('hero-avatar-close-btn');
    const reopenBtn = document.getElementById('hero-avatar-reopen-btn');

    let isMinimized = false;

    minBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      try { audio.playClick(); } catch (_) {}
      isMinimized = !isMinimized;
      if (body) body.style.display = isMinimized ? 'none' : 'flex';
      if (footer) footer.style.display = isMinimized ? 'none' : 'flex';
    });

    maxBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      try { audio.playOpen(); } catch (_) {}
      launchApp('imageviewer');
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      try { audio.playClose(); } catch (_) {}
      if (card) card.classList.add('hidden');
      if (closedBar) closedBar.classList.remove('hidden');
    });

    reopenBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      try { audio.playOpen(); } catch (_) {}
      if (card) card.classList.remove('hidden');
      if (closedBar) closedBar.classList.add('hidden');
      if (body) body.style.display = 'flex';
      if (footer) footer.style.display = 'flex';
      isMinimized = false;
    });
  }

  setupAvatarWindowControls();
  document.addEventListener('astro:after-swap', setupAvatarWindowControls);
</script>
