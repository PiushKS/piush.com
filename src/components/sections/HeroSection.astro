---
import Button from "../ui/button/Button.astro";
import LottieAnimation from "../ui/lottie/LottieAnimation.astro";

interface Cta {
  text: string;
  href: string;
}

interface Props {
  title?: string;
  badge?: string;
  subtitle?: string;
  showCTA?: boolean;
  primaryCTA?: Cta;
  secondaryCTA?: Cta;
  showHighlights?: boolean;
}

const {
  title = "Piush KS",
  badge = "Available for High-Impact Projects",
  subtitle = "Architecting resilient mobile architectures, scalable cloud platforms, and delightful digital products with obsessive craft, speed, and reliability.",
  showCTA = true,
  primaryCTA = { text: "View Portfolio", href: "/portfolio" },
  secondaryCTA = { text: "Read Blog Articles", href: "/blog" },
  showHighlights = true,
} = Astro.props as Props;

const techPills = [
  { name: "Swift / iOS", icon: "✦" },
  { name: "Kotlin / Android", icon: "✦" },
  { name: "React Native / Flutter", icon: "✦" },
  { name: "TypeScript / Node", icon: "✦" },
  { name: "AWS & Cloud", icon: "✦" },
];
---

<section class="relative w-full py-6 sm:py-8 md:py-10 lg:py-12 overflow-hidden bg-transparent">
  <div class="relative z-10 w-full px-4 sm:px-8 lg:px-12 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      
      <!-- Left Column: Copy, CTAs, Tech Pills & Highlights -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-4 sm:space-y-5">
        
        <!-- Status Pill with Double Beacon Ping -->
        {badge && (
          <div class="inline-flex hero-enter-1">
            <div class="status-pill group cursor-default">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--accent)] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--accent)]"></span>
              </span>
              <span class="font-medium tracking-wide">{badge}</span>
              <span class="hidden sm:inline-block text-[var(--color-border)]">•</span>
              <span class="hidden sm:inline-block text-xs font-mono opacity-80">Q4 Open</span>
            </div>
          </div>
        )}

        <!-- Main Title with iPhone Green Gradient & Subtitle Tag -->
        <div class="space-y-2 hero-enter-2">
          <div class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-[var(--accent)] font-mono">
            Senior Mobile & Cloud Engineer • Solopreneur
          </div>
          <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight text-foreground leading-[1.02]">
            <span class="bg-gradient-to-r from-[#1B5448] via-[#23382B] to-[#4e5850] dark:from-[#ade1cd] dark:via-[#c6eedc] dark:to-[#E1F8DC] bg-clip-text text-transparent animate-text-sheen">
              {title}
            </span>
          </h1>
        </div>

        <!-- Refined Subtitle Description -->
        {subtitle && (
          <p class="text-base sm:text-lg md:text-xl text-[var(--color-text-secondary)] font-normal leading-relaxed max-w-2xl mx-auto lg:mx-0 hero-enter-3">
            {subtitle}
          </p>
        )}

        <!-- Action Buttons -->
        {showCTA && (primaryCTA || secondaryCTA) && (
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2 hero-enter-4">
            {primaryCTA && (
              <Button href={primaryCTA.href} variant="primary" size="lg" class="btn-interactive shadow-lg shadow-[#1B5448]/20 hover:shadow-[#1B5448]/35 transition-all">
                <span>{primaryCTA.text}</span>
                <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" class="transition-transform duration-200 group-hover:translate-x-1.5">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </Button>
            )}
            {secondaryCTA && (
              <Button href={secondaryCTA.href} variant="secondary" size="lg" class="btn-interactive">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-80">
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
                  <path d="M6 6h10M6 10h10"/>
                </svg>
                <span>{secondaryCTA.text}</span>
              </Button>
            )}
            <a
              href="mailto:hi@piush.com"
              class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 text-xs font-mono text-[var(--color-text-muted)] hover:text-[var(--accent)] transition-all duration-200 hover:-translate-y-0.5"
            >
              <span>hi@piush.com</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">Direct</span>
            </a>
          </div>
        )}

        <!-- Tech Stack Ribbon -->
        <div class="pt-2 hero-enter-5">
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2">
            <span class="text-xs font-mono text-[var(--color-text-muted)] mr-1">Stack:</span>
            {techPills.map((tech) => (
              <span class="tech-chip text-xs font-mono px-2.5 py-1 cursor-default">
                <span class="text-[var(--accent)] text-[10px]">{tech.icon}</span>
                <span>{tech.name}</span>
              </span>
            ))}
          </div>
        </div>

        <!-- Highlights Strip (Frosted Glass KPI Cards) -->
        {showHighlights && (
          <div class="pt-4 border-t border-[var(--color-border)]/60 grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-2xl mx-auto lg:mx-0 hero-enter-5">
            <div class="p-3 sm:p-3.5 rounded-2xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--accent)]/50 transition-all duration-200 hover:-translate-y-1 hover:shadow-md cursor-default">
              <div class="text-xl sm:text-2xl font-black text-[var(--accent)] tracking-tight">8+ Years</div>
              <div class="text-xs text-[var(--color-text-muted)] font-medium mt-0.5">Production Experience</div>
            </div>
            <div class="p-3 sm:p-3.5 rounded-2xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--accent)]/50 transition-all duration-200 hover:-translate-y-1 hover:shadow-md cursor-default">
              <div class="text-xl sm:text-2xl font-black text-foreground tracking-tight">10M+</div>
              <div class="text-xs text-[var(--color-text-muted)] font-medium mt-0.5">Users Scaled Globally</div>
            </div>
            <div class="col-span-2 sm:col-span-1 p-3 sm:p-3.5 rounded-2xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--accent)]/50 transition-all duration-200 hover:-translate-y-1 hover:shadow-md cursor-default">
              <div class="text-xl sm:text-2xl font-black text-[var(--accent)] tracking-tight">100%</div>
              <div class="text-xs text-[var(--color-text-muted)] font-medium mt-0.5">Craft & Architecture</div>
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Apple Studio Showcase Window with Floating Accents -->
      <div class="lg:col-span-5 flex justify-center relative hero-enter-window">
        <div class="relative w-full max-w-lg">
          
          <!-- Floating Accent Badge: Top Right -->
          <div class="hidden sm:flex absolute -top-3 -right-3 z-20 items-center gap-2 px-3 py-1 rounded-full bg-[var(--card)]/90 border border-[var(--color-border)] shadow-lg backdrop-blur-md animate-float-slow text-xs font-medium text-foreground">
            <span class="size-2 rounded-full bg-[var(--accent)]"></span>
            <span>⚡ Sub-40ms P95 Latency</span>
          </div>

          <!-- Floating Accent Badge: Bottom Left -->
          <div class="hidden sm:flex absolute -bottom-3 -left-3 z-20 items-center gap-2 px-3 py-1 rounded-full bg-[var(--card)]/90 border border-[var(--color-border)] shadow-lg backdrop-blur-md animate-float-reverse text-xs font-medium text-foreground">
            <span class="text-[var(--accent)] font-bold">✦</span>
            <span>Native iOS & Android Core</span>
          </div>

          <!-- Studio Window Frame -->
          <div class="w-full card-surface rounded-3xl p-4 sm:p-5 border border-[var(--color-border)] shadow-xl relative overflow-hidden backdrop-blur-xl group">
            
            <!-- Window Titlebar with iPhone Green traffic dots -->
            <div class="flex items-center justify-between pb-3.5 mb-2 border-b border-[var(--color-border)]/50 text-xs font-mono text-[var(--color-text-muted)]">
              <div class="flex items-center gap-2">
                <span class="size-3 rounded-full bg-[#1B5448] border border-[rgba(255,255,255,0.1)]"></span>
                <span class="size-3 rounded-full bg-[#4e5850] border border-[rgba(255,255,255,0.1)]"></span>
                <span class="size-3 rounded-full bg-[#ade1cd] border border-[rgba(255,255,255,0.1)]"></span>
              </div>
              <span class="text-xs font-medium text-[var(--color-text-secondary)] tracking-tight">
                ~/piush.dev/Architecture.swift
              </span>
              <span class="flex items-center gap-1.5 text-[11px] font-medium text-[var(--accent)]">
                <span class="size-1.5 rounded-full bg-[var(--accent)] animate-ping"></span>
                60 FPS
              </span>
            </div>

            <!-- Lottie Animation Graphic (Recolored with iPhone Green) -->
            <div class="relative py-2 flex items-center justify-center">
              <div class="ambient-glow-orb inset-0 bg-[#ade1cd] opacity-15 pointer-events-none animate-ambient-breathe"></div>
              <LottieAnimation
                src="/assets/lottie/coding.json"
                class="w-full max-w-[340px] sm:max-w-[400px] aspect-[4/3] mx-auto filter drop-shadow-md"
                alt="Software Engineer Coding Animation"
              />
            </div>

            <!-- Studio Telemetry Footer -->
            <div class="pt-3.5 mt-1 border-t border-[var(--color-border)]/50 grid grid-cols-3 gap-2 text-center text-xs font-mono">
              <div class="p-2 rounded-xl bg-[var(--color-bg-secondary)]/60 border border-[var(--color-border)]/40">
                <div class="text-[10px] text-[var(--color-text-muted)]">Engine</div>
                <div class="font-semibold text-foreground text-xs mt-0.5">Apple Silicon</div>
              </div>
              <div class="p-2 rounded-xl bg-[var(--color-bg-secondary)]/60 border border-[var(--color-border)]/40">
                <div class="text-[10px] text-[var(--color-text-muted)]">Reliability</div>
                <div class="font-semibold text-[var(--accent)] text-xs mt-0.5">99.99% SLO</div>
              </div>
              <div class="p-2 rounded-xl bg-[var(--color-bg-secondary)]/60 border border-[var(--color-border)]/40">
                <div class="text-[10px] text-[var(--color-text-muted)]">Build</div>
                <div class="font-semibold text-foreground text-xs mt-0.5">Instant</div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
