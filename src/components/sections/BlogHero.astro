---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Engineering Blog",
  subtitle = "Practical guides on mobile systems, software architecture, developer tools, and solopreneur insights."
} = Astro.props as Props;
---

<section class="w-full py-8 md:py-12 relative overflow-hidden">
  <div class="ambient-glow-orb -top-20 left-1/2 -translate-x-1/2 w-[450px] h-[200px] bg-gradient-to-r from-[#FF5E1E] to-[#8B5CF6] opacity-15 pointer-events-none"></div>

  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <div class="inline-flex mb-3">
        <span class="status-pill text-xs">
          Articles & Insights
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-foreground leading-tight">
        <span class="bg-gradient-to-r from-[#FF5E1E] via-[#FF8A4C] to-[#FFB74D] bg-clip-text text-transparent">
          {title}
        </span>
      </h1>
      {subtitle && (
        <p class="mt-4 text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>
  </div>
</section>
