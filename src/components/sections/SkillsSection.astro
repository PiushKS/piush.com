---
import Carousel from '../ui/carousel/Carousel.astro';
import { logos } from '../../data/logos';

interface SkillItem {
  icon: string;
  title: string;
  description: string;
  tags?: string[];
}

interface Props {
  title?: string;
  subtitle?: string;
  skills: SkillItem[];
}

const {
  title = "Skills & Expertise",
  subtitle = "Technologies, frameworks, and methodologies I leverage to architect resilient digital systems.",
  skills
} = Astro.props as Props;
---

<section class="w-full py-4 sm:py-6 md:py-8 select-none">
  <div class="w-full">
    <!-- Header matching reference mockups 4.png & 5.png -->
    <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-8 space-y-2">
      <div class="inline-flex justify-center">
        <span class="retro-info-bubble" aria-hidden="true">i</span>
      </div>
      {title && (
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black font-mono tracking-tight text-[#0057cc] uppercase m-0">
          {title}
        </h2>
      )}
      {subtitle && (
        <p class="text-xs sm:text-sm font-mono text-[#222222] leading-relaxed max-w-xl mx-auto m-0">
          {subtitle}
        </p>
      )}
    </div>
  
    <!-- Tech stack logo strip marquee -->
    <div class="mb-6 sm:mb-8 retro-inset p-2 bg-[#f0f0f0]">
      <Carousel tools={logos} speedMs={40000} />
    </div>

    <!-- Responsive Skill Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 w-full">
      {skills.map((skill, index) => (
        <div class="retro-card p-4 sm:p-5 group flex flex-col justify-between h-full">
          <div>
            <!-- Top Row: App-style Icon + Monospace Index -->
            <div class="flex items-center justify-between mb-3 pb-2 border-b-2 border-black">
              <div
                class="icon-badge-interactive size-9 flex items-center justify-center text-black font-mono [&>svg]:size-4"
                set:html={skill.icon}
              />
              <span class="text-xs font-mono font-bold text-black">
                #{String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <!-- Title: Spans full width -->
            <h3 class="text-base font-bold font-mono text-black mb-1 group-hover:text-[#0057cc] transition-colors leading-snug tracking-tight">
              {skill.title}
            </h3>

            <!-- Description: Spans full width with balanced typography -->
            <p class="text-xs font-mono text-[#333333] leading-relaxed m-0">
              {skill.description}
            </p>
          </div>

          <!-- Bottom: Tech chips -->
          {skill.tags && skill.tags.length > 0 && (
            <div class="mt-3 pt-2 border-t-2 border-black flex flex-wrap gap-1">
              {skill.tags.map((tag) => (
                <span class="tech-chip text-[0.65rem] py-0.5 px-1.5">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
