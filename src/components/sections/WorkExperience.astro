---
import Timeline from "../ui/timeline/Timeline.astro";
import { workIcons } from "../../data/work";

interface ExperienceItem {
  title: string;
  company: string;
  region: string;
  description: string;
  technologies?: string[];
}

interface Props {
  items: ExperienceItem[];
  title?: string;
  subtitle?: string;
}

const {
  items,
  title = "Work Experience",
  subtitle = "Career milestones, leading systems architecture, and engineering high-impact digital solutions."
} = Astro.props as Props;
---

<section class="w-full py-4 sm:py-6 md:py-8">
  <div class="w-full">
    <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-8">
      {title && (
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-foreground">
          {title}
        </h2>
      )}
      {subtitle && (
        <p class="mt-3 text-base text-[var(--color-text-muted)]">
          {subtitle}
        </p>
      )}
    </div>

    <Timeline items={items} icons={workIcons} centered={false} />
  </div>
</section>
