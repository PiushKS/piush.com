      playClick();
      windowManager.tileWindows(true);
    });
    document.getElementById('ctx-t-tile-v')?.addEventListener('click', () => {
      closeAllContextMenus();
      playClick();
      windowManager.tileWindows(false);
    });
    document.getElementById('ctx-t-minimize-all')?.addEventListener('click', () => {
      closeAllContextMenus();
      playClick();
      windowManager.minimizeAll();
    });
    document.getElementById('ctx-t-taskmgr')?.addEventListener('click', () => {
      closeAllContextMenus();
      launchApp('taskmanager');
    });
    document.getElementById('ctx-t-properties')?.addEventListener('click', () => {
      closeAllContextMenus();
      displayDialog?.classList.remove('hidden');
    });

    // Start Button & Start Menu
    startBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      playClick();
      startMenu?.classList.toggle('hidden');
      startBtn.classList.toggle('is-active');
      closeAllContextMenus();
    });

    // Launch all data-app launcher buttons inside Start Menu & Desktop
    document.querySelectorAll('[data-app]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const appId = btn.getAttribute('data-app');
        if (appId) {
          launchApp(appId);
          startMenu?.classList.add('hidden');
          startBtn?.classList.remove('is-active');
          document.querySelectorAll('.win95-menu-parent').forEach(p => p.classList.remove('is-open'));
        }
      });
    });

    // Mobile touch handling for flyout submenus
    document.querySelectorAll('.win95-menu-parent > button').forEach((parentBtn) => {
      parentBtn.addEventListener('click', (e) => {
        if (window.innerWidth < 640) {
          e.stopPropagation();
          const parent = parentBtn.parentElement;
          if (parent) {
            parent.classList.toggle('is-open');
          }
        }
      });
    });

    // Start menu direct shortcuts
    smQuickRestore?.addEventListener('click', () => {
      startMenu?.classList.add('hidden');
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });
    taskbarAppBtn?.addEventListener('click', () => {
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });
    quickRestoreBtn?.addEventListener('click', () => {
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });
    smFavPortfolio?.addEventListener('click', () => {
      startMenu?.classList.add('hidden');
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });
    smInternetRestore?.addEventListener('click', () => {
      startMenu?.classList.add('hidden');
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });

    // Display Properties dialog controls
    smSettingsDisplay?.addEventListener('click', () => {
      startMenu?.classList.add('hidden');
      displayDialog?.classList.remove('hidden');
      playClick();
    });
    document.getElementById('display-props-close')?.addEventListener('click', () => {
      displayDialog?.classList.add('hidden');
      playClick();
    });
    document.getElementById('display-props-cancel')?.addEventListener('click', () => {
      displayDialog?.classList.add('hidden');
      playClick();
    });

    let selectedWallpaperTheme = localStorage.getItem('win95_desktop_wallpaper') || 'teal';
    const previewScreen = document.getElementById('display-preview-screen');

    function updatePreviewScreen(theme: string) {
      if (!previewScreen) return;
      if (theme === 'clouds') {
        previewScreen.style.backgroundColor = '#008080';
        previewScreen.style.backgroundImage = 'radial-gradient(circle at 50% 30%, #5dade2 0%, #2e86c1 50%, #1b4f72 100%)';
      } else if (theme === 'matrix') {
        previewScreen.style.backgroundColor = '#000000';
        previewScreen.style.backgroundImage = 'radial-gradient(#003300 15%, transparent 16%)';
        previewScreen.style.backgroundSize = '6px 6px';
      } else if (theme === 'stars') {
        previewScreen.style.backgroundColor = '#05051a';
        previewScreen.style.backgroundImage = 'radial-gradient(white 1px, transparent 1px)';
        previewScreen.style.backgroundSize = '8px 8px';
      } else if (theme === 'grid') {
        previewScreen.style.backgroundColor = '#004040';
        previewScreen.style.backgroundImage = 'linear-gradient(to right, cyan 1px, transparent 1px), linear-gradient(to bottom, cyan 1px, transparent 1px)';
        previewScreen.style.backgroundSize = '8px 8px';
      } else {
        previewScreen.style.backgroundColor = '#008080';
        previewScreen.style.backgroundImage = 'none';
      }
    }
    updatePreviewScreen(selectedWallpaperTheme);

    document.querySelectorAll('.wallpaper-opt-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        playClick();
        document.querySelectorAll('.wallpaper-opt-btn').forEach(b => b.classList.remove('bg-[#000080]', 'text-white'));
        btn.classList.add('bg-[#000080]', 'text-white');
        const wp = btn.getAttribute('data-wp') || 'teal';
        selectedWallpaperTheme = wp;
        updatePreviewScreen(wp);
      });
    });

    document.getElementById('display-props-apply')?.addEventListener('click', () => {
      playClick();
      localStorage.setItem('win95_desktop_wallpaper', selectedWallpaperTheme);
      applyDesktopWallpaper(selectedWallpaperTheme);
    });

    document.getElementById('display-props-ok')?.addEventListener('click', () => {
      playClick();
      localStorage.setItem('win95_desktop_wallpaper', selectedWallpaperTheme);
      applyDesktopWallpaper(selectedWallpaperTheme);
      displayDialog?.classList.add('hidden');
    });

    // Display dialog tabs
    document.querySelectorAll('.display-tab-btn').forEach((tabBtn) => {
      tabBtn.addEventListener('click', () => {
        playClick();
        document.querySelectorAll('.display-tab-btn').forEach(t => t.classList.remove('is-active'));
        tabBtn.classList.add('is-active');
        const tab = tabBtn.getAttribute('data-tab');

        const tabBg = document.getElementById('tab-content-background');
        const tabSs = document.getElementById('tab-content-screensaver');
        const tabAp = document.getElementById('tab-content-appearance');

        tabBg?.classList.toggle('hidden', tab !== 'background');
        tabSs?.classList.toggle('hidden', tab !== 'screensaver');
        tabAp?.classList.toggle('hidden', tab !== 'appearance');
      });
    });

    // Screen Saver Engine (Starfield)
    let screensaverAnimId: number | null = null;
    function runScreensaver() {
      if (!screensaverScreen) return;
      screensaverScreen.classList.remove('hidden');
      const canvas = document.getElementById('win95-screensaver-canvas') as HTMLCanvasElement | null;
      if (!canvas) return;

      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const numStars = 300;
      const stars: { x: number; y: number; z: number }[] = [];
      for (let i = 0; i < numStars; i++) {
        stars.push({
          x: (Math.random() - 0.5) * canvas.width * 2,
          y: (Math.random() - 0.5) * canvas.height * 2,
          z: Math.random() * canvas.width,
        });
      }

      function step() {
        if (!ctx || !canvas) return;
        ctx.fillStyle = '#000000';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const cx = canvas.width / 2;
        const cy = canvas.height / 2;

        for (const star of stars) {
          star.z -= 4;
          if (star.z <= 0) {
            star.z = canvas.width;
            star.x = (Math.random() - 0.5) * canvas.width * 2;
            star.y = (Math.random() - 0.5) * canvas.height * 2;
          }

          const k = 128.0 / star.z;
          const px = star.x * k + cx;
          const py = star.y * k + cy;

          if (px >= 0 && px < canvas.width && py >= 0 && py < canvas.height) {
            const size = Math.max(1, Math.min(3, (1 - star.z / canvas.width) * 3));
            const shade = Math.floor((1 - star.z / canvas.width) * 255);
            ctx.fillStyle = `rgb(${shade}, ${shade}, ${shade})`;
            ctx.fillRect(px, py, size, size);
          }
        }
        screensaverAnimId = requestAnimationFrame(step);
      }
      step();

      function closeScreensaver() {
        if (screensaverAnimId) cancelAnimationFrame(screensaverAnimId);
        screensaverScreen?.classList.add('hidden');
        window.removeEventListener('keydown', closeScreensaver);
        window.removeEventListener('mousemove', closeScreensaver);
        window.removeEventListener('click', closeScreensaver);
      }
      setTimeout(() => {
        window.addEventListener('keydown', closeScreensaver, { once: true });
        window.addEventListener('mousemove', closeScreensaver, { once: true });
        window.addEventListener('click', closeScreensaver, { once: true });
      }, 300);
    }

    document.getElementById('display-saver-preview-btn')?.addEventListener('click', runScreensaver);

    // Shut Down Dialog
    smShutdown?.addEventListener('click', () => {
      startMenu?.classList.add('hidden');
      startBtn?.classList.remove('is-active');
      shutdownDialog?.classList.remove('hidden');
      playClick();
    });

    document.getElementById('shutdown-dialog-close')?.addEventListener('click', () => {
      shutdownDialog?.classList.add('hidden');
      playClick();
    });
    document.getElementById('shutdown-btn-no')?.addEventListener('click', () => {
      shutdownDialog?.classList.add('hidden');
      playClick();
    });
    document.getElementById('shutdown-btn-help')?.addEventListener('click', () => {
      playClick();
      alert('Windows 95 Shutdown Help:\nSelect "Shut down the computer" to power down safely.\nSelect "Restart" to reboot.\nSelect "Restart in MS-DOS" for command-line.');
    });

    document.getElementById('shutdown-btn-yes')?.addEventListener('click', () => {
      shutdownDialog?.classList.add('hidden');
      const actionEl = document.querySelector('input[name="win95-shutdown-action"]:checked') as HTMLInputElement | null;
      const action = actionEl ? actionEl.value : 'shutdown';

      if (action === 'restore') {
        (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
      } else if (action === 'dos') {
        launchApp('dos');
      } else if (action === 'restart') {
        window.location.reload();
      } else {
        // Authentic Windows 95 Power Down sequence
        audio.playShutdown();
        if (safeOffScreen) {
          safeOffScreen.classList.remove('hidden');
          safeOffScreen.style.display = 'flex';
          const shutMsg = document.getElementById('win95-shutting-down-msg');
          const safeMsg = document.getElementById('win95-safe-to-turn-off');

          if (shutMsg) shutMsg.classList.remove('hidden');
          if (safeMsg) safeMsg.classList.add('hidden');

          setTimeout(() => {
            if (shutMsg) shutMsg.classList.add('hidden');
            if (safeMsg) safeMsg.classList.remove('hidden');
          }, 1800);
        }
      }
    });

    document.getElementById('win95-turn-on-btn')?.addEventListener('click', () => {
      if (safeOffScreen) safeOffScreen.style.display = 'none';
      window.location.reload();
    });

    // Volume Popup
    trayAudio?.addEventListener('click', (e) => {
      e.stopPropagation();
      playClick();
      volumePopup?.classList.toggle('hidden');
    });

    volumeSlider?.addEventListener('input', () => {
      const val = parseInt(volumeSlider.value, 10);
      if (volumeLabel) volumeLabel.textContent = val + '%';
      audio.setMasterVolume(val / 100);
    });

    volumeMute?.addEventListener('change', () => {
      audio.setSoundEnabled(!volumeMute.checked);
      if (trayAudio) {
        trayAudio.textContent = volumeMute.checked ? '🔇' : '🔊';
      }
    });

    // Sub-window controls
    notepadClose?.addEventListener('click', () => {
      playClick();
      notepadWindow?.classList.add('hidden');
    });
    notepadOkBtn?.addEventListener('click', () => {
      playClick();
      notepadWindow?.classList.add('hidden');
    });
    notepadRestoreBtn?.addEventListener('click', () => {
      notepadWindow?.classList.add('hidden');
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });

    networkClose?.addEventListener('click', () => {
      playClick();
      networkWindow?.classList.add('hidden');
    });

    recycleClose?.addEventListener('click', () => {
      playClick();
      recycleWindow?.classList.add('hidden');
    });
    recycleOkBtn?.addEventListener('click', () => {
      playClick();
      recycleWindow?.classList.add('hidden');
    });

    smDocReadme?.addEventListener('click', () => {
      startMenu?.classList.add('hidden');
      notepadWindow?.classList.remove('hidden');
    });

    smSettingsSysinfo?.addEventListener('click', () => {
      startMenu?.classList.add('hidden');
      const aboutDlg = document.getElementById('retro-about-dialog');
      if (aboutDlg) {
        aboutDlg.style.display = 'flex';
        aboutDlg.classList.remove('hidden');
        aboutDlg.classList.add('is-open');
      }
    });

    // Dismiss start menu & context menus on outside click
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!startBtn?.contains(target) && !startMenu?.contains(target)) {
        startMenu?.classList.add('hidden');
        startBtn?.classList.remove('is-active');
        document.querySelectorAll('.win95-menu-parent').forEach(p => p.classList.remove('is-open'));
      }
      if (!trayAudio?.contains(target) && !volumePopup?.contains(target)) {
        volumePopup?.classList.add('hidden');
      }
      closeAllContextMenus();
    });

    // Taskbar clock
    function updateClock() {
      const el = document.getElementById('win95-taskbar-clock');
      if (el) {
        el.textContent = new Date().toLocaleTimeString('en-US', { hour12: true, hour: 'numeric', minute: '2-digit' });
      }
    }
    updateClock();
    setInterval(updateClock, 1000);
  }

  setupWin95Desktop();
  document.addEventListener('astro:after-swap', setupWin95Desktop);
</script>
