---
// Windows 95 Desktop Screen (Shown on window close / minimize)
---

<div id="win95-desktop-screen" class="win95-desktop-screen" aria-hidden="true" role="region" aria-label="Windows 95 Desktop">
  <!-- Desktop Surface Area -->
  <div id="win95-desktop-surface" class="flex-1 w-full p-2 sm:p-4 overflow-auto relative select-none">
    <!-- Drag Selection Marquee -->
    <div id="win95-marquee" class="win95-marquee hidden"></div>

    <!-- Desktop Icons Grid (Vertical columns flow from left) -->
    <div id="win95-desktop-grid" class="flex flex-col flex-wrap content-start gap-1.5 max-h-[calc(100vh-50px)] max-w-full">
      <!-- Column 1: System & Core Shell -->
      <!-- 1. My Computer -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-computer"
        title="My Computer (System Properties)"
        tabindex="0"
        data-app="sysinfo"
        data-name="My Computer"
      >
        <img
          src="/images/windows-95-computer.svg"
          alt="My Computer"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">My Computer</span>
      </button>

      <!-- 2. Network Neighborhood -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-network"
        title="Network Neighborhood (Remote Links & Socials)"
        tabindex="0"
        data-app="network"
        data-name="Network Neighborhood"
      >
        <img
          src="/images/windows-95-network.svg"
          alt="Network Neighborhood"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Network Neighborhood</span>
      </button>

      <!-- 3. The Internet (Internet Explorer) -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-ie"
        title="The Internet (Internet Explorer)"
        tabindex="0"
        data-app="ie"
        data-name="The Internet"
      >
        <img
          src="/images/windows-95-ie.svg"
          alt="The Internet"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">The Internet</span>
      </button>

      <!-- 4. Recycle Bin -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-recycle"
        title="Recycle Bin"
        tabindex="0"
        data-name="Recycle Bin"
      >
        <img
          src="/images/windows-95-recycle-bin.svg"
          alt="Recycle Bin"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Recycle Bin</span>
      </button>

      <!-- 5. My Documents -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-documents"
        title="My Documents"
        tabindex="0"
        data-app="explorer"
        data-name="My Documents"
      >
        <img
          src="/images/windows-95-folder.svg"
          alt="My Documents"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">My Documents</span>
      </button>

      <!-- 6. The Microsoft Network (MSN) -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-msn"
        title="The Microsoft Network"
        tabindex="0"
        data-app="ie"
        data-name="The Microsoft Network"
      >
        <img
          src="/images/windows-95-msn.svg"
          alt="MSN"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">The Microsoft Network</span>
      </button>

      <!-- 7. Briefcase -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-briefcase"
        title="My Briefcase"
        tabindex="0"
        data-app="explorer"
        data-name="My Briefcase"
      >
        <img
          src="/images/windows-95-briefcase.svg"
          alt="My Briefcase"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">My Briefcase</span>
      </button>

      <!-- Column 2: Portfolio & Personal Documents -->
      <!-- 8. My Portfolio (Piush KS) -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-portfolio"
        title="Restore Portfolio Website"
        tabindex="0"
        data-name="My Portfolio"
      >
        <img
          src="/images/windows-95-rocket.svg"
          alt="My Portfolio"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">My Portfolio</span>
      </button>

      <!-- 9. README.TXT -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-notepad"
        title="Open README.TXT"
        tabindex="0"
        data-app="notepad"
        data-name="README.TXT"
      >
        <img
          src="/images/windows-95-notepad.svg"
          alt="README.TXT"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">README.TXT</span>
      </button>

      <!-- 10. ABOUT.TXT -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-about-txt"
        title="Open ABOUT.TXT in Notepad"
        tabindex="0"
        data-app="notepad"
        data-name="ABOUT.TXT"
      >
        <img
          src="/images/windows-95-notepad.svg"
          alt="ABOUT.TXT"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">ABOUT.TXT</span>
      </button>

      <!-- 11. Projects Shortcut -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-projects-lnk"
        title="Projects Folder Shortcut"
        tabindex="0"
        data-app="explorer"
        data-name="Projects.lnk"
      >
        <img
          src="/images/windows-95-folder.svg"
          alt="Projects.lnk"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Projects.lnk</span>
      </button>

      <!-- 12. Skills Document -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-skills-lnk"
        title="Skills Resume in WordPad"
        tabindex="0"
        data-app="wordpad"
        data-name="Skills.doc"
      >
        <img
          src="/images/windows-95-wordpad.svg"
          alt="Skills.doc"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Skills.doc</span>
      </button>

      <!-- 13. Developer Quiz -->
      <a
        href="/quiz/"
        class="win95-desktop-icon no-underline"
        id="d-icon-quiz"
        title="Open Developer Quiz (550 Questions)"
        data-name="Quiz.exe"
      >
        <div class="size-9 bg-[#000080] border border-black flex items-center justify-center text-white text-lg font-bold drop-shadow-[1px_1px_0px_#000000]">
          ⚡
        </div>
        <span class="win95-desktop-icon-label">Quiz.exe</span>
      </a>

      <!-- 14. Dev Tools -->
      <a
        href="/tools/"
        class="win95-desktop-icon no-underline"
        id="d-icon-tools"
        title="Open Developer Tools"
        data-name="Tools.exe"
      >
        <div class="size-9 bg-[#800080] border border-black flex items-center justify-center text-white text-lg font-bold drop-shadow-[1px_1px_0px_#000000]">
          🛠️
        </div>
        <span class="win95-desktop-icon-label">Tools.exe</span>
      </a>

      <!-- Column 3: Productivity, Utilities & Accessories -->
      <!-- 15. MS-DOS Prompt -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-dos"
        title="MS-DOS Prompt"
        tabindex="0"
        data-app="dos"
        data-name="MS-DOS Prompt"
      >
        <img
          src="/images/windows-95-dos.svg"
          alt="MS-DOS Prompt"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">MS-DOS Prompt</span>
      </button>

      <!-- 16. Notepad -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-app-notepad"
        title="Notepad Text Editor"
        tabindex="0"
        data-app="notepad"
        data-name="Notepad"
      >
        <img
          src="/images/windows-95-notepad.svg"
          alt="Notepad"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Notepad</span>
      </button>

      <!-- 17. WordPad -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-wordpad"
        title="WordPad Rich Text Editor"
        tabindex="0"
        data-app="wordpad"
        data-name="WordPad"
      >
        <img
          src="/images/windows-95-wordpad.svg"
          alt="WordPad"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">WordPad</span>
      </button>

      <!-- 18. Paint -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-paint"
        title="Paint Graphics Editor"
        tabindex="0"
        data-app="paint"
        data-name="Paint"
      >
        <img
          src="/images/windows-95-paint.svg"
          alt="Paint"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Paint</span>
      </button>

      <!-- 19. Calculator -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-calc"
        title="Calculator"
        tabindex="0"
        data-app="calculator"
        data-name="Calculator"
      >
        <img
          src="/images/windows-95-calc.svg"
          alt="Calculator"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Calculator</span>
      </button>

      <!-- 20. Control Panel -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-control"
        title="Control Panel"
        tabindex="0"
        data-app="controlpanel"
        data-name="Control Panel"
      >
        <img
          src="/images/windows-95-control-panel.svg"
          alt="Control Panel"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Control Panel</span>
      </button>

      <!-- 21. Media Player -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-media"
        title="Media Player"
        tabindex="0"
        data-app="mediaplayer"
        data-name="Media Player"
      >
        <img
          src="/images/windows-95-media-player.svg"
          alt="Media Player"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Media Player</span>
      </button>

      <!-- Column 4: Classic Games -->
      <!-- 22. 3D Pinball -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-pinball"
        title="3D Pinball - Space Cadet"
        tabindex="0"
        data-app="pinball"
        data-name="3D Pinball"
      >
        <img
          src="/images/windows-95-pinball.svg"
          alt="3D Pinball"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">3D Pinball</span>
      </button>

      <!-- 23. Minesweeper -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-minesweeper"
        title="Minesweeper"
        tabindex="0"
        data-app="minesweeper"
        data-name="Minesweeper"
      >
        <img
          src="/images/windows-95-mine.svg"
          alt="Minesweeper"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Minesweeper</span>
      </button>

      <!-- 24. Solitaire -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-solitaire"
        title="Solitaire"
        tabindex="0"
        data-app="solitaire"
        data-name="Solitaire"
      >
        <img
          src="/images/windows-95-solitaire.svg"
          alt="Solitaire"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Solitaire</span>
      </button>

      <!-- 25. FreeCell -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-freecell"
        title="FreeCell"
        tabindex="0"
        data-app="freecell"
        data-name="FreeCell"
      >
        <img
          src="/images/windows-95-freecell.svg"
          alt="FreeCell"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">FreeCell</span>
      </button>

      <!-- 26. Hearts -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-hearts"
        title="Hearts"
        tabindex="0"
        data-app="hearts"
        data-name="Hearts"
      >
        <img
          src="/images/windows-95-hearts.svg"
          alt="Hearts"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Hearts</span>
      </button>
    </div>

    <!-- Desktop Floating Helper Bubble -->
    <div class="absolute top-4 right-4 max-w-xs bg-[#ffffcc] border-2 border-black p-2.5 shadow-[4px_4px_0px_#000000] text-black font-mono text-xs hidden sm:block pointer-events-auto z-20">
      <div class="font-bold flex items-center gap-1.5 pb-1 border-b border-black/40">
        <span>💡 Windows 95 Desktop</span>
      </div>
      <p class="mt-1 text-[11px] leading-snug">
        The portfolio website has minimized to the desktop! Double-click <strong>"My Portfolio"</strong> or click the taskbar button below to restore the website.
      </p>
      <button
        type="button"
        id="d-quick-restore-btn"
        class="retro-btn !py-0.5 !px-2 !text-[10px] mt-2 font-bold w-full"
      >
        🗖 Restore Website Now
      </button>
    </div>

    <!-- Desktop Sub-Window: Notepad (README.TXT) Fallback/Quick View -->
    <div
      id="d-notepad-window"
      class="hidden absolute top-12 left-4 sm:left-32 w-[92vw] sm:w-[500px] bg-[#c0c0c0] border-2 border-white shadow-[6px_6px_0px_#000000] z-50 text-black font-mono"
    >
      <div class="retro-titlebar !h-7 !min-h-[28px] !px-2 flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-xs text-white truncate">
          <img src="/images/windows-95-notepad.svg" alt="Notepad" width="14" height="14" class="size-3.5" />
          <span>Notepad – README.TXT</span>
        </div>
        <button type="button" class="retro-titlebar-btn !w-4 !h-4 text-[10px]" id="d-notepad-close">&#10005;</button>
      </div>

      <div class="flex gap-3 px-2 py-0.5 text-xs bg-[#c0c0c0] border-b border-black/60">
        <span>File</span>
        <span>Edit</span>
        <span>Search</span>
        <span>Help</span>
      </div>

      <div class="p-2.5 bg-white text-black text-xs font-mono border-t border-black leading-relaxed whitespace-pre-wrap select-text max-h-[300px] overflow-auto">====================================================
PIUSH KS – SENIOR MOBILE & CLOUD ENGINEER
====================================================

Welcome to the Windows 95 Desktop environment!

HIGHLIGHTS:
- 8+ Years Engineering Production Systems
- Android (Kotlin, Jetpack Compose), iOS (Swift, SwiftUI)
- Cross-Platform Architecture (Flutter, Dart)
- High-Throughput Cloud & Distributed Backends
- 550+ Validated Interactive Quiz Challenges
- 7 In-Browser Developer Utilities

HOW TO RETURN:
Double-click "My Portfolio" or click the taskbar button below.
====================================================</div>

      <div class="p-2 bg-[#c0c0c0] border-t border-white flex justify-end gap-2">
        <button type="button" class="retro-btn !py-0.5 !px-3 !text-xs" id="d-notepad-restore-btn">
          🗖 Restore Website
        </button>
        <button type="button" class="retro-btn !py-0.5 !px-3 !text-xs font-bold" id="d-notepad-ok-btn">
          OK
        </button>
      </div>
    </div>

    <!-- Desktop Sub-Window: Network Neighborhood -->
    <div
      id="d-network-window"
      class="hidden absolute top-20 left-4 sm:left-40 w-[92vw] sm:w-[460px] bg-[#c0c0c0] border-2 border-white shadow-[6px_6px_0px_#000000] z-50 text-black font-mono"
    >
      <div class="retro-titlebar !h-7 !min-h-[28px] !px-2 flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-xs text-white truncate">
          <img src="/images/windows-95-network.svg" alt="Network" width="14" height="14" class="size-3.5" />
          <span>Network Neighborhood</span>
        </div>
        <button type="button" class="retro-titlebar-btn !w-4 !h-4 text-[10px]" id="d-network-close">&#10005;</button>
      </div>

      <div class="p-3 bg-[#c0c0c0] space-y-2">
        <p class="text-xs font-bold text-gray-800">Entire Network & Remote Servers:</p>
        <div class="retro-inset p-2 bg-white text-xs space-y-2">
          <a href="https://github.com/piushks" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\GITHUB\PiushKS (Source Code & Repos)</span>
          </a>
          <a href="https://linkedin.com/in/piushks/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\LINKEDIN\in\piushks (Professional Profile)</span>
          </a>
          <a href="https://x.com/piushks" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\TWITTER\@piushks (Dispatches & Updates)</span>
          </a>
          <a href="https://youtube.com/@PiushKS" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\YOUTUBE\@PiushKS (Tech & Tutorials)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Desktop Sub-Window: Recycle Bin -->
    <div
      id="d-recycle-window"
      class="hidden absolute top-28 left-4 sm:left-48 w-[90vw] sm:w-[380px] bg-[#c0c0c0] border-2 border-white shadow-[6px_6px_0px_#000000] z-50 text-black font-mono"
    >
      <div class="retro-titlebar !h-7 !min-h-[28px] !px-2 flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-xs text-white truncate">
          <img src="/images/windows-95-recycle-bin.svg" alt="Recycle Bin" width="14" height="14" class="size-3.5" />
          <span>Recycle Bin</span>
        </div>
        <button type="button" class="retro-titlebar-btn !w-4 !h-4 text-[10px]" id="d-recycle-close">&#10005;</button>
      </div>

      <div class="p-4 bg-[#c0c0c0] text-center space-y-3">
        <img src="/images/windows-95-recycle-bin.svg" alt="Empty Bin" width="40" height="40" class="mx-auto size-10" />
        <p class="text-xs font-bold text-black">The Recycle Bin is empty.</p>
        <p class="text-[11px] text-gray-700">0 objects (0 KB used). No bugs found in production!</p>
        <button type="button" class="retro-btn !py-0.5 !px-5 !text-xs font-bold" id="d-recycle-ok-btn">OK</button>
      </div>
    </div>
  </div>

  <!-- Windows 95 Classic Taskbar -->
  <footer id="win95-taskbar" class="win95-taskbar relative select-none">
    <!-- Left: Start Button -->
    <div class="flex items-center gap-1.5 shrink-0">
      <button
        type="button"
        id="win95-start-btn"
        class="win95-start-btn"
        aria-haspopup="true"
        aria-expanded="false"
        title="Start Menu"
      >
        <!-- 4-Color Windows Flag -->
        <span class="grid grid-cols-2 gap-0.5 p-0.5 bg-black/60">
          <span class="size-1.5 bg-[#e74c3c]"></span>
          <span class="size-1.5 bg-[#2ecc71]"></span>
          <span class="size-1.5 bg-[#3498db]"></span>
          <span class="size-1.5 bg-[#f1c40f]"></span>
        </span>
        <span>Start</span>
      </button>

      <!-- Taskbar Minimized App Button (Click to Restore) -->
      <button
        type="button"
        id="win95-taskbar-app-btn"
        class="win95-taskbar-item font-bold"
        title="Click to Restore Portfolio Website"
      >
        <img src="/images/windows-95-rocket.svg" alt="App" width="14" height="14" class="size-3.5 [image-rendering:pixelated]" />
        <span class="truncate">Piush KS – Mobile & Cloud Engineer</span>
