    });
    document.getElementById('ctx-i-rename')?.addEventListener('click', () => {
      closeAllContextMenus();
      if (!targetIconEl) return;
      const label = targetIconEl.querySelector('.win95-desktop-icon-label') as HTMLElement;
      if (label) {
