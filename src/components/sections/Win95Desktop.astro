      closeAllContextMenus();
      const name = targetIconEl?.getAttribute('data-name') || 'System Item';
      alert(`Properties for ${name}:\nType: System Application / Document\nLocation: C:\\PIUSH95\\DESKTOP\nAttributes: Read-Only`);
    });

    // Taskbar Context Menu actions
    document.getElementById('ctx-t-cascade')?.addEventListener('click', () => {
      closeAllContextMenus();
      playClick();
      windowManager.cascadeWindows();
    });
    document.getElementById('ctx-t-tile-h')?.addEventListener('click', () => {
