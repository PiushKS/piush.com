---
// Windows 95 Desktop Screen (Shown on window close / minimize)
---

<div id="win95-desktop-screen" class="win95-desktop-screen" aria-hidden="true" role="region" aria-label="Windows 95 Desktop">
  <!-- Desktop Surface Area -->
  <div class="flex-1 w-full p-3 sm:p-4 overflow-auto relative">
    <!-- Desktop Icons Grid (Left column) -->
    <div class="flex flex-col flex-wrap content-start gap-1 max-h-[calc(100vh-50px)]">
      <!-- 1. My Computer -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-computer"
        title="My Computer (System Properties)"
        tabindex="0"
      >
        <img
          src="/images/windows-95-computer.svg"
          alt="My Computer"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">My Computer</span>
      </button>

      <!-- 2. My Portfolio (Piush KS) -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-portfolio"
        title="Restore Portfolio Website"
        tabindex="0"
      >
        <img
          src="/images/windows-95-rocket.svg"
          alt="My Portfolio"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">My Portfolio</span>
      </button>

      <!-- 3. README.TXT (Notepad) -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-notepad"
        title="Open README.TXT in Notepad"
        tabindex="0"
        data-app="notepad"
      >
        <img
          src="/images/windows-95-notepad.svg"
          alt="README.TXT"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">README.TXT</span>
      </button>

      <!-- 4. Network Neighborhood -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-network"
        title="Network Neighborhood (Socials & GitHub)"
        tabindex="0"
        data-app="network"
      >
        <img
          src="/images/windows-95-network.svg"
          alt="Network Neighborhood"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Network Neighborhood</span>
      </button>

      <!-- 5. Recycle Bin -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-recycle"
        title="Recycle Bin"
        tabindex="0"
      >
        <img
          src="/images/windows-95-recycle-bin.svg"
          alt="Recycle Bin"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Recycle Bin</span>
      </button>

      <!-- 6. Developer Quiz -->
      <a
        href="/quiz/"
        class="win95-desktop-icon no-underline"
        id="d-icon-quiz"
        title="Open Developer Quiz (550 Questions)"
      >
        <div class="size-9 bg-[#000080] border border-black flex items-center justify-center text-white text-lg font-bold drop-shadow-[1px_1px_0px_#000000]">
          ⚡
        </div>
        <span class="win95-desktop-icon-label">Quiz.exe</span>
      </a>

      <!-- 7. Dev Tools -->
      <a
        href="/tools/"
        class="win95-desktop-icon no-underline"
        id="d-icon-tools"
        title="Open Developer Tools"
      >
        <div class="size-9 bg-[#800080] border border-black flex items-center justify-center text-white text-lg font-bold drop-shadow-[1px_1px_0px_#000000]">
          🛠️
        </div>
        <span class="win95-desktop-icon-label">Tools.exe</span>
      </a>

      <!-- 8. MS-DOS Prompt -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-dos"
        title="MS-DOS Prompt"
        tabindex="0"
        data-app="dos"
      >
        <div class="size-9 bg-black border border-white flex items-center justify-center text-[#00ff00] text-sm font-bold font-mono drop-shadow-[1px_1px_0px_#000000]">
          C:\&gt;
        </div>
        <span class="win95-desktop-icon-label">MS-DOS Prompt</span>
      </button>

      <!-- 9. 3D Pinball -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-pinball"
        title="3D Pinball - Space Cadet"
        tabindex="0"
        data-app="pinball"
      >
        <div class="size-9 bg-[#111133] border border-blue-400 flex items-center justify-center text-xl drop-shadow-[1px_1px_0px_#000000]">
          🚀
        </div>
        <span class="win95-desktop-icon-label">Pinball.exe</span>
      </button>

      <!-- 10. Minesweeper -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-minesweeper"
        title="Minesweeper"
        tabindex="0"
        data-app="minesweeper"
      >
        <div class="size-9 bg-[#c0c0c0] border border-black flex items-center justify-center text-xl drop-shadow-[1px_1px_0px_#000000]">
          💣
        </div>
        <span class="win95-desktop-icon-label">Minesweeper</span>
      </button>

      <!-- 11. Paint -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-paint"
        title="Paint"
        tabindex="0"
        data-app="paint"
      >
        <div class="size-9 bg-[#fff0f5] border border-black flex items-center justify-center text-xl drop-shadow-[1px_1px_0px_#000000]">
          🎨
        </div>
        <span class="win95-desktop-icon-label">Paint.exe</span>
      </button>

      <!-- 12. Media Player -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-media"
        title="Media Player"
        tabindex="0"
        data-app="mediaplayer"
      >
        <div class="size-9 bg-[#222222] border border-gray-400 flex items-center justify-center text-xl drop-shadow-[1px_1px_0px_#000000]">
          📼
        </div>
        <span class="win95-desktop-icon-label">Media Player</span>
      </button>
    </div>

    <!-- Desktop Floating Helper Bubble -->
    <div class="absolute top-4 right-4 max-w-xs bg-[#ffffcc] border-2 border-black p-2.5 shadow-[4px_4px_0px_#000000] text-black font-mono text-xs hidden sm:block">
      <div class="font-bold flex items-center gap-1.5 pb-1 border-b border-black/40">
        <span>💡 Windows 95 Desktop</span>
      </div>
      <p class="mt-1 text-[11px] leading-snug">
        The portfolio website has minimized to the desktop! Double-click <strong>"My Portfolio"</strong> or click the taskbar button below to restore the website.
      </p>
      <button
        type="button"
        id="d-quick-restore-btn"
        class="retro-btn !py-0.5 !px-2 !text-[10px] mt-2 font-bold w-full"
      >
        🗖 Restore Website Now
      </button>
    </div>

    <!-- Desktop Sub-Window: Notepad (README.TXT) Fallback/Quick View -->
    <div
      id="d-notepad-window"
      class="hidden absolute top-12 left-4 sm:left-32 w-[92vw] sm:w-[500px] bg-[#c0c0c0] border-2 border-white shadow-[6px_6px_0px_#000000] z-50 text-black font-mono"
    >
      <div class="retro-titlebar !h-7 !min-h-[28px] !px-2 flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-xs text-white truncate">
          <img src="/images/windows-95-notepad.svg" alt="Notepad" width="14" height="14" class="size-3.5" />
          <span>Notepad – README.TXT</span>
        </div>
        <button type="button" class="retro-titlebar-btn !w-4 !h-4 text-[10px]" id="d-notepad-close">&#10005;</button>
      </div>

      <div class="flex gap-3 px-2 py-0.5 text-xs bg-[#c0c0c0] border-b border-black/60">
        <span>File</span>
        <span>Edit</span>
        <span>Search</span>
        <span>Help</span>
      </div>

      <div class="p-2.5 bg-white text-black text-xs font-mono border-t border-black leading-relaxed whitespace-pre-wrap select-text max-h-[300px] overflow-auto">====================================================
PIUSH KS – SENIOR MOBILE & CLOUD ENGINEER
====================================================

Welcome to the Windows 95 Desktop environment!

HIGHLIGHTS:
- 8+ Years Engineering Production Systems
- Android (Kotlin, Jetpack Compose), iOS (Swift, SwiftUI)
- Cross-Platform Architecture (Flutter, Dart)
- High-Throughput Cloud & Distributed Backends
- 550+ Validated Interactive Quiz Challenges
- 7 In-Browser Developer Utilities

HOW TO RETURN:
Double-click "My Portfolio" or click the taskbar button below.
====================================================</div>

      <div class="p-2 bg-[#c0c0c0] border-t border-white flex justify-end gap-2">
        <button type="button" class="retro-btn !py-0.5 !px-3 !text-xs" id="d-notepad-restore-btn">
          🗖 Restore Website
        </button>
        <button type="button" class="retro-btn !py-0.5 !px-3 !text-xs font-bold" id="d-notepad-ok-btn">
          OK
        </button>
      </div>
    </div>

    <!-- Desktop Sub-Window: Network Neighborhood -->
    <div
      id="d-network-window"
      class="hidden absolute top-20 left-4 sm:left-40 w-[92vw] sm:w-[460px] bg-[#c0c0c0] border-2 border-white shadow-[6px_6px_0px_#000000] z-50 text-black font-mono"
    >
      <div class="retro-titlebar !h-7 !min-h-[28px] !px-2 flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-xs text-white truncate">
          <img src="/images/windows-95-network.svg" alt="Network" width="14" height="14" class="size-3.5" />
          <span>Network Neighborhood</span>
        </div>
        <button type="button" class="retro-titlebar-btn !w-4 !h-4 text-[10px]" id="d-network-close">&#10005;</button>
      </div>

      <div class="p-3 bg-[#c0c0c0] space-y-2">
        <p class="text-xs font-bold text-gray-800">Entire Network & Remote Servers:</p>
        <div class="retro-inset p-2 bg-white text-xs space-y-2">
          <a href="https://github.com/piushks" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\GITHUB\PiushKS (Source Code & Repos)</span>
          </a>
          <a href="https://linkedin.com/in/piushks/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\LINKEDIN\in\piushks (Professional Profile)</span>
          </a>
          <a href="https://x.com/piushks" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\TWITTER\@piushks (Dispatches & Updates)</span>
          </a>
          <a href="https://youtube.com/@PiushKS" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\YOUTUBE\@PiushKS (Tech & Tutorials)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Desktop Sub-Window: Recycle Bin -->
    <div
      id="d-recycle-window"
      class="hidden absolute top-28 left-4 sm:left-48 w-[90vw] sm:w-[380px] bg-[#c0c0c0] border-2 border-white shadow-[6px_6px_0px_#000000] z-50 text-black font-mono"
    >
      <div class="retro-titlebar !h-7 !min-h-[28px] !px-2 flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-xs text-white truncate">
          <img src="/images/windows-95-recycle-bin.svg" alt="Recycle Bin" width="14" height="14" class="size-3.5" />
          <span>Recycle Bin</span>
        </div>
        <button type="button" class="retro-titlebar-btn !w-4 !h-4 text-[10px]" id="d-recycle-close">&#10005;</button>
      </div>

      <div class="p-4 bg-[#c0c0c0] text-center space-y-3">
        <img src="/images/windows-95-recycle-bin.svg" alt="Empty Bin" width="40" height="40" class="mx-auto size-10" />
        <p class="text-xs font-bold text-black">The Recycle Bin is empty.</p>
        <p class="text-[11px] text-gray-700">0 objects (0 KB used). No bugs found in production!</p>
        <button type="button" class="retro-btn !py-0.5 !px-5 !text-xs font-bold" id="d-recycle-ok-btn">OK</button>
      </div>
    </div>
  </div>

  <!-- Windows 95 Classic Taskbar -->
  <footer class="win95-taskbar relative">
    <!-- Left: Start Button -->
    <div class="flex items-center gap-1.5 shrink-0">
      <button
        type="button"
        id="win95-start-btn"
        class="win95-start-btn"
        aria-haspopup="true"
        aria-expanded="false"
        title="Start Menu"
      >
        <!-- 4-Color Windows Flag -->
        <span class="grid grid-cols-2 gap-0.5 p-0.5 bg-black/60">
          <span class="size-1.5 bg-[#e74c3c]"></span>
          <span class="size-1.5 bg-[#2ecc71]"></span>
          <span class="size-1.5 bg-[#3498db]"></span>
          <span class="size-1.5 bg-[#f1c40f]"></span>
        </span>
        <span>Start</span>
      </button>

      <!-- Taskbar Minimized App Button (Click to Restore) -->
      <button
        type="button"
        id="win95-taskbar-app-btn"
        class="win95-taskbar-item font-bold"
        title="Click to Restore Portfolio Website"
      >
        <img src="/images/windows-95-rocket.svg" alt="App" width="14" height="14" class="size-3.5 [image-rendering:pixelated]" />
        <span class="truncate">Piush KS – Mobile & Cloud Engineer</span>
      </button>
    </div>

    <!-- Active Running Applications Container -->
    <div id="win95-running-apps" class="flex-1 flex items-center gap-1 overflow-x-auto px-1 max-w-[calc(100vw-320px)]"></div>

    <!-- Right: System Tray (Volume & Clock) -->
    <div class="flex items-center gap-1 shrink-0 ml-auto">
      <div class="retro-inset px-2 py-0.5 bg-[#c0c0c0] text-[11px] font-mono font-bold text-black flex items-center gap-1.5">
        <span title="Audio On" class="cursor-pointer" id="win95-tray-audio">🔊</span>
        <span id="win95-taskbar-clock">--:--:--</span>
      </div>
    </div>

    <!-- Windows 95 Start Menu Dropup Popup (Hierarchical Flyout) -->
    <div id="win95-start-menu" class="win95-start-menu hidden" role="menu">
      <div class="win95-start-banner">
        <span>WINDOWS 95</span>
      </div>

      <div class="flex-1 py-1 text-black font-mono text-xs flex flex-col justify-between">
        <div class="space-y-0.5">
          <!-- 1. Programs ▶ -->
          <div class="win95-menu-parent">
            <button type="button" class="retro-menu-item !py-1 w-full flex items-center justify-between" role="menuitem">
              <span class="flex items-center gap-2">
                <span>📁</span>
                <span class="font-bold">Programs</span>
              </span>
              <span class="text-[10px]">▶</span>
            </button>
            <div class="win95-submenu" role="menu">
              <!-- Accessories ▶ -->
              <div class="win95-menu-parent">
                <button type="button" class="retro-menu-item !py-1 w-full flex items-center justify-between">
                  <span class="flex items-center gap-2"><span>📁</span><span>Accessories</span></span>
                  <span class="text-[10px]">▶</span>
                </button>
                <div class="win95-submenu" role="menu">
                  <button type="button" class="retro-menu-item !py-1" data-app="notepad"><span>📝 Notepad</span></button>
                  <button type="button" class="retro-menu-item !py-1" data-app="wordpad"><span>📄 WordPad</span></button>
                  <button type="button" class="retro-menu-item !py-1" data-app="paint"><span>🎨 Paint</span></button>
                  <button type="button" class="retro-menu-item !py-1" data-app="calc"><span>🧮 Calculator</span></button>
                  <button type="button" class="retro-menu-item !py-1" data-app="charmap"><span>🔤 Character Map</span></button>
                  <button type="button" class="retro-menu-item !py-1" data-app="clipbrd"><span>📋 Clipboard Viewer</span></button>
                  <button type="button" class="retro-menu-item !py-1" data-app="addressbook"><span>📇 Address Book</span></button>
                  <button type="button" class="retro-menu-item !py-1" data-app="phonedialer"><span>☎️ Phone Dialer</span></button>

                  <div class="retro-menu-separator"></div>

                  <!-- Games ▶ -->
                  <div class="win95-menu-parent">
                    <button type="button" class="retro-menu-item !py-1 w-full flex items-center justify-between">
                      <span class="flex items-center gap-2"><span>🕹️</span><span>Games</span></span>
                      <span class="text-[10px]">▶</span>
                    </button>
                    <div class="win95-submenu" role="menu">
                      <button type="button" class="retro-menu-item !py-1" data-app="minesweeper"><span>💣 Minesweeper</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="solitaire"><span>🃏 Solitaire</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="freecell"><span>🎴 FreeCell</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="hearts"><span>♥️ Hearts</span></button>
                      <div class="retro-menu-separator"></div>
                      <!-- Bonus Games ▶ -->
                      <div class="win95-menu-parent">
                        <button type="button" class="retro-menu-item !py-1 w-full flex items-center justify-between">
                          <span class="flex items-center gap-2"><span>⭐</span><span>Bonus Games</span></span>
                          <span class="text-[10px]">▶</span>
                        </button>
                        <div class="win95-submenu" role="menu">
                          <button type="button" class="retro-menu-item !py-1" data-app="pinball"><span>🚀 3D Pinball</span></button>
                          <button type="button" class="retro-menu-item !py-1" data-app="snake"><span>🐍 Snake</span></button>
                          <button type="button" class="retro-menu-item !py-1" data-app="chess"><span>♟️ Chess</span></button>
                          <button type="button" class="retro-menu-item !py-1" data-app="brickbreaker"><span>🧱 Brick Breaker</span></button>
                          <button type="button" class="retro-menu-item !py-1" data-app="spacedefender"><span>👾 Space Defender</span></button>
                          <button type="button" class="retro-menu-item !py-1" data-app="tictactoe"><span>❌ Tic-Tac-Toe</span></button>
                          <button type="button" class="retro-menu-item !py-1" data-app="memorymatch"><span>🧠 Memory Match</span></button>
                          <button type="button" class="retro-menu-item !py-1" data-app="reversi"><span>⚪ Reversi</span></button>
                          <button type="button" class="retro-menu-item !py-1" data-app="t2048"><span>🔢 2048</span></button>
                          <button type="button" class="retro-menu-item !py-1" data-app="fallingblocks"><span>🧊 Falling Blocks</span></button>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Multimedia ▶ -->
                  <div class="win95-menu-parent">
                    <button type="button" class="retro-menu-item !py-1 w-full flex items-center justify-between">
                      <span class="flex items-center gap-2"><span>📼</span><span>Multimedia</span></span>
                      <span class="text-[10px]">▶</span>
                    </button>
                    <div class="win95-submenu" role="menu">
                      <button type="button" class="retro-menu-item !py-1" data-app="mediaplayer"><span>📼 Media Player</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="cdplayer"><span>💿 CD Player</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="soundrecorder"><span>🎙️ Sound Recorder</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="volume"><span>🔊 Volume Control</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="imageviewer"><span>🖼️ Image Viewer</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="midiplayer"><span>🎵 MIDI Player</span></button>
                    </div>
                  </div>

                  <!-- System Tools ▶ -->
                  <div class="win95-menu-parent">
                    <button type="button" class="retro-menu-item !py-1 w-full flex items-center justify-between">
                      <span class="flex items-center gap-2"><span>🛠️</span><span>System Tools</span></span>
                      <span class="text-[10px]">▶</span>
                    </button>
                    <div class="win95-submenu" role="menu">
                      <button type="button" class="retro-menu-item !py-1" data-app="controlpanel"><span>⚙️ Control Panel</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="scandisk"><span>🔍 ScanDisk</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="defrag"><span>📊 Disk Defragmenter</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="taskmanager"><span>📋 Task Manager</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="explorer"><span>🗂️ File Manager</span></button>
                    </div>
                  </div>

                  <!-- Communications ▶ -->
                  <div class="win95-menu-parent">
                    <button type="button" class="retro-menu-item !py-1 w-full flex items-center justify-between">
                      <span class="flex items-center gap-2"><span>📠</span><span>Communications</span></span>
                      <span class="text-[10px]">▶</span>
                    </button>
                    <div class="win95-submenu" role="menu">
                      <button type="button" class="retro-menu-item !py-1" data-app="hyperterminal"><span>💻 HyperTerminal</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="dialup"><span>📠 Dial-Up Networking</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="network"><span>🌐 Network Neighborhood</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="phonedialer"><span>☎️ Phone Dialer</span></button>
                    </div>
                  </div>

                  <!-- Accessibility ▶ -->
                  <div class="win95-menu-parent">
                    <button type="button" class="retro-menu-item !py-1 w-full flex items-center justify-between">
                      <span class="flex items-center gap-2"><span>♿</span><span>Accessibility</span></span>
                      <span class="text-[10px]">▶</span>
                    </button>
                    <div class="win95-submenu" role="menu">
                      <button type="button" class="retro-menu-item !py-1" data-app="accessibility"><span>♿ Accessibility Options</span></button>
                      <button type="button" class="retro-menu-item !py-1" data-app="magnifier"><span>🔎 Magnifier</span></button>
