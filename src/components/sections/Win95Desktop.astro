---
// Windows 95 Desktop Screen (Shown on window close / minimize)
---

<div id="win95-desktop-screen" class="win95-desktop-screen" aria-hidden="true" role="region" aria-label="Windows 95 Desktop">
  <!-- Desktop Surface Area -->
  <div class="flex-1 w-full p-3 sm:p-4 overflow-auto relative">
    <!-- Desktop Icons Grid (Left column) -->
    <div class="flex flex-col flex-wrap content-start gap-1 max-h-[calc(100vh-50px)]">
      <!-- 1. My Computer -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-computer"
        title="My Computer (System Properties)"
        tabindex="0"
      >
        <img
          src="/images/windows-95-computer.svg"
          alt="My Computer"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">My Computer</span>
      </button>

      <!-- 2. My Portfolio (Piush KS) -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-portfolio"
        title="Restore Portfolio Website"
        tabindex="0"
      >
        <img
          src="/images/windows-95-rocket.svg"
          alt="My Portfolio"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">My Portfolio</span>
      </button>

      <!-- 3. README.TXT -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-notepad"
        title="Open README.TXT"
        tabindex="0"
      >
        <img
          src="/images/windows-95-notepad.svg"
          alt="README.TXT"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">README.TXT</span>
      </button>

      <!-- 4. Network Neighborhood -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-network"
        title="Network Neighborhood (Socials & GitHub)"
        tabindex="0"
      >
        <img
          src="/images/windows-95-network.svg"
          alt="Network Neighborhood"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Network Neighborhood</span>
      </button>

      <!-- 5. Recycle Bin -->
      <button
        type="button"
        class="win95-desktop-icon"
        id="d-icon-recycle"
        title="Recycle Bin"
        tabindex="0"
      >
        <img
          src="/images/windows-95-recycle-bin.svg"
          alt="Recycle Bin"
          width="36"
          height="36"
          class="size-9 shrink-0 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#000000]"
        />
        <span class="win95-desktop-icon-label">Recycle Bin</span>
      </button>

      <!-- 6. Developer Quiz -->
      <a
        href="/quiz/"
        class="win95-desktop-icon no-underline"
        id="d-icon-quiz"
        title="Open Developer Quiz (550 Questions)"
      >
        <div class="size-9 bg-[#000080] border border-black flex items-center justify-center text-white text-lg font-bold drop-shadow-[1px_1px_0px_#000000]">
          ⚡
        </div>
        <span class="win95-desktop-icon-label">Quiz.exe</span>
      </a>

      <!-- 7. Dev Tools -->
      <a
        href="/tools/"
        class="win95-desktop-icon no-underline"
        id="d-icon-tools"
        title="Open Developer Tools"
      >
        <div class="size-9 bg-[#800080] border border-black flex items-center justify-center text-white text-lg font-bold drop-shadow-[1px_1px_0px_#000000]">
          🛠️
        </div>
        <span class="win95-desktop-icon-label">Tools.exe</span>
      </a>
    </div>

    <!-- Desktop Floating Helper Bubble -->
    <div class="absolute top-4 right-4 max-w-xs bg-[#ffffcc] border-2 border-black p-2.5 shadow-[4px_4px_0px_#000000] text-black font-mono text-xs hidden sm:block">
      <div class="font-bold flex items-center gap-1.5 pb-1 border-b border-black/40">
        <span>💡 Windows 95 Desktop</span>
      </div>
      <p class="mt-1 text-[11px] leading-snug">
        The portfolio window has minimized to the desktop! Double-click <strong>"My Portfolio"</strong> or click the taskbar button below to restore the website.
      </p>
      <button
        type="button"
        id="d-quick-restore-btn"
        class="retro-btn !py-0.5 !px-2 !text-[10px] mt-2 font-bold w-full"
      >
        🗖 Restore Website Now
      </button>
    </div>

    <!-- Desktop Sub-Window: Notepad (README.TXT) -->
    <div
      id="d-notepad-window"
      class="hidden absolute top-12 left-4 sm:left-32 w-[92vw] sm:w-[500px] bg-[#c0c0c0] border-2 border-white shadow-[6px_6px_0px_#000000] z-50 text-black font-mono"
    >
      <div class="retro-titlebar !h-7 !min-h-[28px] !px-2 flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-xs text-white truncate">
          <img src="/images/windows-95-notepad.svg" alt="Notepad" width="14" height="14" class="size-3.5" />
          <span>Notepad – README.TXT</span>
        </div>
        <button type="button" class="retro-titlebar-btn !w-4 !h-4 text-[10px]" id="d-notepad-close">&#10005;</button>
      </div>

      <!-- Menubar -->
      <div class="flex gap-3 px-2 py-0.5 text-xs bg-[#c0c0c0] border-b border-black/60">
        <span>File</span>
        <span>Edit</span>
        <span>Search</span>
        <span>Help</span>
      </div>

      <!-- Text Surface -->
      <div class="p-2.5 bg-white text-black text-xs font-mono border-t border-black leading-relaxed whitespace-pre-wrap select-text max-h-[300px] overflow-auto">====================================================
PIUSH KS – SENIOR MOBILE & CLOUD ENGINEER
====================================================

Welcome to the Windows 95 Desktop environment!

HIGHLIGHTS:
- 8+ Years Engineering Production Systems
- Android (Kotlin, Jetpack Compose), iOS (Swift, SwiftUI)
- Cross-Platform Architecture (Flutter, Dart)
- High-Throughput Cloud & Distributed Backends
- 550+ Validated Interactive Quiz Challenges
- 7 In-Browser Developer Utilities

HOW TO RETURN:
Double-click "My Portfolio" or click the taskbar button below.
====================================================</div>

      <div class="p-2 bg-[#c0c0c0] border-t border-white flex justify-end gap-2">
        <button type="button" class="retro-btn !py-0.5 !px-3 !text-xs" id="d-notepad-restore-btn">
          🗖 Restore Website
        </button>
        <button type="button" class="retro-btn !py-0.5 !px-3 !text-xs font-bold" id="d-notepad-ok-btn">
          OK
        </button>
      </div>
    </div>

    <!-- Desktop Sub-Window: Network Neighborhood -->
    <div
      id="d-network-window"
      class="hidden absolute top-20 left-4 sm:left-40 w-[92vw] sm:w-[460px] bg-[#c0c0c0] border-2 border-white shadow-[6px_6px_0px_#000000] z-50 text-black font-mono"
    >
      <div class="retro-titlebar !h-7 !min-h-[28px] !px-2 flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-xs text-white truncate">
          <img src="/images/windows-95-network.svg" alt="Network" width="14" height="14" class="size-3.5" />
          <span>Network Neighborhood</span>
        </div>
        <button type="button" class="retro-titlebar-btn !w-4 !h-4 text-[10px]" id="d-network-close">&#10005;</button>
      </div>

      <div class="p-3 bg-[#c0c0c0] space-y-2">
        <p class="text-xs font-bold text-gray-800">Entire Network & Remote Servers:</p>
        <div class="retro-inset p-2 bg-white text-xs space-y-2">
          <a href="https://github.com/piushks" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\GITHUB\PiushKS (Source Code & Repos)</span>
          </a>
          <a href="https://linkedin.com/in/piushks/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\LINKEDIN\in\piushks (Professional Profile)</span>
          </a>
          <a href="https://x.com/piushks" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\TWITTER\@piushks (Dispatches & Updates)</span>
          </a>
          <a href="https://youtube.com/@PiushKS" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-1 hover:bg-[#000080] hover:text-white text-black no-underline">
            <span>🌐</span>
            <span>\\YOUTUBE\@PiushKS (Tech & Tutorials)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Desktop Sub-Window: Recycle Bin -->
    <div
      id="d-recycle-window"
      class="hidden absolute top-28 left-4 sm:left-48 w-[90vw] sm:w-[380px] bg-[#c0c0c0] border-2 border-white shadow-[6px_6px_0px_#000000] z-50 text-black font-mono"
    >
      <div class="retro-titlebar !h-7 !min-h-[28px] !px-2 flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-xs text-white truncate">
          <img src="/images/windows-95-recycle-bin.svg" alt="Recycle Bin" width="14" height="14" class="size-3.5" />
          <span>Recycle Bin</span>
        </div>
        <button type="button" class="retro-titlebar-btn !w-4 !h-4 text-[10px]" id="d-recycle-close">&#10005;</button>
      </div>

      <div class="p-4 bg-[#c0c0c0] text-center space-y-3">
        <img src="/images/windows-95-recycle-bin.svg" alt="Empty Bin" width="40" height="40" class="mx-auto size-10" />
        <p class="text-xs font-bold text-black">The Recycle Bin is empty.</p>
        <p class="text-[11px] text-gray-700">0 objects (0 KB used). No bugs found in production!</p>
        <button type="button" class="retro-btn !py-0.5 !px-5 !text-xs font-bold" id="d-recycle-ok-btn">OK</button>
      </div>
    </div>
  </div>

  <!-- Windows 95 Classic Taskbar -->
  <footer class="win95-taskbar relative">
    <!-- Left: Start Button -->
    <div class="flex items-center gap-1.5">
      <button
        type="button"
        id="win95-start-btn"
        class="win95-start-btn"
        aria-haspopup="true"
        aria-expanded="false"
        title="Start Menu"
      >
        <!-- 4-Color Windows Flag -->
        <span class="grid grid-cols-2 gap-0.5 p-0.5 bg-black/60">
          <span class="size-1.5 bg-[#e74c3c]"></span>
          <span class="size-1.5 bg-[#2ecc71]"></span>
          <span class="size-1.5 bg-[#3498db]"></span>
          <span class="size-1.5 bg-[#f1c40f]"></span>
        </span>
        <span>Start</span>
      </button>

      <!-- Taskbar Minimized App Button (Click to Restore) -->
      <button
        type="button"
        id="win95-taskbar-app-btn"
        class="win95-taskbar-item font-bold"
        title="Click to Restore Portfolio Website"
      >
        <img src="/images/windows-95-rocket.svg" alt="App" width="14" height="14" class="size-3.5 [image-rendering:pixelated]" />
        <span class="truncate">Piush KS – Mobile & Cloud Engineer</span>
      </button>
    </div>

    <!-- Right: System Tray (Volume & Clock) -->
    <div class="flex items-center gap-1">
      <div class="retro-inset px-2 py-0.5 bg-[#c0c0c0] text-[11px] font-mono font-bold text-black flex items-center gap-1.5">
        <span title="Audio On">🔊</span>
        <span id="win95-taskbar-clock">--:--:--</span>
      </div>
    </div>

    <!-- Windows 95 Start Menu Dropup Popup -->
    <div id="win95-start-menu" class="win95-start-menu hidden" role="menu">
      <div class="win95-start-banner">
        <span>WINDOWS 95</span>
      </div>

      <div class="flex-1 py-1 text-black font-mono text-xs flex flex-col justify-between">
        <div class="space-y-0.5">
          <button type="button" class="retro-menu-item !py-1" id="sm-restore" role="menuitem">
            <span class="flex items-center gap-2">
              <span>🗖</span>
              <span class="font-bold">Restore Portfolio</span>
            </span>
          </button>
          <button type="button" class="retro-menu-item !py-1" id="sm-readme" role="menuitem">
            <span class="flex items-center gap-2">
              <span>📝</span>
              <span>README.TXT</span>
            </span>
          </button>
          <a href="/quiz/" class="retro-menu-item !py-1 text-black no-underline" role="menuitem">
            <span class="flex items-center gap-2">
              <span>⚡</span>
              <span>Developer Quiz</span>
            </span>
          </a>
          <a href="/tools/" class="retro-menu-item !py-1 text-black no-underline" role="menuitem">
            <span class="flex items-center gap-2">
              <span>🛠️</span>
              <span>Developer Tools</span>
            </span>
          </a>

          <div class="retro-menu-separator"></div>

          <button type="button" class="retro-menu-item !py-1" id="sm-about" role="menuitem">
            <span class="flex items-center gap-2">
              <span>ℹ️</span>
              <span>System Properties...</span>
            </span>
          </button>
          <button type="button" class="retro-menu-item !py-1" id="sm-boot" role="menuitem">
            <span class="flex items-center gap-2">
              <span>🔄</span>
              <span>Restart OS (Boot)...</span>
            </span>
          </button>
        </div>

        <div class="pt-1 border-t border-black/40">
          <button type="button" class="retro-menu-item !py-1 text-red-900 font-bold" id="sm-shutdown" role="menuitem">
            <span class="flex items-center gap-2">
              <span>🛑</span>
              <span>Restore Website</span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </footer>
</div>

<script>
  // Windows 95 Desktop Screen & Taskbar Controller
  function setupWin95Desktop() {
    const desktopScreen = document.getElementById('win95-desktop-screen');
    // Ensure desktop screen lives at document.body level so it's a sibling of .retro-window
    if (desktopScreen && desktopScreen.parentElement !== document.body) {
      document.body.appendChild(desktopScreen);
    }

    const startBtn = document.getElementById('win95-start-btn');
    const startMenu = document.getElementById('win95-start-menu');
    const taskbarAppBtn = document.getElementById('win95-taskbar-app-btn');
    const quickRestoreBtn = document.getElementById('d-quick-restore-btn');

    // Desktop icons
    const iconComputer = document.getElementById('d-icon-computer');
    const iconPortfolio = document.getElementById('d-icon-portfolio');
    const iconNotepad = document.getElementById('d-icon-notepad');
    const iconNetwork = document.getElementById('d-icon-network');
    const iconRecycle = document.getElementById('d-icon-recycle');

    // Sub-windows
    const notepadWindow = document.getElementById('d-notepad-window');
    const notepadClose = document.getElementById('d-notepad-close');
    const notepadOkBtn = document.getElementById('d-notepad-ok-btn');
    const notepadRestoreBtn = document.getElementById('d-notepad-restore-btn');

    const networkWindow = document.getElementById('d-network-window');
    const networkClose = document.getElementById('d-network-close');

    const recycleWindow = document.getElementById('d-recycle-window');
    const recycleClose = document.getElementById('d-recycle-close');
    const recycleOkBtn = document.getElementById('d-recycle-ok-btn');

    // Start menu items
    const smRestore = document.getElementById('sm-restore');
    const smShutdown = document.getElementById('sm-shutdown');
    const smReadme = document.getElementById('sm-readme');
    const smAbout = document.getElementById('sm-about');
    const smBoot = document.getElementById('sm-boot');

    function playSound(type = 'click') {
      if (localStorage.getItem('retro_sound_enabled') === 'false') return;
      try {
        const AudioClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (!AudioClass) return;
        const ctx = new AudioClass();
        if (ctx.state === 'suspended') ctx.resume();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        if (type === 'minimize') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(600, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(150, ctx.currentTime + 0.08);
          gain.gain.setValueAtTime(0.12, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime);
          osc.stop(ctx.currentTime + 0.08);
        } else if (type === 'restore') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(200, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(750, ctx.currentTime + 0.08);
          gain.gain.setValueAtTime(0.12, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime);
          osc.stop(ctx.currentTime + 0.08);
        } else {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(800, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(250, ctx.currentTime + 0.04);
          gain.gain.setValueAtTime(0.1, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.04);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime);
          osc.stop(ctx.currentTime + 0.04);
        }
      } catch (_) {}
    }

    // Expose global minimize / restore functions
    (window as unknown as { minimizeToDesktop?: () => void }).minimizeToDesktop = function () {
      playSound('minimize');
      document.body.classList.add('is-desktop-minimized');
      if (desktopScreen) {
        desktopScreen.style.display = 'flex';
        desktopScreen.setAttribute('aria-hidden', 'false');
      }
      window.scrollTo({ top: 0 });
    };

    (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop = function () {
      playSound('restore');
      document.body.classList.remove('is-desktop-minimized');
      if (desktopScreen) {
        desktopScreen.style.display = 'none';
        desktopScreen.setAttribute('aria-hidden', 'true');
      }
      if (startMenu) startMenu.classList.add('hidden');
    };

    // Close / restore triggers
    taskbarAppBtn?.addEventListener('click', () => {
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });
    quickRestoreBtn?.addEventListener('click', () => {
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });
    iconPortfolio?.addEventListener('click', () => {
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });
    iconPortfolio?.addEventListener('dblclick', () => {
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });
    smRestore?.addEventListener('click', () => {
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });
    smShutdown?.addEventListener('click', () => {
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });
    notepadRestoreBtn?.addEventListener('click', () => {
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
    });

    // Toggle Start Menu
    startBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      playSound('click');
      startMenu?.classList.toggle('hidden');
      startBtn.classList.toggle('is-active');
    });

    // Sub-window handlers
    iconNotepad?.addEventListener('click', () => {
      playSound('click');
      notepadWindow?.classList.remove('hidden');
    });
    notepadClose?.addEventListener('click', () => {
      playSound('click');
      notepadWindow?.classList.add('hidden');
    });
    notepadOkBtn?.addEventListener('click', () => {
      playSound('click');
      notepadWindow?.classList.add('hidden');
    });
    smReadme?.addEventListener('click', () => {
      startMenu?.classList.add('hidden');
      notepadWindow?.classList.remove('hidden');
    });

    iconNetwork?.addEventListener('click', () => {
      playSound('click');
      networkWindow?.classList.remove('hidden');
    });
    networkClose?.addEventListener('click', () => {
      playSound('click');
      networkWindow?.classList.add('hidden');
    });

    iconRecycle?.addEventListener('click', () => {
      playSound('click');
      recycleWindow?.classList.remove('hidden');
    });
    recycleClose?.addEventListener('click', () => {
      playSound('click');
      recycleWindow?.classList.add('hidden');
    });
    recycleOkBtn?.addEventListener('click', () => {
      playSound('click');
      recycleWindow?.classList.add('hidden');
    });

    iconComputer?.addEventListener('click', () => {
      playSound('click');
      const aboutDlg = document.getElementById('retro-about-dialog');
      if (aboutDlg) {
        aboutDlg.style.display = 'flex';
        aboutDlg.classList.remove('hidden');
        aboutDlg.classList.add('is-open');
      }
    });

    smAbout?.addEventListener('click', () => {
      startMenu?.classList.add('hidden');
      const aboutDlg = document.getElementById('retro-about-dialog');
      if (aboutDlg) {
        aboutDlg.style.display = 'flex';
        aboutDlg.classList.remove('hidden');
        aboutDlg.classList.add('is-open');
      }
    });

    smBoot?.addEventListener('click', () => {
      startMenu?.classList.add('hidden');
      (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
      setTimeout(() => {
        (window as unknown as { triggerWin95Boot?: () => void }).triggerWin95Boot?.();
      }, 50);
    });

    // Close start menu on outside click
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!startBtn?.contains(target) && !startMenu?.contains(target)) {
        startMenu?.classList.add('hidden');
        startBtn?.classList.remove('is-active');
      }
    });

    // Taskbar clock
    function updateClock() {
      const el = document.getElementById('win95-taskbar-clock');
      if (el) {
        el.textContent = new Date().toLocaleTimeString('en-US', { hour12: true, hour: 'numeric', minute: '2-digit' });
      }
    }
    updateClock();
    setInterval(updateClock, 1000);
  }

  setupWin95Desktop();
  document.addEventListener('astro:after-swap', setupWin95Desktop);
</script>
