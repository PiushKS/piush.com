</div>

<script>
  import { launchApp } from '../../lib/win95/appRegistry';
  import { windowManager } from '../../lib/win95/windowManager';
  import { audio } from '../../lib/win95/audio';

  function setupWin95Desktop() {
    const desktopScreen = document.getElementById('win95-desktop-screen');
    if (desktopScreen && desktopScreen.parentElement !== document.body) {
      document.body.appendChild(desktopScreen);
    }

    const surface = document.getElementById('win95-desktop-surface');
    const startBtn = document.getElementById('win95-start-btn');
    const startMenu = document.getElementById('win95-start-menu');
    const taskbarAppBtn = document.getElementById('win95-taskbar-app-btn');
    const quickRestoreBtn = document.getElementById('d-quick-restore-btn');
    const smQuickRestore = document.getElementById('sm-quick-restore');
    const smShutdown = document.getElementById('sm-shutdown');
    const smDocReadme = document.getElementById('sm-doc-readme');
    const smFavPortfolio = document.getElementById('sm-fav-portfolio');
    const smInternetRestore = document.getElementById('sm-internet-restore');
    const smSettingsSysinfo = document.getElementById('sm-settings-sysinfo');
    const smSettingsDisplay = document.getElementById('sm-settings-display');

    // Context menus
    const desktopCtx = document.getElementById('win95-desktop-ctx-menu');
    const iconCtx = document.getElementById('win95-icon-ctx-menu');
    const taskbarCtx = document.getElementById('win95-taskbar-ctx-menu');
    let targetIconEl: HTMLElement | null = null;

    // Sub-windows
    const notepadWindow = document.getElementById('d-notepad-window');
    const notepadClose = document.getElementById('d-notepad-close');
    const notepadOkBtn = document.getElementById('d-notepad-ok-btn');
    const notepadRestoreBtn = document.getElementById('d-notepad-restore-btn');
    const networkWindow = document.getElementById('d-network-window');
    const networkClose = document.getElementById('d-network-close');
    const recycleWindow = document.getElementById('d-recycle-window');
    const recycleClose = document.getElementById('d-recycle-close');
    const recycleOkBtn = document.getElementById('d-recycle-ok-btn');

    // Dialogs
    const displayDialog = document.getElementById('win95-display-props-dialog');
    const shutdownDialog = document.getElementById('win95-shutdown-dialog');
    const safeOffScreen = document.getElementById('win95-safe-off-screen');
    const screensaverScreen = document.getElementById('win95-screensaver-screen');

    // Volume popup & controls
    const trayAudio = document.getElementById('win95-tray-audio');
    const volumePopup = document.getElementById('win95-volume-popup');
    const volumeSlider = document.getElementById('win95-volume-slider') as HTMLInputElement | null;
    const volumeLabel = document.getElementById('win95-volume-label');
    const volumeMute = document.getElementById('win95-volume-mute') as HTMLInputElement | null;

    // Apply saved master volume
    const currentVol = Math.round(audio.getMasterVolume() * 100);
    if (volumeSlider) volumeSlider.value = String(currentVol);
    if (volumeLabel) volumeLabel.textContent = currentVol + '%';
    if (volumeMute) volumeMute.checked = !audio.isSoundEnabled();

    // Sound wrapper
    function playClick() {
      audio.playClick();
    }

    // Expose global minimize / restore functions
    (window as unknown as { minimizeToDesktop?: () => void }).minimizeToDesktop = function () {
      try { audio.playMinimize(); } catch (_) {}

      // Cleanly dismiss any open modal dialogs
      const aboutDlg = document.getElementById('retro-about-dialog');
      if (aboutDlg) {
        aboutDlg.style.display = 'none';
        aboutDlg.classList.add('hidden');
        aboutDlg.classList.remove('is-open');
      }
      displayDialog?.classList.add('hidden');
      shutdownDialog?.classList.add('hidden');
      closeAllContextMenus();

      document.body.classList.add('is-desktop-minimized');
      if (desktopScreen) {
        desktopScreen.style.display = 'flex';
        desktopScreen.setAttribute('aria-hidden', 'false');
      }
      applyDesktopWallpaper();
      window.scrollTo({ top: 0 });
      windowManager.updateTaskbar();
    };

    (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop = function () {
      audio.playRestore();
      document.body.classList.remove('is-desktop-minimized');
      if (desktopScreen) {
        desktopScreen.style.display = 'none';
        desktopScreen.setAttribute('aria-hidden', 'true');
      }
      closeAllContextMenus();
      if (startMenu) startMenu.classList.add('hidden');
    };

    function closeAllContextMenus() {
      desktopCtx?.classList.add('hidden');
      iconCtx?.classList.add('hidden');
      taskbarCtx?.classList.add('hidden');
      volumePopup?.classList.add('hidden');
    }

    // Wallpaper Engine
    function applyDesktopWallpaper(themeName?: string) {
      if (!desktopScreen) return;
      const theme = themeName || localStorage.getItem('win95_desktop_wallpaper') || 'teal';
      desktopScreen.style.backgroundRepeat = 'repeat';
      desktopScreen.style.backgroundSize = 'auto';

      if (theme === 'clouds') {
        desktopScreen.style.backgroundColor = '#008080';
        desktopScreen.style.backgroundImage = 'radial-gradient(circle at 50% 30%, #5dade2 0%, #2e86c1 50%, #1b4f72 100%)';
      } else if (theme === 'matrix') {
        desktopScreen.style.backgroundColor = '#000000';
        desktopScreen.style.backgroundImage = 'radial-gradient(#003300 15%, transparent 16%), radial-gradient(#004400 15%, transparent 16%)';
        desktopScreen.style.backgroundSize = '16px 16px';
        desktopScreen.style.backgroundPosition = '0 0, 8px 8px';
      } else if (theme === 'stars') {
        desktopScreen.style.backgroundColor = '#05051a';
        desktopScreen.style.backgroundImage = 'radial-gradient(white 1px, transparent 1px), radial-gradient(white 1px, transparent 1px)';
        desktopScreen.style.backgroundSize = '32px 32px';
        desktopScreen.style.backgroundPosition = '0 0, 16px 16px';
      } else if (theme === 'grid') {
        desktopScreen.style.backgroundColor = '#004040';
        desktopScreen.style.backgroundImage = 'linear-gradient(to right, rgba(0,255,255,0.15) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,255,255,0.15) 1px, transparent 1px)';
        desktopScreen.style.backgroundSize = '24px 24px';
      } else if (theme === 'custom') {
        const customImg = localStorage.getItem('win95_desktop_wallpaper_custom');
        if (customImg) {
          desktopScreen.style.backgroundImage = `url("${customImg}")`;
          desktopScreen.style.backgroundSize = 'cover';
          desktopScreen.style.backgroundRepeat = 'no-repeat';
        } else {
          desktopScreen.style.backgroundColor = '#008080';
          desktopScreen.style.backgroundImage = 'none';
        }
      } else {
        desktopScreen.style.backgroundColor = '#008080';
        desktopScreen.style.backgroundImage = 'none';
      }
    }

    applyDesktopWallpaper();

    // Rubberband Drag Selection Marquee
    const marquee = document.getElementById('win95-marquee');
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;

    surface?.addEventListener('mousedown', (e) => {
      const target = e.target as HTMLElement;
      // Close context menus
      closeAllContextMenus();

      if (e.button !== 0) return; // only left click
      if (target.closest('.win95-desktop-icon') || target.closest('.retro-dialog-window') || target.closest('#d-notepad-window') || target.closest('#d-network-window') || target.closest('#d-recycle-window')) {
        return;
      }

      // Clear selections if not holding Ctrl
      if (!e.ctrlKey && !e.metaKey) {
        document.querySelectorAll('.win95-desktop-icon.is-selected').forEach((el) => {
          el.classList.remove('is-selected');
        });
      }

      isDragging = true;
      const rect = surface.getBoundingClientRect();
      dragStartX = e.clientX - rect.left;
      dragStartY = e.clientY - rect.top;

      if (marquee) {
        marquee.style.left = `${dragStartX}px`;
        marquee.style.top = `${dragStartY}px`;
        marquee.style.width = '0px';
        marquee.style.height = '0px';
        marquee.classList.remove('hidden');
      }
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging || !surface || !marquee) return;
      const rect = surface.getBoundingClientRect();
      const currentX = e.clientX - rect.left;
      const currentY = e.clientY - rect.top;

      const left = Math.min(dragStartX, currentX);
      const top = Math.min(dragStartY, currentY);
      const width = Math.abs(currentX - dragStartX);
      const height = Math.abs(currentY - dragStartY);

      marquee.style.left = `${left}px`;
      marquee.style.top = `${top}px`;
      marquee.style.width = `${width}px`;
      marquee.style.height = `${height}px`;

      const mRect = { left, top, right: left + width, bottom: top + height };

      // Collision test with icons
      document.querySelectorAll('.win95-desktop-icon').forEach((icon) => {
        const iRect = (icon as HTMLElement).getBoundingClientRect();
        const relativeIRect = {
          left: iRect.left - rect.left,
          top: iRect.top - rect.top,
          right: iRect.right - rect.left,
          bottom: iRect.bottom - rect.top,
        };

        const overlaps = !(
          mRect.right < relativeIRect.left ||
          mRect.left > relativeIRect.right ||
          mRect.bottom < relativeIRect.top ||
          mRect.top > relativeIRect.bottom
        );

        if (overlaps) {
          icon.classList.add('is-selected');
        } else if (!e.ctrlKey && !e.metaKey) {
          icon.classList.remove('is-selected');
        }
      });
    });

    document.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        marquee?.classList.add('hidden');
      }
    });

    function activateIcon(el: HTMLElement) {
      playClick();
      const appId = el.getAttribute('data-app');
      const iconId = el.id;

      if (iconId === 'd-icon-portfolio') {
        (window as unknown as { restoreFromDesktop?: () => void }).restoreFromDesktop?.();
      } else if (iconId === 'd-icon-recycle') {
        recycleWindow?.classList.remove('hidden');
      } else if (iconId === 'd-icon-notepad' || iconId === 'd-icon-about-txt') {
        launchApp('notepad');
      } else if (iconId === 'd-icon-computer') {
        const aboutDlg = document.getElementById('retro-about-dialog');
        if (aboutDlg) {
          aboutDlg.style.display = 'flex';
          aboutDlg.classList.remove('hidden');
          aboutDlg.classList.add('is-open');
        }
      } else if (appId) {
        launchApp(appId);
      }
    }

    // Icon click, double-click, touch & keyboard interactions
    document.querySelectorAll('.win95-desktop-icon').forEach((icon) => {
      const el = icon as HTMLElement;
      let lastTapTime = 0;

      el.addEventListener('click', (e) => {
        e.stopPropagation();
        closeAllContextMenus();
        const now = Date.now();
        const isQuickTap = now - lastTapTime < 450;
        const wasSelected = el.classList.contains('is-selected');

        if (!e.ctrlKey && !e.metaKey) {
          document.querySelectorAll('.win95-desktop-icon.is-selected').forEach((item) => {
            if (item !== el) item.classList.remove('is-selected');
          });
        }

        if (isQuickTap || wasSelected) {
          activateIcon(el);
          lastTapTime = 0;
          return;
        }

        lastTapTime = now;
        el.classList.add('is-selected');
        playClick();
      });

      el.addEventListener('dblclick', (e) => {
        e.stopPropagation();
        activateIcon(el);
      });

      el.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          activateIcon(el);
        }
      });

      // Context menu for icons
      el.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeAllContextMenus();

        targetIconEl = el;
        document.querySelectorAll('.win95-desktop-icon.is-selected').forEach((item) => item.classList.remove('is-selected'));
        el.classList.add('is-selected');

        if (iconCtx) {
          iconCtx.style.left = `${Math.min(e.clientX, window.innerWidth - 170)}px`;
          iconCtx.style.top = `${Math.min(e.clientY, window.innerHeight - 200)}px`;
          iconCtx.classList.remove('hidden');
        }
      });
    });

    // Desktop surface context menu
    surface?.addEventListener('contextmenu', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.win95-desktop-icon') || target.closest('.retro-dialog-window')) return;
      e.preventDefault();
      closeAllContextMenus();

      if (desktopCtx) {
        desktopCtx.style.left = `${Math.min(e.clientX, window.innerWidth - 170)}px`;
        desktopCtx.style.top = `${Math.min(e.clientY, window.innerHeight - 240)}px`;
        desktopCtx.classList.remove('hidden');
      }
    });

    // Taskbar context menu
    const taskbar = document.getElementById('win95-taskbar');
    taskbar?.addEventListener('contextmenu', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('#win95-start-btn') || target.closest('#win95-start-menu')) return;
      e.preventDefault();
      closeAllContextMenus();

      if (taskbarCtx) {
        taskbarCtx.style.left = `${Math.min(e.clientX, window.innerWidth - 170)}px`;
        taskbarCtx.style.top = `${Math.max(10, window.innerHeight - 200)}px`;
        taskbarCtx.classList.remove('hidden');
      }
    });

    // Desktop Context Menu actions
    document.getElementById('ctx-d-refresh')?.addEventListener('click', () => {
      closeAllContextMenus();
      playClick();
      applyDesktopWallpaper();
    });
    document.getElementById('ctx-d-lineup')?.addEventListener('click', () => {
      closeAllContextMenus();
      playClick();
    });
    document.getElementById('ctx-d-new-txt')?.addEventListener('click', () => {
      closeAllContextMenus();
      launchApp('notepad');
    });
    document.getElementById('ctx-d-new-folder')?.addEventListener('click', () => {
      closeAllContextMenus();
      launchApp('explorer');
    });
    document.getElementById('ctx-d-properties')?.addEventListener('click', () => {
      closeAllContextMenus();
      playClick();
      displayDialog?.classList.remove('hidden');
    });

    // Icon Context Menu actions
    document.getElementById('ctx-i-open')?.addEventListener('click', () => {
      closeAllContextMenus();
      if (targetIconEl) {
        targetIconEl.dispatchEvent(new MouseEvent('dblclick', { bubbles: true }));
      }
    });
    document.getElementById('ctx-i-explore')?.addEventListener('click', () => {
      closeAllContextMenus();
      launchApp('explorer');
    });
    document.getElementById('ctx-i-delete')?.addEventListener('click', () => {
      closeAllContextMenus();
      audio.playChord();
