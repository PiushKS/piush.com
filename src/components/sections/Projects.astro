---
import Button from "../ui/button/Button.astro";
import { projects } from "../../data/projects";

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Featured Projects & Architecture",
  subtitle = "Selected open-source kits, mobile applications, orchestrations, and full-stack systems."
} = Astro.props as Props;
---

<section class="w-full py-4 sm:py-6 md:py-8">
  <div class="w-full">
    <div class="mb-6 sm:mb-8">
      <div class="flex items-center gap-3 mb-2">
        <span class="retro-info-bubble">i</span>
        {title && (
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-[#0057CC] m-0 uppercase font-mono">
            {title}
          </h2>
        )}
      </div>
      {subtitle && (
        <p class="text-sm sm:text-base text-gray-700 font-mono pl-11 m-0">
          {subtitle}
        </p>
      )}
    </div>

    <!-- Bento Grid Project Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {projects.map((p) => {
        const stackList = p.techStack ? p.techStack.split('•').map(s => s.trim()) : [];
        return (
          <article class="bg-white border-2 border-black p-5 sm:p-6 shadow-[4px_4px_0px_#000000] flex flex-col justify-between group transition-transform duration-100 hover:-translate-x-0.5 hover:-translate-y-0.5">
            <div>
              <!-- Header Row with Title & Brand Icon -->
              <div class="flex items-start justify-between gap-4 mb-3">
                <h3 class="text-lg sm:text-xl font-bold text-black m-0 leading-snug font-mono">
                  {p.title}
                </h3>
                <div
                  class="size-10 bg-[#E8EEF5] border-2 border-black text-[#0057CC] flex items-center justify-center shrink-0 shadow-[2px_2px_0px_#000000] [&>svg]:size-5"
                  set:html={p.icon}
                />
              </div>

              <!-- Tech Stack Pills -->
              <div class="flex flex-wrap gap-1.5 mb-4">
                {stackList.map((item) => (
                  <span class="tech-chip text-[0.7rem] px-2 py-0.5 border border-black bg-[#F4F4F4] font-mono text-black">
                    {item}
                  </span>
                ))}
              </div>

              <!-- Description -->
              <p class="text-xs sm:text-sm text-gray-800 leading-relaxed m-0 font-sans">
                {p.description}
              </p>
            </div>

            <!-- Action Button -->
            <div class="mt-6 pt-4 border-t-2 border-black flex items-center justify-between">
              <Button href={p.ctaLink} variant="secondary" size="sm" class="btn-interactive">
                <span>{p.ctaText.replace('→', '').trim()}</span>
                <span class="font-mono ml-1 font-bold">»</span>
              </Button>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
