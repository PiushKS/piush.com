---
import Button from "../ui/button/Button.astro";
import { projects } from "../../data/projects";

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Featured Projects & Architecture",
  subtitle = "Selected open-source kits, mobile applications, orchestrations, and full-stack systems."
} = Astro.props as Props;
---

<section class="w-full py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-12">
      {title && (
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-foreground">
          {title}
        </h2>
      )}
      {subtitle && (
        <p class="mt-3 text-base text-[var(--color-text-muted)]">
          {subtitle}
        </p>
      )}
    </div>

    <!-- Bento Grid Project Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {projects.map((p) => {
        const stackList = p.techStack ? p.techStack.split('•').map(s => s.trim()) : [];
        return (
          <article class="card-surface p-6 sm:p-8 flex flex-col justify-between group">
            <div>
              <!-- Header Row with Title & Brand Icon -->
              <div class="flex items-start justify-between gap-4 mb-3">
                <h3 class="text-xl font-bold text-foreground group-hover:text-[var(--accent)] transition-colors m-0 leading-snug">
                  {p.title}
                </h3>
                <div
                  class="size-11 rounded-xl bg-[rgba(var(--accent-rgb),0.1)] border border-[rgba(var(--accent-rgb),0.2)] text-[var(--accent)] flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:border-[var(--accent)] transition-all duration-300 shadow-xs [&>svg]:size-6"
                  set:html={p.icon}
                />
              </div>

              <!-- Tech Stack Pills -->
              <div class="flex flex-wrap gap-1.5 mb-4">
                {stackList.map((item) => (
                  <span class="tech-chip text-[0.7rem]">
                    {item}
                  </span>
                ))}
              </div>

              <!-- Description -->
              <p class="text-sm sm:text-[0.9375rem] text-[var(--color-text-secondary)] leading-relaxed m-0">
                {p.description}
              </p>
            </div>

            <!-- Action Button -->
            <div class="mt-6 pt-4 border-t border-[var(--color-border)] flex items-center justify-between">
              <Button href={p.ctaLink} variant="secondary" size="sm">
                <span>{p.ctaText.replace('→', '').trim()}</span>
                <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" class="transition-transform duration-200 group-hover:translate-x-1">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </Button>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
