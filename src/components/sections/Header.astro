---
import { SITE_TITLE } from '../../consts';
import HeaderLink from './HeaderLink.astro';
import Win95BootLoader from './Win95BootLoader.astro';
import Win95Desktop from './Win95Desktop.astro';
---

<header class="w-full select-none z-50 sticky top-0">
  <!-- Early Inline Fallback for Immediate Window Minimize & Close -->
  <script is:inline>
    if (typeof window !== 'undefined' && !window.minimizeToDesktop) {
      window.minimizeToDesktop = function () {
        document.body.classList.add('is-desktop-minimized');
        var desk = document.getElementById('win95-desktop-screen');
        if (desk) {
          desk.style.display = 'flex';
          desk.setAttribute('aria-hidden', 'false');
        }
        var about = document.getElementById('retro-about-dialog');
        if (about) {
          about.style.display = 'none';
          about.classList.add('hidden');
          about.classList.remove('is-open');
        }
        window.scrollTo({ top: 0 });
      };
    }
  </script>

  <!-- Windows 95 Desktop Screen (Revealed when window is closed / minimized) -->
  <Win95Desktop />

  <!-- Windows 95 Boot Animation & Website Loader -->
  <Win95BootLoader />

  <!-- Retro Window Titlebar (Matching Windows 95 Standard Shell) -->
  <div class="retro-titlebar" id="retro-main-titlebar">
    <div class="flex items-center gap-2 overflow-visible min-w-0 flex-1 relative">
      <!-- Top-Left System Window Menu Trigger Button (16x16 icon) -->
      <button
        type="button"
        id="retro-system-menu-btn"
        class="p-0.5 rounded-none text-white hover:bg-[#003d8f] focus:outline-none focus:ring-1 focus:ring-white cursor-pointer select-none shrink-0"
        aria-label="System Window Menu"
        aria-haspopup="true"
        aria-expanded="false"
        title="System Menu (Click for options, double-click to close)"
      >
        <img
          src="/images/win95-icons/computer-16.png?v=1995.2"
          alt="System Menu"
          width="16"
          height="16"
          class="size-4 shrink-0 [image-rendering:pixelated]"
        />
      </button>

      <!-- Clean Titlebar Text (Without Modern Dropdown Arrows) -->
      <span class="win95-title-text truncate font-bold text-xs sm:text-sm tracking-wide text-white select-none">
        Piush KS – Mobile & Cloud Engineer
      </span>

      <!-- System Window Menu Dropdown (Authentic Windows 95 Layout) -->
      <div id="retro-system-menu-dropdown" class="retro-menu-dropdown hidden" role="menu" style="left: 0; top: calc(100% + 4px);">
        <button type="button" class="retro-menu-item opacity-50 cursor-not-allowed" id="sys-menu-restore" data-action="toggle-fullscreen" role="menuitem" disabled>
          <span class="flex items-center gap-2">
            <span class="text-xs">⧉</span>
            <span>Restore</span>
          </span>
          <span class="retro-menu-shortcut">Alt+F5</span>
        </button>
        <button type="button" class="retro-menu-item opacity-50 cursor-not-allowed" id="sys-menu-move" role="menuitem" disabled>
          <span class="flex items-center gap-2">
            <span class="text-xs">✥</span>
            <span>Move</span>
          </span>
          <span class="retro-menu-shortcut">Alt+F7</span>
        </button>
        <button type="button" class="retro-menu-item opacity-50 cursor-not-allowed" id="sys-menu-size" role="menuitem" disabled>
          <span class="flex items-center gap-2">
            <span class="text-xs">↔</span>
            <span>Size</span>
          </span>
          <span class="retro-menu-shortcut">Alt+F8</span>
        </button>
        <button type="button" class="retro-menu-item" data-action="minimize-desktop" role="menuitem">
          <span class="flex items-center gap-2">
            <span class="text-xs font-bold">_</span>
            <span>Minimize</span>
          </span>
          <span class="retro-menu-shortcut">Win+M</span>
        </button>
        <button type="button" class="retro-menu-item" id="sys-menu-maximize" data-action="toggle-fullscreen" role="menuitem">
          <span class="flex items-center gap-2">
            <span class="text-xs font-bold">▫</span>
            <span id="sys-fs-label">Maximize</span>
          </span>
          <span class="retro-menu-shortcut">F11</span>
        </button>

        <div class="retro-menu-separator"></div>

        <button type="button" class="retro-menu-item font-bold" data-action="close-window" role="menuitem">
          <span class="flex items-center gap-2">
            <span class="text-xs font-bold">✕</span>
            <span>Close</span>
          </span>
          <span class="retro-menu-shortcut font-bold">Alt+F4</span>
        </button>

        <div class="retro-menu-separator"></div>

        <button type="button" class="retro-menu-item" data-action="open-about" role="menuitem">
          <span class="flex items-center gap-2">
            <img src="/images/win95-icons/control-panel-16.png?v=1995.2" alt="" width="16" height="16" class="size-3.5 shrink-0 [image-rendering:pixelated]" />
            <span>Properties (About)...</span>
          </span>
        </button>
        <button type="button" class="retro-menu-item" data-action="toggle-sound" role="menuitem">
          <span class="flex items-center gap-2">
            <img src="/images/win95-icons/volume-16.png?v=1995.2" alt="" width="16" height="16" class="size-3.5 shrink-0 [image-rendering:pixelated]" />
            <span id="sys-sound-label">[✓] Sound FX</span>
          </span>
        </button>
        <button type="button" class="retro-menu-item" data-action="toggle-crt" role="menuitem">
          <span class="flex items-center gap-2">
            <img src="/images/win95-icons/dos-16.png?v=1995.2" alt="" width="16" height="16" class="size-3.5 shrink-0 [image-rendering:pixelated]" />
            <span id="sys-crt-label">[ ] CRT Scanlines</span>
          </span>
        </button>
        <button type="button" class="retro-menu-item" data-action="restart-boot" role="menuitem">
          <span class="flex items-center gap-2">
            <img src="/images/win95-icons/computer-16.png?v=1995.2" alt="" width="16" height="16" class="size-3.5 shrink-0 [image-rendering:pixelated]" />
            <span>Restart OS</span>
          </span>
          <span class="retro-menu-shortcut">Boot</span>
        </button>
      </div>
    </div>

    <!-- Retro Window Controls: Minimize, Maximize, Close -->
    <div class="flex items-center gap-1 sm:gap-1.5 shrink-0 ml-auto pl-2">
      <button
        type="button"
        class="retro-titlebar-btn"
        id="retro-minimize-btn"
        aria-label="Minimize Window to Windows 95 Desktop"
        title="Minimize"
        onclick="if (typeof window !== 'undefined' && window.minimizeToDesktop) { window.minimizeToDesktop(); }"
      >
        _
      </button>
      <button
        type="button"
        class="retro-titlebar-btn"
        id="retro-maximize-btn"
        aria-label="Maximize / Toggle Fullscreen"
        title="Toggle Fullscreen"
      >
        &#9633;
      </button>
      <button
        type="button"
        class="retro-titlebar-btn hover:bg-[#cc0000] hover:text-white"
        id="retro-close-btn"
        aria-label="Close Window (Minimize to Windows 95 Desktop)"
        title="Close"
        onclick="if (typeof window !== 'undefined' && window.minimizeToDesktop) { window.minimizeToDesktop(); }"
      >
        &#10005;
      </button>
    </div>
  </div>

  <!-- Retro Window Menubar -->
  <nav class="retro-menubar relative">
    <!-- Desktop Nav Links -->
    <div class="hidden md:flex items-center gap-1.5 lg:gap-3 overflow-visible py-0.5">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/portfolio/">Portfolio</HeaderLink>
      <HeaderLink href="/blog/">Blog</HeaderLink>
      <HeaderLink href="/tools/">Tools</HeaderLink>
      <HeaderLink href="/quiz/">Quiz</HeaderLink>
      <HeaderLink href="/about/">About</HeaderLink>
      <HeaderLink href="/tags/">Tags</HeaderLink>
      <a
        href="#contact"
        class="px-2.5 py-1 text-sm font-mono text-black hover:underline hover:decoration-2 hover:underline-offset-4 no-underline select-none"
      >
        Contact
      </a>

      <!-- Dedicated Window Menu & Options Dropdown in Menubar -->
      <div class="relative inline-block text-left ml-1">
        <button
          type="button"
          id="retro-menubar-window-btn"
          class="retro-btn !py-1 !px-2.5 !text-xs flex items-center gap-1.5"
          aria-haspopup="true"
          aria-expanded="false"
          title="Window Menu (Website Options)"
        >
          <span class="font-bold">Options</span>
          <span class="text-[9px]">▼</span>
        </button>

        <!-- Dropdown Popup for Menubar Options Button -->
        <div id="retro-menubar-window-dropdown" class="retro-menu-dropdown hidden" role="menu" style="left: 0; top: calc(100% + 4px);">
          <button type="button" class="retro-menu-item" data-action="minimize-desktop" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span class="text-sm">🗕</span>
              <span>Minimize to Desktop</span>
            </span>
            <span class="retro-menu-shortcut">Win+M</span>
          </button>
          <button type="button" class="retro-menu-item" data-action="toggle-fullscreen" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span class="text-sm">⛶</span>
              <span id="mb-fs-label">Maximize / Fullscreen</span>
            </span>
            <span class="retro-menu-shortcut">F11</span>
          </button>
          <button type="button" class="retro-menu-item" data-action="scroll-top" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>⬆</span>
              <span>Scroll to Top</span>
            </span>
            <span class="retro-menu-shortcut">Home</span>
          </button>
          <button type="button" class="retro-menu-item" data-action="scroll-bottom" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>⬇</span>
              <span>Scroll to Bottom</span>
            </span>
            <span class="retro-menu-shortcut">End</span>
          </button>
          <button type="button" class="retro-menu-item" data-action="reload-page" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>🔄</span>
              <span>Reload Window</span>
            </span>
            <span class="retro-menu-shortcut">Ctrl+R</span>
          </button>
          <button type="button" class="retro-menu-item" data-action="restart-boot" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>⚡</span>
              <span>Restart OS (Boot Animation)</span>
            </span>
            <span class="retro-menu-shortcut">Boot</span>
          </button>

          <div class="retro-menu-separator"></div>

          <button type="button" class="retro-menu-item" data-action="toggle-sound" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>🔊</span>
              <span id="mb-sound-label">[✓] Retro Sound FX</span>
            </span>
          </button>
          <button type="button" class="retro-menu-item" data-action="toggle-crt" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>📺</span>
              <span id="mb-crt-label">[ ] CRT Scanlines</span>
            </span>
          </button>
          <button type="button" class="retro-menu-item" data-action="toggle-mono" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>🔤</span>
              <span id="mb-mono-label">[ ] Monospace Mode</span>
            </span>
          </button>

          <div class="retro-menu-separator"></div>

          <button type="button" class="retro-menu-item" data-action="copy-url" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>📋</span>
              <span>Copy Page URL</span>
            </span>
            <span class="retro-menu-shortcut">Ctrl+C</span>
          </button>
          <button type="button" class="retro-menu-item" data-action="print-page" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>🖨️</span>
              <span>Print / Save PDF</span>
            </span>
            <span class="retro-menu-shortcut">Ctrl+P</span>
          </button>
          <a href="https://github.com/piushks/piush.com" target="_blank" rel="noopener noreferrer" class="retro-menu-item" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>⭐</span>
              <span>View Source on GitHub</span>
            </span>
            <span class="retro-menu-shortcut">↗</span>
          </a>

          <div class="retro-menu-separator"></div>

          <button type="button" class="retro-menu-item" data-action="open-about" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>ℹ️</span>
              <span>About Piush.com...</span>
            </span>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Menu Button & Brand -->
    <div class="flex md:hidden items-center justify-between w-full">
      <a href="/" class="font-mono font-bold text-sm text-black no-underline flex items-center gap-1.5">
        <span>Piush.com</span>
      </a>

      <button
        type="button"
        aria-label="Toggle retro navigation menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-btn
        class="retro-btn !py-1 !px-2.5 !text-xs flex items-center gap-1.5"
      >
        <span>Menu</span>
        <span class="text-[10px]">&#9660;</span>
      </button>
    </div>

    <!-- Right Controls: Authentic Windows 95 System Notification Tray (SysTray) & Links -->
    <div class="hidden md:flex items-center gap-2">
      <!-- Windows 95 Notification Tray -->
      <div
        id="retro-home-tray"
        class="retro-inset px-2 py-0.5 bg-[#c0c0c0] text-xs font-mono font-bold text-black flex items-center gap-1.5 cursor-pointer hover:bg-[#d0d0d0] select-none"
        title="Double-click to open Date/Time Properties"
      >
        <!-- Tray Volume Icon -->
        <button
          type="button"
          id="retro-tray-volume-btn"
          class="flex items-center justify-center p-0.5 hover:bg-black/10 focus:outline-none"
          title="Sound Effects (Click to toggle)"
        >
          <img
            src="/images/win95-icons/volume-16.png?v=1995.2"
            alt="Volume"
            width="16"
            height="16"
            class="size-3.5 shrink-0 [image-rendering:pixelated]"
          />
        </button>

        <!-- Tray Clock Time (Authentic Windows 95 12-hour AM/PM) -->
        <span id="retro-live-clock" class="text-[11px] font-sans font-bold text-black min-w-[55px] text-right">--:-- --</span>
      </div>

      <a
        href="https://x.com/piushks"
        target="_blank"
        rel="noopener noreferrer"
        class="retro-btn !p-1.5 !text-xs"
        aria-label="Follow on X (Twitter)"
        title="X (Twitter)"
      >
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="currentColor">
          <path d="M18.146 3H21l-7.5 8.574L22.5 21h-6.297l-4.93-5.597L5.5 21H3l8.106-9.266L3 3h6.453l4.466 5.07L18.146 3Zm-1.103 16.2h1.705L7.05 4.64H5.272l11.771 14.56Z"/>
        </svg>
      </a>

      <a
        href="https://github.com/piushks"
        target="_blank"
        rel="noopener noreferrer"
        class="retro-btn !p-1.5 !text-xs"
        aria-label="GitHub Profile"
        title="GitHub"
      >
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>

      <a
        href="https://linkedin.com/in/piushks/"
        target="_blank"
        rel="noopener noreferrer"
        class="retro-btn !p-1.5 !text-xs"
        aria-label="LinkedIn Profile"
        title="LinkedIn"
      >
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.413v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>
  </nav>

  <!-- Windows 95 Main Application Toolbar -->
  <div class="win95-home-toolbar bg-[#c0c0c0] border-b border-[#808080] shadow-[inset_0_1px_0_#ffffff] px-1 py-1 flex items-center gap-0.5 overflow-x-auto select-none text-xs">
    <!-- Back Button -->
    <button type="button" class="win95-tool-btn" id="tb-home-back" title="Back (Alt+Left Arrow)">
      <img src="/images/win95-icons/back-16.png?v=1995.2" alt="" width="16" height="16" class="size-4 shrink-0 [image-rendering:pixelated]" />
      <span class="hidden sm:inline">Back</span>
    </button>
    <!-- Forward Button -->
    <button type="button" class="win95-tool-btn" id="tb-home-fwd" title="Forward (Alt+Right Arrow)">
      <img src="/images/win95-icons/forward-16.png?v=1995.2" alt="" width="16" height="16" class="size-4 shrink-0 [image-rendering:pixelated]" />
      <span class="hidden sm:inline">Forward</span>
    </button>
    <!-- Up / Home (Folder Up) -->
    <button type="button" class="win95-tool-btn" id="tb-home-up" title="Up to Top (Home)">
      <img src="/images/win95-icons/folder-open-16.png?v=1995.2" alt="" width="16" height="16" class="size-4 shrink-0 [image-rendering:pixelated]" />
      <span class="hidden sm:inline">Up</span>
    </button>

    <div class="win95-tool-separator"></div>

    <!-- Cut / Copy Page URL -->
    <button type="button" class="win95-tool-btn" id="tb-home-copy" title="Copy URL to Clipboard">
      <img src="/images/win95-icons/copy-16.png?v=1995.2" alt="" width="16" height="16" class="size-4 shrink-0 [image-rendering:pixelated]" />
      <span class="hidden md:inline">Copy URL</span>
    </button>
    <!-- Print -->
    <button type="button" class="win95-tool-btn" id="tb-home-print" title="Print Page (Ctrl+P)">
      <img src="/images/win95-icons/print-16.png?v=1995.2" alt="" width="16" height="16" class="size-4 shrink-0 [image-rendering:pixelated]" />
      <span class="hidden md:inline">Print</span>
    </button>
    <!-- Reload / Refresh -->
    <button type="button" class="win95-tool-btn" id="tb-home-refresh" title="Refresh Page (F5)">
      <img src="/images/win95-icons/refresh-16.png?v=1995.2" alt="" width="16" height="16" class="size-4 shrink-0 [image-rendering:pixelated]" />
      <span class="hidden sm:inline">Refresh</span>
    </button>

    <div class="win95-tool-separator"></div>

    <!-- Sound FX Toggle -->
    <button type="button" class="win95-tool-btn" id="tb-home-sound" title="Toggle Retro Sound Effects">
      <img src="/images/win95-icons/volume-16.png?v=1995.2" alt="" width="16" height="16" class="size-4 shrink-0 [image-rendering:pixelated]" />
      <span class="hidden lg:inline" id="tb-sound-text">Sound</span>
    </button>
    <!-- CRT Monitor Toggle -->
    <button type="button" class="win95-tool-btn" id="tb-home-crt" title="Toggle CRT Scanline Monitor Filter">
      <img src="/images/win95-icons/dos-16.png?v=1995.2" alt="" width="16" height="16" class="size-4 shrink-0 [image-rendering:pixelated]" />
      <span class="hidden lg:inline" id="tb-crt-text">CRT</span>
    </button>
    <!-- System Properties (About) -->
    <button type="button" class="win95-tool-btn" id="tb-home-props" title="System Properties – About Piush.com">
      <img src="/images/win95-icons/control-panel-16.png?v=1995.2" alt="" width="16" height="16" class="size-4 shrink-0 [image-rendering:pixelated]" />
      <span class="hidden sm:inline">Properties</span>
    </button>

    <!-- Address Bar Band on Desktop -->
    <div class="hidden xl:flex items-center gap-1.5 ml-auto pl-2 flex-1 max-w-sm">
      <span class="text-black font-sans text-xs font-bold shrink-0">Address</span>
      <div class="retro-inset bg-white px-2 py-0.5 flex-1 flex items-center justify-between text-xs font-mono text-black truncate shadow-[inset_1px_1px_0px_#000000]">
        <span class="truncate">https://piush.com/</span>
        <span class="text-[9px] text-gray-500 pl-1 shrink-0">▼</span>
      </div>
    </div>
  </div>


  <!-- Mobile Dropdown Menu: Retro Dialog -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-[#d4d4d4] border-b-2 border-black p-3 space-y-2 shadow-[4px_4px_0px_#000000] font-mono text-sm"
  >
    <div class="flex flex-col gap-1 pb-1">
      <HeaderLink href="/" class="py-1 px-2 block">Home</HeaderLink>
      <HeaderLink href="/portfolio/" class="py-1 px-2 block">Portfolio</HeaderLink>
      <HeaderLink href="/blog/" class="py-1 px-2 block">Blog</HeaderLink>
      <HeaderLink href="/tools/" class="py-1 px-2 block">Tools</HeaderLink>
      <HeaderLink href="/quiz/" class="py-1 px-2 block">Quiz</HeaderLink>
      <HeaderLink href="/about/" class="py-1 px-2 block">About</HeaderLink>
      <HeaderLink href="/tags/" class="py-1 px-2 block">Tags</HeaderLink>
      <a href="#contact" class="py-1 px-2 block text-black hover:underline no-underline">Contact</a>
    </div>

    <!-- Mobile Website Options Subpanel -->
    <div class="pt-2 border-t border-black space-y-1">
      <div class="text-[11px] font-bold text-gray-700 uppercase tracking-wider px-2 py-0.5">
        Website Options
      </div>
      <button type="button" class="retro-menu-item !text-xs" data-action="minimize-desktop">
        <span>🗕 Minimize to Desktop</span>
      </button>
      <button type="button" class="retro-menu-item !text-xs" data-action="toggle-fullscreen">
        <span>⛶ Maximize / Fullscreen</span>
      </button>
      <button type="button" class="retro-menu-item !text-xs" data-action="restart-boot">
        <span>⚡ Restart OS (Boot Animation)</span>
      </button>
      <button type="button" class="retro-menu-item !text-xs" data-action="toggle-sound">
