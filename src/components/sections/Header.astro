---
import { SITE_TITLE } from '../../consts';
import HeaderLink from './HeaderLink.astro';
import Win95BootLoader from './Win95BootLoader.astro';
---

<header class="w-full select-none z-50 sticky top-0">
  <!-- Windows 95 Boot Animation & Website Loader -->
  <Win95BootLoader />

  <!-- Retro Window Titlebar (Matching Reference Mockups) -->
  <div class="retro-titlebar">
    <div class="flex items-center gap-2 overflow-visible min-w-0 flex-1 relative">
      <!-- Titlebar Window Menu Trigger Button -->
      <button
        type="button"
        id="retro-system-menu-btn"
        class="flex items-center gap-1.5 px-1 py-0.5 rounded-none text-white hover:bg-[#003d8f] focus:outline-none focus:ring-1 focus:ring-white cursor-pointer select-none max-w-full"
        aria-label="Window Menu and Website Options"
        aria-haspopup="true"
        aria-expanded="false"
        title="Window Menu (Website Options)"
      >
        <!-- Retro Computer Icon -->
        <svg class="size-4 shrink-0 text-white fill-current" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h11A1.5 1.5 0 0 1 15 2.5v8a1.5 1.5 0 0 1-1.5 1.5h-3.75l.75 2h1.5a.5.5 0 0 1 0 1h-8a.5.5 0 0 1 0-1h1.5l.75-2H2.5A1.5 1.5 0 0 1 1 10.5v-8ZM2.5 2a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-8a.5.5 0 0 0-.5-.5h-11Z"/>
        </svg>
        <span class="truncate font-mono font-bold text-xs sm:text-sm tracking-wide text-white">
          Piush KS – Mobile & Cloud Engineer
        </span>
        <span class="text-[9px] text-white/80 shrink-0">▼</span>
      </button>

      <!-- System Window Menu Dropdown (Top-Left) -->
      <div id="retro-system-menu-dropdown" class="retro-menu-dropdown hidden" role="menu" style="left: 0; top: calc(100% + 4px);">
        <button type="button" class="retro-menu-item" data-action="toggle-fullscreen" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span class="text-sm">⛶</span>
            <span id="sys-fs-label">Maximize / Fullscreen</span>
          </span>
          <span class="retro-menu-shortcut">F11</span>
        </button>
        <button type="button" class="retro-menu-item" data-action="scroll-top" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span>⬆</span>
            <span>Scroll to Top</span>
          </span>
          <span class="retro-menu-shortcut">Home</span>
        </button>
        <button type="button" class="retro-menu-item" data-action="scroll-bottom" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span>⬇</span>
            <span>Scroll to Bottom</span>
          </span>
          <span class="retro-menu-shortcut">End</span>
        </button>
        <button type="button" class="retro-menu-item" data-action="reload-page" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span>🔄</span>
            <span>Reload Window</span>
          </span>
          <span class="retro-menu-shortcut">Ctrl+R</span>
        </button>
        <button type="button" class="retro-menu-item" data-action="restart-boot" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span>⚡</span>
            <span>Restart OS (Boot Animation)</span>
          </span>
          <span class="retro-menu-shortcut">Boot</span>
        </button>

        <div class="retro-menu-separator"></div>

        <button type="button" class="retro-menu-item" data-action="toggle-sound" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span>🔊</span>
            <span id="sys-sound-label">[✓] Retro Sound FX</span>
          </span>
        </button>
        <button type="button" class="retro-menu-item" data-action="toggle-crt" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span>📺</span>
            <span id="sys-crt-label">[ ] CRT Scanlines</span>
          </span>
        </button>
        <button type="button" class="retro-menu-item" data-action="toggle-mono" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span>🔤</span>
            <span id="sys-mono-label">[ ] Monospace Mode</span>
          </span>
        </button>

        <div class="retro-menu-separator"></div>

        <button type="button" class="retro-menu-item" data-action="copy-url" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span>📋</span>
            <span>Copy Page URL</span>
          </span>
          <span class="retro-menu-shortcut">Ctrl+C</span>
        </button>
        <button type="button" class="retro-menu-item" data-action="print-page" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span>🖨️</span>
            <span>Print / Save PDF</span>
          </span>
          <span class="retro-menu-shortcut">Ctrl+P</span>
        </button>
        <a href="https://github.com/piushks/piush.com" target="_blank" rel="noopener noreferrer" class="retro-menu-item" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span>⭐</span>
            <span>View Source on GitHub</span>
          </span>
          <span class="retro-menu-shortcut">↗</span>
        </a>

        <div class="retro-menu-separator"></div>

        <button type="button" class="retro-menu-item" data-action="open-about" role="menuitem">
          <span class="flex items-center gap-1.5">
            <span>ℹ️</span>
            <span>About Piush.com...</span>
          </span>
        </button>
      </div>
    </div>

    <!-- Retro Window Controls: Minimize, Maximize, Close -->
    <div class="flex items-center gap-1 sm:gap-1.5 shrink-0 ml-auto pl-2">
      <button
        type="button"
        class="retro-titlebar-btn"
        aria-label="Minimize Window"
        title="Minimize"
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
      >
        _
      </button>
      <button
        type="button"
        class="retro-titlebar-btn"
        id="retro-maximize-btn"
        aria-label="Maximize / Toggle Fullscreen"
        title="Toggle Fullscreen"
      >
        &#9633;
      </button>
      <button
        type="button"
        class="retro-titlebar-btn hover:bg-[#cc0000] hover:text-white"
        aria-label="Close Window"
        title="Close"
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
      >
        &#10005;
      </button>
    </div>
  </div>

  <!-- Retro Window Menubar -->
  <nav class="retro-menubar relative">
    <!-- Desktop Nav Links -->
    <div class="hidden md:flex items-center gap-1.5 lg:gap-3 overflow-visible py-0.5">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/portfolio/">Portfolio</HeaderLink>
      <HeaderLink href="/blog/">Blog</HeaderLink>
      <HeaderLink href="/tools/">Tools</HeaderLink>
      <HeaderLink href="/quiz/">Quiz</HeaderLink>
      <HeaderLink href="/about/">About</HeaderLink>
      <HeaderLink href="/tags/">Tags</HeaderLink>
      <a
        href="#contact"
        class="px-2.5 py-1 text-sm font-mono text-black hover:underline hover:decoration-2 hover:underline-offset-4 no-underline select-none"
      >
        Contact
      </a>

      <!-- Dedicated Window Menu & Options Dropdown in Menubar -->
      <div class="relative inline-block text-left ml-1">
        <button
          type="button"
          id="retro-menubar-window-btn"
          class="retro-btn !py-1 !px-2.5 !text-xs flex items-center gap-1.5"
          aria-haspopup="true"
          aria-expanded="false"
          title="Window Menu (Website Options)"
        >
          <span class="font-bold">Options</span>
          <span class="text-[9px]">▼</span>
        </button>

        <!-- Dropdown Popup for Menubar Options Button -->
        <div id="retro-menubar-window-dropdown" class="retro-menu-dropdown hidden" role="menu" style="left: 0; top: calc(100% + 4px);">
          <button type="button" class="retro-menu-item" data-action="toggle-fullscreen" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span class="text-sm">⛶</span>
              <span id="mb-fs-label">Maximize / Fullscreen</span>
            </span>
            <span class="retro-menu-shortcut">F11</span>
          </button>
          <button type="button" class="retro-menu-item" data-action="scroll-top" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>⬆</span>
              <span>Scroll to Top</span>
            </span>
            <span class="retro-menu-shortcut">Home</span>
          </button>
          <button type="button" class="retro-menu-item" data-action="scroll-bottom" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>⬇</span>
              <span>Scroll to Bottom</span>
            </span>
            <span class="retro-menu-shortcut">End</span>
          </button>
          <button type="button" class="retro-menu-item" data-action="reload-page" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>🔄</span>
              <span>Reload Window</span>
            </span>
            <span class="retro-menu-shortcut">Ctrl+R</span>
          </button>
          <button type="button" class="retro-menu-item" data-action="restart-boot" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>⚡</span>
              <span>Restart OS (Boot Animation)</span>
            </span>
            <span class="retro-menu-shortcut">Boot</span>
          </button>

          <div class="retro-menu-separator"></div>

          <button type="button" class="retro-menu-item" data-action="toggle-sound" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>🔊</span>
              <span id="mb-sound-label">[✓] Retro Sound FX</span>
            </span>
          </button>
          <button type="button" class="retro-menu-item" data-action="toggle-crt" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>📺</span>
              <span id="mb-crt-label">[ ] CRT Scanlines</span>
            </span>
          </button>
          <button type="button" class="retro-menu-item" data-action="toggle-mono" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>🔤</span>
              <span id="mb-mono-label">[ ] Monospace Mode</span>
            </span>
          </button>

          <div class="retro-menu-separator"></div>

          <button type="button" class="retro-menu-item" data-action="copy-url" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>📋</span>
              <span>Copy Page URL</span>
            </span>
            <span class="retro-menu-shortcut">Ctrl+C</span>
          </button>
          <button type="button" class="retro-menu-item" data-action="print-page" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>🖨️</span>
              <span>Print / Save PDF</span>
            </span>
            <span class="retro-menu-shortcut">Ctrl+P</span>
          </button>
          <a href="https://github.com/piushks/piush.com" target="_blank" rel="noopener noreferrer" class="retro-menu-item" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>⭐</span>
              <span>View Source on GitHub</span>
            </span>
            <span class="retro-menu-shortcut">↗</span>
          </a>

          <div class="retro-menu-separator"></div>

          <button type="button" class="retro-menu-item" data-action="open-about" role="menuitem">
            <span class="flex items-center gap-1.5">
              <span>ℹ️</span>
              <span>About Piush.com...</span>
            </span>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Menu Button & Brand -->
    <div class="flex md:hidden items-center justify-between w-full">
      <a href="/" class="font-mono font-bold text-sm text-black no-underline flex items-center gap-1.5">
        <span>Piush.com</span>
      </a>

      <button
        type="button"
        aria-label="Toggle retro navigation menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-btn
        class="retro-btn !py-1 !px-2.5 !text-xs flex items-center gap-1.5"
      >
        <span>Menu</span>
        <span class="text-[10px]">&#9660;</span>
      </button>
    </div>

    <!-- Right Controls: Retro Clock & Desktop Social Links -->
    <div class="hidden md:flex items-center gap-2">
      <div class="retro-inset px-2.5 py-0.5 bg-white text-xs font-mono font-bold text-black flex items-center gap-1.5 shadow-[inset_1px_1px_0px_#000000]">
        <span class="inline-block size-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
        <span id="retro-live-clock">--:--:--</span>
      </div>

      <a
        href="https://x.com/piushks"
        target="_blank"
        rel="noopener noreferrer"
        class="retro-btn !p-1.5 !text-xs"
        aria-label="Follow on X (Twitter)"
        title="X (Twitter)"
      >
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="currentColor">
          <path d="M18.146 3H21l-7.5 8.574L22.5 21h-6.297l-4.93-5.597L5.5 21H3l8.106-9.266L3 3h6.453l4.466 5.07L18.146 3Zm-1.103 16.2h1.705L7.05 4.64H5.272l11.771 14.56Z"/>
        </svg>
      </a>

      <a
        href="https://github.com/piushks"
        target="_blank"
        rel="noopener noreferrer"
        class="retro-btn !p-1.5 !text-xs"
        aria-label="GitHub Profile"
        title="GitHub"
      >
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>

      <a
        href="https://linkedin.com/in/piushks/"
        target="_blank"
        rel="noopener noreferrer"
        class="retro-btn !p-1.5 !text-xs"
        aria-label="LinkedIn Profile"
        title="LinkedIn"
      >
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.413v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>
  </nav>

  <!-- Mobile Dropdown Menu: Retro Dialog -->
  <div
    id="mobile-menu"
    class="md:hidden hidden bg-[#d4d4d4] border-b-2 border-black p-3 space-y-2 shadow-[4px_4px_0px_#000000] font-mono text-sm"
  >
    <div class="flex flex-col gap-1 pb-1">
      <HeaderLink href="/" class="py-1 px-2 block">Home</HeaderLink>
      <HeaderLink href="/portfolio/" class="py-1 px-2 block">Portfolio</HeaderLink>
      <HeaderLink href="/blog/" class="py-1 px-2 block">Blog</HeaderLink>
      <HeaderLink href="/tools/" class="py-1 px-2 block">Tools</HeaderLink>
      <HeaderLink href="/quiz/" class="py-1 px-2 block">Quiz</HeaderLink>
      <HeaderLink href="/about/" class="py-1 px-2 block">About</HeaderLink>
      <HeaderLink href="/tags/" class="py-1 px-2 block">Tags</HeaderLink>
      <a href="#contact" class="py-1 px-2 block text-black hover:underline no-underline">Contact</a>
    </div>

    <!-- Mobile Website Options Subpanel -->
    <div class="pt-2 border-t border-black space-y-1">
      <div class="text-[11px] font-bold text-gray-700 uppercase tracking-wider px-2 py-0.5">
        Website Options
      </div>
      <button type="button" class="retro-menu-item !text-xs" data-action="toggle-fullscreen">
        <span>⛶ Maximize / Fullscreen</span>
      </button>
      <button type="button" class="retro-menu-item !text-xs" data-action="restart-boot">
        <span>⚡ Restart OS (Boot Animation)</span>
      </button>
      <button type="button" class="retro-menu-item !text-xs" data-action="toggle-sound">
        <span id="mob-sound-label">[✓] Retro Sound FX</span>
      </button>
      <button type="button" class="retro-menu-item !text-xs" data-action="toggle-crt">
        <span id="mob-crt-label">[ ] CRT Scanlines</span>
      </button>
      <button type="button" class="retro-menu-item !text-xs" data-action="toggle-mono">
        <span id="mob-mono-label">[ ] Monospace Mode</span>
      </button>
      <button type="button" class="retro-menu-item !text-xs" data-action="copy-url">
        <span>📋 Copy Page URL</span>
      </button>
      <button type="button" class="retro-menu-item !text-xs" data-action="open-about">
        <span>ℹ️ System Properties (About)...</span>
      </button>
    </div>

    <div class="flex items-center gap-2 pt-2 border-t border-black">
      <a href="https://x.com/piushks" target="_blank" rel="noopener noreferrer" class="retro-btn !p-2 !text-xs" aria-label="X (Twitter)">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="currentColor">
          <path d="M18.146 3H21l-7.5 8.574L22.5 21h-6.297l-4.93-5.597L5.5 21H3l8.106-9.266L3 3h6.453l4.466 5.07L18.146 3Zm-1.103 16.2h1.705L7.05 4.64H5.272l11.771 14.56Z"/>
        </svg>
      </a>
      <a href="https://github.com/piushks" target="_blank" rel="noopener noreferrer" class="retro-btn !p-2 !text-xs" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>
      <a href="https://linkedin.com/in/piushks/" target="_blank" rel="noopener noreferrer" class="retro-btn !p-2 !text-xs" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.413v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Authentic Windows 95 System Properties (About Dialog) -->
  <div id="retro-about-dialog" class="retro-dialog-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="retro-about-title">
    <div class="retro-dialog-window">
      <!-- Dialog Titlebar -->
      <div class="retro-titlebar !h-8 !min-h-[32px] !px-2">
        <div class="flex items-center gap-2 overflow-hidden">
          <img
            src="/images/windows-95-computer.svg"
            alt="PC Icon"
            width="16"
            height="16"
            class="shrink-0 size-4 [image-rendering:pixelated]"
          />
          <span id="retro-about-title" class="font-mono font-bold text-xs text-white truncate">
            System Properties – About Piush.com
          </span>
        </div>
        <button
          type="button"
          class="retro-titlebar-btn !w-[22px] !h-[22px] text-[11px]"
          id="retro-about-close-btn"
          aria-label="Close dialog"
          title="Close"
        >
          &#10005;
        </button>
      </div>

      <!-- Tabbed Dialog Body -->
      <div class="px-3 pt-2.5 pb-3 bg-[#c0c0c0] text-black">
        <div class="flex">
          <div class="retro-dialog-tab">General</div>
        </div>

        <div class="retro-dialog-panel space-y-2.5">
          <!-- Top Row: Icon + OS Identity -->
          <div class="flex items-start gap-4">
            <img
              src="/images/windows-95-computer.svg"
              alt="Windows 95 Computer"
              width="48"
              height="48"
              class="shrink-0 size-12 [image-rendering:pixelated] drop-shadow-[1px_1px_0px_#ffffff]"
            />
            <div class="space-y-0.5 text-xs text-black">
              <div class="font-bold text-sm text-[#002266] tracking-wide">Piush.com Portfolio OS</div>
              <div class="font-mono text-gray-800 text-[11px]">Release 2026.11 (Desktop Edition)</div>
              <div class="text-[10px] text-gray-600 font-mono">Copyright &copy; 1995-2026 Piush KS.</div>
            </div>
          </div>

          <div class="retro-menu-separator"></div>

          <!-- Registered To Section -->
          <div class="text-xs text-black space-y-0.5 font-mono">
            <div class="font-bold text-gray-800">Registered to:</div>
            <div class="pl-3 text-black font-bold">Guest Visitor / Recruiter / Engineer</div>
            <div class="pl-3 text-gray-700 text-[11px]">Host Domain: piush.com (Production)</div>
          </div>

          <div class="retro-menu-separator"></div>

          <!-- Computer Specifications -->
          <div class="text-xs text-black space-y-1">
            <div class="font-bold text-gray-800 font-mono">Computer Specs:</div>
            <div class="retro-inset p-2.5 text-[11px] font-mono space-y-0.5 bg-white text-black">
              <div class="flex justify-between">
                <span class="text-gray-600">Architecture:</span>
                <span class="font-bold">Apple Silicon / x86_64</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Base Engine:</span>
                <span class="font-bold">Astro 5.18.2 Static Edge</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Physical Memory:</span>
                <span class="font-bold">65,536 KB RAM Available</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Static Pages:</span>
                <span class="font-bold">73 Routes Pre-rendered</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Quiz Database:</span>
                <span class="font-bold">550 Verified Questions</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">System Resources:</span>
                <span class="font-bold text-emerald-700">98% Free (Optimal)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons Row -->
        <div class="flex items-center justify-end gap-2 pt-3">
          <a
            href="/about/"
            class="retro-btn !px-3 !py-1 !text-xs text-black no-underline"
          >
            Full About Bio &rarr;
          </a>
          <button
            type="button"
            id="retro-about-ok-btn"
            class="retro-btn !px-7 !py-1 !text-xs font-bold"
          >
            OK
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Retro Toast Notification -->
  <div id="retro-toast" class="retro-toast hidden" role="status" aria-live="polite"></div>
</header>

<script>
  // Web Audio API Retro Sound FX Generator
  let audioCtx: AudioContext | null = null;

  function isSoundEnabled(): boolean {
    if (typeof window === 'undefined') return true;
    return localStorage.getItem('retro_sound_enabled') !== 'false';
  }

  function getAudioCtx(): AudioContext | null {
    if (typeof window === 'undefined') return null;
    if (!audioCtx) {
      const AudioCtxClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AudioCtxClass) {
        audioCtx = new AudioCtxClass();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function playRetroClick() {
    if (!isSoundEnabled()) return;
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(800, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(180, ctx.currentTime + 0.035);
      gain.gain.setValueAtTime(0.12, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.005, ctx.currentTime + 0.035);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(ctx.currentTime);
      osc.stop(ctx.currentTime + 0.035);
    } catch (_) {}
  }

  function playRetroChime() {
    if (!isSoundEnabled()) return;
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const now = ctx.currentTime;
      [523.25, 659.25, 783.99].forEach((freq, idx) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now + idx * 0.04);
        gain.gain.setValueAtTime(0.1, now + idx * 0.04);
        gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.04 + 0.22);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now + idx * 0.04);
        osc.stop(now + idx * 0.04 + 0.22);
      });
    } catch (_) {}
  }

  function showRetroToast(message: string) {
    const toast = document.getElementById('retro-toast');
    if (!toast) return;
    toast.textContent = message;
    toast.classList.remove('hidden');
    playRetroChime();
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 2800);
  }

  function setupHeader() {
    // 1. Mobile navigation menu
    const btn = document.querySelector('[data-menu-btn]');
    const panel = document.getElementById('mobile-menu');
    
    function toggleMobileMenu() {
      if (!panel || !btn) return;
      playRetroClick();
      const isOpen = !panel.classList.contains('hidden');
      if (isOpen) {
        panel.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        panel.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    }
    btn?.addEventListener('click', toggleMobileMenu);

    // 2. System and Menubar Window Menus
    const sysBtn = document.getElementById('retro-system-menu-btn');
    const sysDropdown = document.getElementById('retro-system-menu-dropdown');
    const mbBtn = document.getElementById('retro-menubar-window-btn');
    const mbDropdown = document.getElementById('retro-menubar-window-dropdown');
    const maxBtn = document.getElementById('retro-maximize-btn');

    function closeAllMenus() {
      if (sysDropdown && !sysDropdown.classList.contains('hidden')) {
        sysDropdown.classList.add('hidden');
        sysBtn?.setAttribute('aria-expanded', 'false');
      }
      if (mbDropdown && !mbDropdown.classList.contains('hidden')) {
        mbDropdown.classList.add('hidden');
        mbBtn?.setAttribute('aria-expanded', 'false');
      }
    }

    function toggleSysMenu(e: Event) {
      e.stopPropagation();
      playRetroClick();
      const isOpen = !sysDropdown?.classList.contains('hidden');
      closeAllMenus();
      if (!isOpen && sysDropdown) {
        sysDropdown.classList.remove('hidden');
        sysBtn?.setAttribute('aria-expanded', 'true');
      }
    }

    function toggleMbMenu(e: Event) {
      e.stopPropagation();
      playRetroClick();
      const isOpen = !mbDropdown?.classList.contains('hidden');
      closeAllMenus();
      if (!isOpen && mbDropdown) {
        mbDropdown.classList.remove('hidden');
        mbBtn?.setAttribute('aria-expanded', 'true');
      }
    }

    sysBtn?.addEventListener('click', toggleSysMenu);
    mbBtn?.addEventListener('click', toggleMbMenu);

    // 3. Maximize / Fullscreen
    function toggleFullscreen() {
      playRetroClick();
      const doc = document as Document & { webkitFullscreenElement?: Element; webkitExitFullscreen?: () => Promise<void> };
      const docEl = document.documentElement as HTMLElement & { webkitRequestFullscreen?: () => Promise<void> };
      if (!doc.fullscreenElement && !doc.webkitFullscreenElement) {
        const req = docEl.requestFullscreen || docEl.webkitRequestFullscreen;
        if (req) req.call(docEl);
      } else {
        const exit = doc.exitFullscreen || doc.webkitExitFullscreen;
        if (exit) exit.call(doc);
      }
    }
    maxBtn?.addEventListener('click', toggleFullscreen);

    // 4. Update UI labels for preferences (Sound, CRT, Monospace)
    function syncPreferenceLabels() {
      const soundOn = isSoundEnabled();
      const crtOn = localStorage.getItem('retro_crt_enabled') === 'true';
      const monoOn = localStorage.getItem('retro_mono_enabled') === 'true';

      const soundText = soundOn ? '[✓] Retro Sound FX' : '[ ] Retro Sound FX';
      const crtText = crtOn ? '[✓] CRT Scanlines' : '[ ] CRT Scanlines';
      const monoText = monoOn ? '[✓] Monospace Mode' : '[ ] Monospace Mode';

      ['sys', 'mb', 'mob'].forEach((prefix) => {
        const soundEl = document.getElementById(`${prefix}-sound-label`);
        const crtEl = document.getElementById(`${prefix}-crt-label`);
        const monoEl = document.getElementById(`${prefix}-mono-label`);
        if (soundEl) soundEl.textContent = soundText;
        if (crtEl) crtEl.textContent = crtText;
        if (monoEl) monoEl.textContent = monoText;
      });

      // Apply body classes
      document.body.classList.toggle('retro-crt-active', crtOn);
      document.body.classList.toggle('retro-mono-active', monoOn);
    }
    syncPreferenceLabels();

    // 5. Action Handlers for Window Menu Options
    document.querySelectorAll('[data-action]').forEach((item) => {
      item.addEventListener('click', (e) => {
        const action = (e.currentTarget as HTMLElement).getAttribute('data-action');
        closeAllMenus();
        if (panel && !panel.classList.contains('hidden')) {
          panel.classList.add('hidden');
          btn?.setAttribute('aria-expanded', 'false');
        }

        switch (action) {
          case 'toggle-fullscreen':
            toggleFullscreen();
            break;
          case 'scroll-top':
            playRetroClick();
            window.scrollTo({ top: 0, behavior: 'smooth' });
            break;
          case 'scroll-bottom':
            playRetroClick();
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
            break;
          case 'reload-page':
            playRetroClick();
            window.location.reload();
            break;
          case 'restart-boot':
            playRetroClick();
            (window as unknown as { triggerWin95Boot?: () => void }).triggerWin95Boot?.();
            break;
          case 'toggle-sound': {
            const next = !isSoundEnabled();
            localStorage.setItem('retro_sound_enabled', String(next));
            if (next) playRetroChime();
            syncPreferenceLabels();
            showRetroToast(next ? 'Sound FX: Enabled' : 'Sound FX: Muted');
            break;
          }
          case 'toggle-crt': {
            playRetroClick();
            const current = localStorage.getItem('retro_crt_enabled') === 'true';
            localStorage.setItem('retro_crt_enabled', String(!current));
            syncPreferenceLabels();
            showRetroToast(!current ? 'CRT Scanlines: ON' : 'CRT Scanlines: OFF');
            break;
          }
          case 'toggle-mono': {
            playRetroClick();
            const current = localStorage.getItem('retro_mono_enabled') === 'true';
            localStorage.setItem('retro_mono_enabled', String(!current));
            syncPreferenceLabels();
            showRetroToast(!current ? 'Monospace Mode: ON' : 'Monospace Mode: OFF');
            break;
          }
          case 'copy-url':
            playRetroClick();
            navigator.clipboard.writeText(window.location.href).then(() => {
              showRetroToast('Page URL Copied to Clipboard!');
            }).catch(() => {
              showRetroToast(window.location.href);
            });
            break;
          case 'print-page':
            playRetroClick();
            window.print();
            break;
          case 'open-about':
            openAboutDialog();
            break;
        }
      });
    });

    // 6. About Dialog Controller
    const aboutDialog = document.getElementById('retro-about-dialog');
    const aboutCloseBtn = document.getElementById('retro-about-close-btn');
    const aboutOkBtn = document.getElementById('retro-about-ok-btn');

    function openAboutDialog() {
      if (!aboutDialog) return;
      playRetroChime();
      aboutDialog.classList.remove('hidden');
      aboutOkBtn?.focus();
    }

    function closeAboutDialog() {
      if (!aboutDialog) return;
      playRetroClick();
      aboutDialog.classList.add('hidden');
    }

    aboutCloseBtn?.addEventListener('click', closeAboutDialog);
    aboutOkBtn?.addEventListener('click', closeAboutDialog);
    aboutDialog?.addEventListener('click', (e) => {
      if (e.target === aboutDialog) {
        closeAboutDialog();
      }
    });

    // 7. Global dismiss with Click Outside & Escape key
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!panel?.contains(target) && !btn?.contains(target) && !panel?.classList.contains('hidden')) {
        panel?.classList.add('hidden');
        btn?.setAttribute('aria-expanded', 'false');
      }
      if (!sysDropdown?.contains(target) && !sysBtn?.contains(target) &&
          !mbDropdown?.contains(target) && !mbBtn?.contains(target)) {
        closeAllMenus();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllMenus();
        if (!aboutDialog?.classList.contains('hidden')) {
          closeAboutDialog();
        }
        if (!panel?.classList.contains('hidden')) {
          panel?.classList.add('hidden');
          btn?.setAttribute('aria-expanded', 'false');
        }
      }
    });

    // 8. Live Retro Clock in Menubar Right Tray
    function updateLiveClock() {
      const clockEl = document.getElementById('retro-live-clock');
      if (clockEl) {
        const now = new Date();
        clockEl.textContent = now.toLocaleTimeString('en-US', { hour12: true, hour: 'numeric', minute: '2-digit', second: '2-digit' });
      }
    }
    updateLiveClock();
    const clockInterval = setInterval(updateLiveClock, 1000);
    document.addEventListener('astro:before-swap', () => clearInterval(clockInterval), { once: true });
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>
