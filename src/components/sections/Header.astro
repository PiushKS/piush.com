<script>
  // Web Audio API Retro Sound FX Generator
  let audioCtx: AudioContext | null = null;

  function isSoundEnabled(): boolean {
    if (typeof window === 'undefined') return true;
    return localStorage.getItem('retro_sound_enabled') !== 'false';
  }

  function getAudioCtx(): AudioContext | null {
    if (typeof window === 'undefined') return null;
    try {
      if (!audioCtx) {
        const AudioCtxClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AudioCtxClass) {
          audioCtx = new AudioCtxClass();
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume().catch(() => {});
      }
      return audioCtx;
    } catch (_) {
      return null;
    }
  }

  function playRetroClick() {
    if (!isSoundEnabled()) return;
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(800, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(180, ctx.currentTime + 0.035);
      gain.gain.setValueAtTime(0.12, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.005, ctx.currentTime + 0.035);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(ctx.currentTime);
      osc.stop(ctx.currentTime + 0.035);
    } catch (_) {}
  }

  function playRetroChime() {
    if (!isSoundEnabled()) return;
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const now = ctx.currentTime;
      [523.25, 659.25, 783.99].forEach((freq, idx) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, now + idx * 0.04);
        gain.gain.setValueAtTime(0.1, now + idx * 0.04);
        gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.04 + 0.22);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now + idx * 0.04);
        osc.stop(now + idx * 0.04 + 0.22);
      });
    } catch (_) {}
  }

  function showRetroToast(message: string) {
    const toast = document.getElementById('retro-toast');
    if (!toast) return;
    toast.textContent = message;
    toast.classList.remove('hidden');
    playRetroChime();
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 2800);
  }

  function setupHeader() {
    // 1. Mobile navigation menu
    const btn = document.querySelector('[data-menu-btn]');
    const panel = document.getElementById('mobile-menu');
    
    function toggleMobileMenu() {
      if (!panel || !btn) return;
      playRetroClick();
      const isOpen = !panel.classList.contains('hidden');
      if (isOpen) {
        panel.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        panel.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    }
    btn?.addEventListener('click', toggleMobileMenu);

    // 2. System and Menubar Window Menus
    const sysBtn = document.getElementById('retro-system-menu-btn');
    const sysDropdown = document.getElementById('retro-system-menu-dropdown');
    const mbBtn = document.getElementById('retro-menubar-window-btn');
    const mbDropdown = document.getElementById('retro-menubar-window-dropdown');
    const maxBtn = document.getElementById('retro-maximize-btn');
    const minBtn = document.getElementById('retro-minimize-btn');
    const closeBtn = document.getElementById('retro-close-btn');

    minBtn?.addEventListener('click', () => {
      closeAboutDialog();
      closeAllMenus();
      (window as unknown as { minimizeToDesktop?: () => void }).minimizeToDesktop?.();
    });
    closeBtn?.addEventListener('click', () => {
      closeAboutDialog();
      closeAllMenus();
      (window as unknown as { minimizeToDesktop?: () => void }).minimizeToDesktop?.();
    });

    function closeAllMenus() {
      if (sysDropdown && !sysDropdown.classList.contains('hidden')) {
        sysDropdown.classList.add('hidden');
        sysBtn?.setAttribute('aria-expanded', 'false');
      }
      if (mbDropdown && !mbDropdown.classList.contains('hidden')) {
        mbDropdown.classList.add('hidden');
        mbBtn?.setAttribute('aria-expanded', 'false');
      }
    }

    function toggleSysMenu(e: Event) {
      e.stopPropagation();
      playRetroClick();
      const isOpen = !sysDropdown?.classList.contains('hidden');
      closeAllMenus();
      if (!isOpen && sysDropdown) {
        sysDropdown.classList.remove('hidden');
        sysBtn?.setAttribute('aria-expanded', 'true');
      }
    }

    function toggleMbMenu(e: Event) {
      e.stopPropagation();
      playRetroClick();
      const isOpen = !mbDropdown?.classList.contains('hidden');
      closeAllMenus();
      if (!isOpen && mbDropdown) {
        mbDropdown.classList.remove('hidden');
        mbBtn?.setAttribute('aria-expanded', 'true');
      }
    }

    sysBtn?.addEventListener('click', toggleSysMenu);
    mbBtn?.addEventListener('click', toggleMbMenu);

    // 3. Maximize / Fullscreen
    function toggleFullscreen() {
      playRetroClick();
      const doc = document as Document & { webkitFullscreenElement?: Element; webkitExitFullscreen?: () => Promise<void> };
      const docEl = document.documentElement as HTMLElement & { webkitRequestFullscreen?: () => Promise<void> };
      if (!doc.fullscreenElement && !doc.webkitFullscreenElement) {
        const req = docEl.requestFullscreen || docEl.webkitRequestFullscreen;
        if (req) req.call(docEl);
      } else {
        const exit = doc.exitFullscreen || doc.webkitExitFullscreen;
        if (exit) exit.call(doc);
      }
    }
    maxBtn?.addEventListener('click', toggleFullscreen);

    // 4. Update UI labels for preferences (Sound, CRT, Monospace)
    function syncPreferenceLabels() {
      const soundOn = isSoundEnabled();
      const crtOn = localStorage.getItem('retro_crt_enabled') === 'true';
      const monoOn = localStorage.getItem('retro_mono_enabled') === 'true';

      const soundText = soundOn ? '[✓] Retro Sound FX' : '[ ] Retro Sound FX';
      const crtText = crtOn ? '[✓] CRT Scanlines' : '[ ] CRT Scanlines';
      const monoText = monoOn ? '[✓] Monospace Mode' : '[ ] Monospace Mode';

      ['sys', 'mb', 'mob'].forEach((prefix) => {
        const soundEl = document.getElementById(`${prefix}-sound-label`);
        const crtEl = document.getElementById(`${prefix}-crt-label`);
        const monoEl = document.getElementById(`${prefix}-mono-label`);
        if (soundEl) soundEl.textContent = soundText;
        if (crtEl) crtEl.textContent = crtText;
        if (monoEl) monoEl.textContent = monoText;
      });

      // Apply body classes
      document.body.classList.toggle('retro-crt-active', crtOn);
      document.body.classList.toggle('retro-mono-active', monoOn);
    }
    syncPreferenceLabels();

    // 5. Action Handlers for Window Menu Options
    document.querySelectorAll('[data-action]').forEach((item) => {
      item.addEventListener('click', (e) => {
        const action = (e.currentTarget as HTMLElement).getAttribute('data-action');
        closeAllMenus();
        if (panel && !panel.classList.contains('hidden')) {
          panel.classList.add('hidden');
          btn?.setAttribute('aria-expanded', 'false');
        }

        switch (action) {
          case 'close-window':
            playRetroClick();
            (window as unknown as { minimizeToDesktop?: () => void }).minimizeToDesktop?.();
            break;
          case 'minimize-desktop':
            playRetroClick();
            (window as unknown as { minimizeToDesktop?: () => void }).minimizeToDesktop?.();
            break;
          case 'toggle-fullscreen':
            toggleFullscreen();
            break;
          case 'scroll-top':
            playRetroClick();
            window.scrollTo({ top: 0, behavior: 'smooth' });
            break;
          case 'scroll-bottom':
            playRetroClick();
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
            break;
          case 'reload-page':
            playRetroClick();
            window.location.reload();
            break;
          case 'restart-boot':
            playRetroClick();
            (window as unknown as { triggerWin95Boot?: () => void }).triggerWin95Boot?.();
            break;
          case 'toggle-sound': {
            const next = !isSoundEnabled();
            localStorage.setItem('retro_sound_enabled', String(next));
            if (next) playRetroChime();
            syncPreferenceLabels();
            showRetroToast(next ? 'Sound FX: Enabled' : 'Sound FX: Muted');
            break;
          }
          case 'toggle-crt': {
            playRetroClick();
            const current = localStorage.getItem('retro_crt_enabled') === 'true';
            localStorage.setItem('retro_crt_enabled', String(!current));
            syncPreferenceLabels();
            showRetroToast(!current ? 'CRT Scanlines: ON' : 'CRT Scanlines: OFF');
            break;
          }
          case 'toggle-mono': {
            playRetroClick();
            const current = localStorage.getItem('retro_mono_enabled') === 'true';
            localStorage.setItem('retro_mono_enabled', String(!current));
            syncPreferenceLabels();
            showRetroToast(!current ? 'Monospace Mode: ON' : 'Monospace Mode: OFF');
            break;
          }
          case 'copy-url':
            playRetroClick();
            navigator.clipboard.writeText(window.location.href).then(() => {
              showRetroToast('Page URL Copied to Clipboard!');
            }).catch(() => {
              showRetroToast(window.location.href);
            });
            break;
          case 'print-page':
            playRetroClick();
            window.print();
            break;
          case 'open-about':
            openAboutDialog();
            break;
        }
      });
    });

    // 6. About Dialog Controller
    const aboutDialog = document.getElementById('retro-about-dialog');
    // Ensure aboutDialog is attached to body so it displays properly whether window is minimized or not
    if (aboutDialog && aboutDialog.parentElement !== document.body) {
      document.body.appendChild(aboutDialog);
    }
    const aboutCloseBtn = document.getElementById('retro-about-close-btn');
    const aboutOkBtn = document.getElementById('retro-about-ok-btn');

    function openAboutDialog() {
      if (!aboutDialog) return;
      aboutDialog.style.display = 'flex';
      aboutDialog.classList.remove('hidden');
      aboutDialog.classList.add('is-open');
      aboutOkBtn?.focus();
      try { playRetroChime(); } catch (_) {}
    }

    function closeAboutDialog() {
      if (!aboutDialog) return;
      aboutDialog.style.display = 'none';
      aboutDialog.classList.add('hidden');
      aboutDialog.classList.remove('is-open');
      try { playRetroClick(); } catch (_) {}
    }

    (window as unknown as { openAboutDialog?: () => void }).openAboutDialog = openAboutDialog;
    (window as unknown as { closeAboutDialog?: () => void }).closeAboutDialog = closeAboutDialog;

    aboutCloseBtn?.addEventListener('click', closeAboutDialog);
    aboutOkBtn?.addEventListener('click', closeAboutDialog);
    aboutDialog?.addEventListener('click', (e) => {
      if (e.target === aboutDialog) {
        closeAboutDialog();
      }
    });

    // 7. Global dismiss with Click Outside & Escape key
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!panel?.contains(target) && !btn?.contains(target) && !panel?.classList.contains('hidden')) {
        panel?.classList.add('hidden');
        btn?.setAttribute('aria-expanded', 'false');
      }
      if (!sysDropdown?.contains(target) && !sysBtn?.contains(target) &&
          !mbDropdown?.contains(target) && !mbBtn?.contains(target)) {
        closeAllMenus();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllMenus();
        closeAboutDialog();
        if (panel && !panel.classList.contains('hidden')) {
          panel.classList.add('hidden');
          btn?.setAttribute('aria-expanded', 'false');
        }
      }
    });

    
    // Wire Toolbar buttons
    document.getElementById('tb-home-back')?.addEventListener('click', () => {
      playRetroClick();
      window.history.back();
    });
    document.getElementById('tb-home-fwd')?.addEventListener('click', () => {
      playRetroClick();
      window.history.forward();
    });
    document.getElementById('tb-home-up')?.addEventListener('click', () => {
      playRetroClick();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    document.getElementById('tb-home-copy')?.addEventListener('click', () => {
      playRetroClick();
      navigator.clipboard.writeText(window.location.href).then(() => {
        showRetroToast('Page URL Copied to Clipboard!');
      }).catch(() => {
        showRetroToast(window.location.href);
      });
    });
    document.getElementById('tb-home-print')?.addEventListener('click', () => {
      playRetroClick();
      window.print();
    });
    document.getElementById('tb-home-refresh')?.addEventListener('click', () => {
      playRetroClick();
      window.location.reload();
    });
    document.getElementById('tb-home-sound')?.addEventListener('click', () => {
      const next = !isSoundEnabled();
      localStorage.setItem('retro_sound_enabled', String(next));
      if (next) playRetroChime();
      syncPreferenceLabels();
      showRetroToast(next ? 'Sound FX: Enabled' : 'Sound FX: Muted');
    });
    document.getElementById('tb-home-crt')?.addEventListener('click', () => {
      playRetroClick();
      const current = localStorage.getItem('retro_crt_enabled') === 'true';
      localStorage.setItem('retro_crt_enabled', String(!current));
      syncPreferenceLabels();
      showRetroToast(!current ? 'CRT Scanlines: ON' : 'CRT Scanlines: OFF');
    });
    document.getElementById('tb-home-props')?.addEventListener('click', () => {
      playRetroClick();
      openAboutDialog();
    });

    // Wire Tray Volume button
    document.getElementById('retro-tray-volume-btn')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const next = !isSoundEnabled();
      localStorage.setItem('retro_sound_enabled', String(next));
      if (next) playRetroChime();
      syncPreferenceLabels();
      showRetroToast(next ? 'Sound FX: Enabled' : 'Sound FX: Muted');
    });

    // Wire Date/Time Properties Dialog
    const dtDialog = document.getElementById('retro-datetime-dialog');
    const dtCloseBtn = document.getElementById('retro-datetime-close-btn');
    const dtOkBtn = document.getElementById('dt-dialog-ok');
    const dtCancelBtn = document.getElementById('dt-dialog-cancel');
    const homeTray = document.getElementById('retro-home-tray');

    function openDateTimeDialog() {
      playRetroClick();
      closeAllMenus();
      if (dtDialog) {
        dtDialog.style.display = 'flex';
        dtDialog.classList.remove('hidden');
        renderCalendar();
        updateDateTimeClock();
      }
    }

    function closeDateTimeDialog() {
      playRetroClick();
      if (dtDialog) {
        dtDialog.style.display = 'none';
        dtDialog.classList.add('hidden');
      }
    }

    homeTray?.addEventListener('click', openDateTimeDialog);
    dtCloseBtn?.addEventListener('click', closeDateTimeDialog);
    dtOkBtn?.addEventListener('click', closeDateTimeDialog);
    dtCancelBtn?.addEventListener('click', closeDateTimeDialog);
    dtDialog?.addEventListener('click', (e) => {
      if (e.target === dtDialog) closeDateTimeDialog();
    });

    // Render Windows 95 Calendar
    function renderCalendar() {
      const grid = document.getElementById('dt-calendar-grid');
      const monthYear = document.getElementById('dt-month-year');
      if (!grid || !monthYear) return;

      const now = new Date();
      const year = now.getFullYear();
      const month = now.getMonth();
      const today = now.getDate();

      const monthNames = [
        'January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'
      ];
      monthYear.textContent = `${monthNames[month]} ${year}`;

      const firstDay = new Date(year, month, 1).getDay();
      const totalDays = new Date(year, month + 1, 0).getDate();

      let html = '<div class="font-bold text-[#808080]">S</div><div class="font-bold text-[#808080]">M</div><div class="font-bold text-[#808080]">T</div><div class="font-bold text-[#808080]">W</div><div class="font-bold text-[#808080]">T</div><div class="font-bold text-[#808080]">F</div><div class="font-bold text-[#808080]">S</div>';

      for (let i = 0; i < firstDay; i++) {
        html += '<div class="py-0.5 text-gray-300"></div>';
      }

      for (let day = 1; day <= totalDays; day++) {
        const isToday = day === today;
        html += `<div class="py-0.5 ${isToday ? 'bg-[#000080] text-white font-bold' : 'text-black'}">${day}</div>`;
      }

      grid.innerHTML = html;

      const tzEl = document.getElementById('dt-timezone-str');
      if (tzEl) {
        try {
          const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
          tzEl.textContent = `Time Zone: ${tz} (${now.toLocaleDateString('en-US', { weekday: 'long' })})`;
        } catch (_) {}
      }
    }

    function updateDateTimeClock() {
      const now = new Date();
      const sec = now.getSeconds();
      const min = now.getMinutes();
      const hr = now.getHours();

      // Analog clock hands
      const secHand = document.getElementById('dt-clock-sec');
      const minHand = document.getElementById('dt-clock-min');
      const hourHand = document.getElementById('dt-clock-hour');

      if (secHand) {
        const secDeg = sec * 6;
        secHand.setAttribute('transform', `rotate(${secDeg} 50 50)`);
      }
      if (minHand) {
        const minDeg = (min + sec / 60) * 6;
        minHand.setAttribute('transform', `rotate(${minDeg} 50 50)`);
      }
      if (hourHand) {
        const hrDeg = ((hr % 12) + min / 60) * 30;
        hourHand.setAttribute('transform', `rotate(${hrDeg} 50 50)`);
      }

      const digEl = document.getElementById('dt-digital-time');
      if (digEl) {
        digEl.textContent = now.toLocaleTimeString('en-US', { hour12: true, hour: '2-digit', minute: '2-digit', second: '2-digit' });
      }
    }

    // Double-click icon to close window (Windows 95 standard)
    let lastIconClick = 0;
    sysBtn?.addEventListener('click', (e) => {
      const now = Date.now();
      if (now - lastIconClick < 350) {
        // Double-click detected
        e.preventDefault();
        e.stopPropagation();
        closeAllMenus();
        (window as unknown as { minimizeToDesktop?: () => void }).minimizeToDesktop?.();
        return;
      }
      lastIconClick = now;
    });

    // Double-click titlebar to maximize / restore
    document.getElementById('retro-main-titlebar')?.addEventListener('dblclick', (e) => {
      if ((e.target as HTMLElement).closest('.retro-titlebar-btn') || (e.target as HTMLElement).closest('#retro-system-menu-btn')) {
        return;
      }
      toggleFullscreen();
    });

    // Alt+Space to toggle System Menu
    window.addEventListener('keydown', (e) => {
      if (e.altKey && e.code === 'Space') {
        e.preventDefault();
        toggleSysMenu(e);
      }
    });


    // 8. Live Windows 95 Clock in Menubar Right Tray
    function updateLiveClock() {
      const clockEl = document.getElementById('retro-live-clock');
      const trayEl = document.getElementById('retro-home-tray');
      if (clockEl) {
        const now = new Date();
        // Authentic Windows 95 12-hour AM/PM format without seconds
        clockEl.textContent = now.toLocaleTimeString('en-US', { hour12: true, hour: 'numeric', minute: '2-digit' });
        if (trayEl) {
          trayEl.title = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        }
      }
      if (dtDialog && !dtDialog.classList.contains('hidden')) {
        updateDateTimeClock();
      }
    }
    updateLiveClock();
    const clockInterval = setInterval(updateLiveClock, 1000);
    document.addEventListener('astro:before-swap', () => clearInterval(clockInterval), { once: true });
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>
