---
import type { LogoItem } from '../../../data/logos';

interface Props {
  tools: LogoItem[];
  speedMs?: number;
}

const { tools = [], speedMs = 45000 } = Astro.props as Props;
---

<div class="overflow-hidden relative z-10 mx-auto w-full py-4">
  <!-- Gradient Edge Mask for Smooth Fade -->
  <div class="[mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]">
    <div
      class="flex w-max will-change-transform animate-carousel items-center gap-4 py-2"
      style={`animation-duration: ${speedMs}ms`}
    >
      {[...tools, ...tools, ...tools].map((tool) => (
        <div class="group flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-[var(--card)] border border-[var(--color-border)] hover:border-[rgba(var(--accent-rgb),0.35)] hover:bg-[var(--color-bg-tertiary)] transition-all duration-200 shadow-xs cursor-default">
          <div class="size-6 flex items-center justify-center shrink-0">
            <img
              src={tool.logo}
              alt={tool.name}
              width="24"
              height="24"
              class="w-full h-full object-contain transition-transform duration-200 group-hover:scale-110 opacity-80 group-hover:opacity-100 dark:brightness-90 dark:contrast-125"
              loading="lazy"
            />
          </div>
          <span class="text-xs font-semibold text-[var(--color-text-secondary)] group-hover:text-foreground transition-colors whitespace-nowrap">
            {tool.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</div>
