---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  target?: string;
  rel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className,
  target,
  rel,
  ...rest
} = Astro.props as Props;

const Tag = href ? 'a' : 'button';

const base = 'inline-flex items-center justify-center font-mono font-bold cursor-pointer no-underline select-none border-t-2 border-l-2 border-r-2 border-b-2 disabled:opacity-50 disabled:pointer-events-none';

const sizes: Record<string, string> = {
  sm: 'px-2.5 py-1 text-xs gap-1.5',
  md: 'px-4 py-2 text-sm gap-2',
  lg: 'px-6 py-2.5 text-base gap-2.5',
};

const variants: Record<string, string> = {
  primary: 'bg-[#c0c0c0] text-black !text-black border-t-white border-l-white border-r-black border-b-black shadow-[1px_1px_0px_#000000] hover:bg-[#d4d4d4] active:border-t-black active:border-l-black active:border-r-white active:border-b-white active:translate-x-[1px] active:translate-y-[1px]',
  secondary: 'bg-[#0057cc] text-white !text-white border-t-[#528eff] border-l-[#528eff] border-r-[#002b66] border-b-[#002b66] shadow-[1px_1px_0px_#000000] hover:bg-[#004bbb] active:border-t-[#002b66] active:border-l-[#002b66] active:border-r-[#528eff] active:border-b-[#528eff] active:translate-x-[1px] active:translate-y-[1px]',
  outline: 'bg-white text-black !text-black border-t-white border-l-white border-r-black border-b-black shadow-[1px_1px_0px_#000000] hover:bg-[#f0f0f0] active:border-t-black active:border-l-black active:border-r-white active:border-b-white active:translate-x-[1px] active:translate-y-[1px]',
  ghost: 'bg-transparent text-black border-transparent hover:bg-[#d4d4d4] hover:border-t-white hover:border-l-white hover:border-r-black hover:border-b-black active:border-t-black active:border-l-black active:border-r-white active:border-b-white active:translate-x-[1px] active:translate-y-[1px]',
};

const classes = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  target={target}
  rel={rel}
  aria-disabled={disabled ? 'true' : undefined}
  {...rest}
>
  <slot />
</Tag>
