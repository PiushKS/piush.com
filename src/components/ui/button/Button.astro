---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  target?: string;
  rel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className,
  target,
  rel,
  ...rest
} = Astro.props as Props;

const Tag = href ? 'a' : 'button';

const base = 'inline-flex items-center justify-center font-medium transition-all duration-200 cursor-pointer no-underline active:scale-[0.98] disabled:opacity-50 disabled:pointer-events-none';

const sizes: Record<string, string> = {
  sm: 'px-3.5 py-1.5 text-xs rounded-lg gap-1.5',
  md: 'px-5 py-2.5 text-sm rounded-xl gap-2 shadow-sm',
  lg: 'px-6 py-3.5 text-base rounded-xl gap-2.5 shadow-md',
};

const variants: Record<string, string> = {
  primary: 'font-semibold bg-gradient-to-r from-[#1B5448] to-[#23382B] text-[#E1F8DC] !text-[#E1F8DC] border border-[#1B5448] shadow-[0_4px_14px_rgba(27,84,72,0.3)] hover:brightness-110 dark:from-[#ade1cd] dark:via-[#c2ecd9] dark:to-[#E1F8DC] dark:text-[#0d1712] dark:!text-[#0d1712] dark:border-[#E1F8DC]/60 dark:shadow-[0_4px_16px_rgba(173,225,205,0.35)]',
  secondary: 'text-[var(--accent)] border border-[rgba(var(--accent-rgb),0.3)] bg-[rgba(var(--accent-rgb),0.08)] hover:bg-[rgba(var(--accent-rgb),0.16)] hover:border-[var(--accent)] backdrop-blur-sm',
  outline: 'text-foreground border border-[var(--color-border)] bg-[var(--card)] hover:border-[rgba(var(--accent-rgb),0.4)] hover:text-[var(--accent)] backdrop-blur-sm',
  ghost: 'text-[color:var(--color-text-secondary)] bg-transparent hover:bg-[rgba(var(--accent-rgb),0.08)] hover:text-[var(--accent)]',
};

const classes = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  target={target}
  rel={rel}
  aria-disabled={disabled ? 'true' : undefined}
  {...rest}
>
  <slot />
</Tag>
